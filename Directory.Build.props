<Project><PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors><AnalysisLevel>latest-recommended</AnalysisLevel><Deterministic>true</Deterministic></PropertyGroup><PropertyGroup Condition="'$(Configuration)' == 'Profile'"><Optimize>true</Optimize><DebugType>portable</DebugType><DefineConstants>$(DefineConstants);PERFORMANCE_TRACE</DefineConstants></PropertyGroup></Project>
