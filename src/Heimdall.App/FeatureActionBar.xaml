<UserControl x:Class="Heimdall.App.FeatureActionBar"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pres="clr-namespace:Heimdall.App">
    <!-- A single horizontally scrollable row avoids resizing the feature content. -->
    <ScrollViewer x:Name="ActionScroll" Height="48"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  CanContentScroll="False" Focusable="False">
        <ItemsControl ItemsSource="{Binding ToolbarActions, ElementName=Root}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                    <Button x:Name="DirectAction" Content="{Binding Label}" Command="{Binding Command}"
                            Visibility="{Binding Source.Visibility, FallbackValue=Visible}"
                            ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Label}"
                            Style="{Binding ButtonStyle, RelativeSource={RelativeSource AncestorType=pres:FeatureActionBar}, TargetNullValue={StaticResource FeatureActionButton}}">
                        <Button.ToolTip>
                            <PriorityBinding><Binding Path="Source.ToolTip"/><Binding Path="ToolTip"/></PriorityBinding>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="MenuAction" Content="{Binding Label}" Click="OpenActionMenu" Visibility="Collapsed"
                            AutomationProperties.Name="{Binding Label}"
                            Style="{Binding ButtonStyle, RelativeSource={RelativeSource AncestorType=pres:FeatureActionBar}, TargetNullValue={StaticResource FeatureActionButton}}"/>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Source}" Value="{x:Null}">
                            <Setter TargetName="DirectAction" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MenuAction" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
