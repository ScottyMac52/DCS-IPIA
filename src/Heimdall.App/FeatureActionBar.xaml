<UserControl x:Class="Heimdall.App.FeatureActionBar"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pres="clr-namespace:Heimdall.App">
    <!-- A single horizontally scrollable row avoids resizing the feature content. -->
    <ScrollViewer x:Name="ActionScroll" Height="48"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  CanContentScroll="False" Focusable="False">
        <ItemsControl ItemsSource="{Binding Actions, ElementName=Root}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Label}" Command="{Binding Command}"
                            ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Label}"
                            Style="{Binding ButtonStyle, RelativeSource={RelativeSource AncestorType=pres:FeatureActionBar}, TargetNullValue={StaticResource FeatureActionButton}}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
