<UserControl x:Class="Heimdall.App.Games.EliteReferenceSheetsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:pres="clr-namespace:Heimdall.App">
 <DockPanel>
 <pres:ActionBar IsFeatureActions="True" Visibility="Collapsed">
<Button Style="{StaticResource ToolbarActionButton}" x:Name="ReferencePreviousButton" Content="Previous page"/>
<Button Style="{StaticResource ToolbarActionButton}" x:Name="ReferenceNextButton" Content="Next page"/>
<Button Style="{StaticResource ToolbarActionButton}" x:Name="ReferencePdfButton" Content="Export PDF…"/>
<Button Style="{StaticResource ToolbarActionButton}" x:Name="ReferencePngButton" Content="Export page PNG…"/>
</pres:ActionBar>
 <Grid x:Name="ReferenceSheetsPanel" pres:WorkspaceLayout.Key="elite.reference.split">
     <Grid.ColumnDefinitions><ColumnDefinition Width=".34*" MinWidth="220"/><ColumnDefinition Width="8"/><ColumnDefinition Width=".66*" MinWidth="280"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer Grid.RowSpan="3" VerticalScrollBarVisibility="Auto" Margin="0,0,6,0"><StackPanel>
      <TextBlock Style="{StaticResource AppLabel}" Text="Reference Sheets" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Style="{StaticResource AppLabel}" Text="Choose a controller on the left and a section above. Preview the current profile, then export its pages." TextWrapping="Wrap" Margin="0,4,0,8"/>
      <StackPanel>
       <TextBlock Style="{StaticResource AppLabel}" Text="Layout" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <ComboBox Style="{StaticResource AppComboBox}" x:Name="ReferenceLayoutPicker" Width="225" HorizontalAlignment="Left" AutomationProperties.Name="Reference sheet layout">
        <ComboBoxItem x:Name="ReferenceArtworkOption" Content="Artwork + assignment table"/><ComboBoxItem Content="Assignment table"/>
       </ComboBox>
       <TextBlock Style="{StaticResource AppLabel}" Text="Paper" VerticalAlignment="Center" Margin="0,8,0,6"/>
       <ComboBox Style="{StaticResource AppComboBox}" x:Name="ReferencePaperPicker" Width="85" HorizontalAlignment="Left" AutomationProperties.Name="Reference paper size">
        <ComboBoxItem Content="A4"/><ComboBoxItem Content="Letter"/>
       </ComboBox>
       <ComboBox Style="{StaticResource AppComboBox}" x:Name="ReferenceOrientationPicker" Width="125" HorizontalAlignment="Left" Margin="0,6,0,6" AutomationProperties.Name="Reference orientation">
        <ComboBoxItem Content="Portrait"/><ComboBoxItem Content="Landscape"/>
       </ComboBox>
       <CheckBox Style="{StaticResource AppCheckBox}" x:Name="ReferenceAssignedOnly" Content="Only assigned commands" IsChecked="True" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Style="{StaticResource AppLabel}" x:Name="ReferenceStatus" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
     </StackPanel></ScrollViewer>
     <GridSplitter Grid.Column="1" Grid.RowSpan="3" Style="{StaticResource WorkspaceDivider}" AutomationProperties.Name="Reference options and preview divider"/>
     <Border Grid.Column="2" Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BorderBrush}" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <Image x:Name="ReferencePreview" MaxWidth="700" Stretch="Uniform" VerticalAlignment="Top" AutomationProperties.Name="Reference sheet page preview"/>
      </ScrollViewer>
     </Border>
     <WrapPanel Grid.Column="2" Grid.Row="2" Margin="0,10,0,0">

      <TextBlock Style="{StaticResource AppLabel}" x:Name="ReferencePageLabel" Text="No preview" VerticalAlignment="Center" Margin="12,0"/>



     </WrapPanel>
    </Grid>
 </DockPanel>
</UserControl>
