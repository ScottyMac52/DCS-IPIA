<UserControl x:Class="Heimdall.App.Games.WarThunder.WarThunderNativeEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:games="clr-namespace:Heimdall.App.Games" xmlns:pres="clr-namespace:Heimdall.App">
 <games:GameAssignmentEditorView x:Name="Frame"><games:GameAssignmentEditorView.NativeEditor>
  <StackPanel>
   <WrapPanel><StackPanel Width="210" Margin="0,0,8,0"><TextBlock Style="{StaticResource AppLabel}" Text="Controller"/><ComboBox Style="{StaticResource AppComboBox}" x:Name="Target" AutomationProperties.Name="Native target mapping"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding Id}" FontSize="10"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
    <StackPanel Width="240" Margin="0,0,8,0"><TextBlock Style="{StaticResource AppLabel}" Text="Input"/><pres:AssignmentInputPicker Style="{StaticResource AppComboBox}" x:Name="Index" DisplayMemberPath="Value" SelectedValuePath="Key" AutomationProperties.Name="Controller input"/></StackPanel>

   </WrapPanel>
   <pres:ActionBar IsFeatureActions="True" FeatureOrder="-1" Visibility="Collapsed"><Button Style="{StaticResource ToolbarActionButton}" x:Name="Apply" Content="Apply assignment"/><Button Style="{StaticResource ToolbarActionButton}" x:Name="Add" Content="Add alternative"/><Button Style="{StaticResource ToolbarActionButton}" x:Name="Clear" Content="Clear assignment" ToolTip="Clear the selected joystick assignment; preserve axis tuning, other input families and other alternatives."/>
    <Button Style="{StaticResource ToolbarActionButton}" x:Name="Tune" Content="Tune axis…"/>
   </pres:ActionBar>
   <Expander x:Name="NativeDetails" Header="Native record details" IsExpanded="False">
    <ComboBox Style="{StaticResource AppComboBox}" x:Name="Input" DisplayMemberPath="Address" AutomationProperties.Name="Native input occurrence"/>
   </Expander>
  </StackPanel>
 </games:GameAssignmentEditorView.NativeEditor></games:GameAssignmentEditorView>
</UserControl>
