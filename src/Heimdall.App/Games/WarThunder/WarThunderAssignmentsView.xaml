<games:GameAssignmentsView x:Class="Heimdall.App.Games.WarThunder.WarThunderAssignmentsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wt="clr-namespace:Heimdall.App.Games.WarThunder" pres:AppearanceManager.Target="WarThunderAssignmentsView" xmlns:pres="clr-namespace:Heimdall.App" xmlns:games="clr-namespace:Heimdall.App.Games">

 <games:GameAssignmentsView.CommandsPanel>
   <DockPanel Margin="0,0,6,0">
    <StackPanel DockPanel.Dock="Bottom"><Button x:Name="ShowAssignments" Style="{StaticResource ToolbarActionButton}" Content="Show saved assignments"/><TextBlock x:Name="AssignmentCount" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Style="{StaticResource Hint}" Text="Commands come from the imported profile. Inherited presets may contain additional commands." TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
    <games:GameCommandBrowserView x:Name="Browser"/>
   </DockPanel>
 </games:GameAssignmentsView.CommandsPanel>
 <games:GameAssignmentsView.ControllerPanel>
 <Grid>
  <pres:ActionBar IsFeatureActions="True" Visibility="Collapsed">
   <Button Style="{StaticResource ToolbarActionButton}" x:Name="Start" Content="Start input test"/><Button Style="{StaticResource ToolbarActionButton}" x:Name="Stop" Content="Stop"/><Button Style="{StaticResource ToolbarActionButton}" x:Name="Fit" Content="Fit"/>
  </pres:ActionBar>
    <Expander x:Name="DrawingPanel" Style="{StaticResource WorkspaceDrawingExpander}" Header="Controller drawing" IsExpanded="True" Margin="0,8,0,0"><games:GameDrawingView x:Name="Artwork" Margin="0,6,0,0"/></Expander>
 </Grid>
 </games:GameAssignmentsView.ControllerPanel>
 <games:GameAssignmentsView.EditorPanel>
 <StackPanel>
    <Expander x:Name="CapturedAssignments" Header="Captured assignments and diagnostics" IsExpanded="False" pres:WorkspaceLayout.Key="war-thunder.assignments.table">
     <DataGrid x:Name="Records" MaxHeight="170" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" AutomationProperties.Name="Native binding records">
      <DataGrid.Columns><DataGridTextColumn Header="Command" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Input" Binding="{Binding Inputs}" Width="2*"/><DataGridTextColumn Header="Native fields" Binding="{Binding Details}" Width="2*"/></DataGrid.Columns>
     </DataGrid>
    </Expander>
    <wt:WarThunderNativeEditorView x:Name="Editor" Margin="0,12,0,0"/>
 </StackPanel>
 </games:GameAssignmentsView.EditorPanel>
</games:GameAssignmentsView>
