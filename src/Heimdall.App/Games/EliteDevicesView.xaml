<UserControl x:Class="Heimdall.App.Games.EliteDevicesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:pres="clr-namespace:Heimdall.App">
 <DockPanel>
 <pres:ActionBar IsFeatureActions="True" Visibility="Collapsed">
<Button Style="{StaticResource ToolbarActionButton}" x:Name="IdentifyControllerButton" Content="Identify Controller"/>
<Button Style="{StaticResource ToolbarActionButton}" x:Name="CancelIdentificationButton" Content="Stop identifying"/>
<Button Style="{StaticResource ToolbarActionButton}" x:Name="ConfirmIdentificationButton" Content="Confirm controller link" IsEnabled="False"/>
<Button Style="{StaticResource ToolbarActionButton}" x:Name="AddControllerButton" Content="Add controller…"/>


<Button Style="{StaticResource ToolbarActionButton}" x:Name="RescanControllerButton" Content="Rescan"/>

</pres:ActionBar>
 <pres:DeviceDetailsLayout pres:WorkspaceLayout.Key="elite.devices.split">
 <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,6,0"><StackPanel x:Name="DeviceTools" Margin="0,0,0,10">
     <TextBlock Style="{StaticResource AppLabel}" Text="Controller setup" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Style="{StaticResource AppLabel}" Text="Select an unknown ID in Controllers in profile, then identify it by operating your hardware. No existing link or drawing is required." TextWrapping="Wrap" Margin="0,4,0,8"/>
     <WrapPanel>



     </WrapPanel>
     <TextBlock Style="{StaticResource AppLabel}" x:Name="IdentificationStatus" TextWrapping="Wrap" Margin="0,6,0,12" AutomationProperties.Name="Controller identification result" AutomationProperties.LiveSetting="Polite"/>

     <TextBlock Style="{StaticResource AppLabel}" Text="Choose your connected controller to add it, or select a profile controller on the left to remove or replace it. Every removal/replacement is previewed. Drawings are optional." TextWrapping="Wrap" Margin="0,4,0,8"/>
     <StackPanel>
      <GroupBox Header="Physical controller" Style="{StaticResource DeviceSetupSection}"><StackPanel>
<WrapPanel Margin="0,0,0,6"><Button Style="{StaticResource ToolbarActionButton}" x:Name="UnlinkControllerButton" Content="Unlink physical controller…"/>
<Button Style="{StaticResource ToolbarActionButton}" x:Name="ReplaceControllerButton" Content="Replace selected…"/>
<Button Style="{StaticResource ToolbarActionButton}" x:Name="RemoveControllerButton" Content="Remove selected…"/></WrapPanel>
<ComboBox Style="{StaticResource AppComboBox}" x:Name="ConnectedPicker" DisplayMemberPath="Title" MinWidth="160" AutomationProperties.Name="Controller to add or use as replacement"/>
</StackPanel></GroupBox>



     </StackPanel>
     <StackPanel x:Name="ReplacementReferenceTools" Visibility="Collapsed" Margin="0,6,0,0">
      <TextBlock Style="{StaticResource AppLabel}" Text="For an unlinked replacement with identical products, choose its captured ED reference/index explicitly. Connection order is not an ED index." TextWrapping="Wrap"/>
      <ComboBox Style="{StaticResource AppComboBox}" x:Name="ReplacementReferencePicker" DisplayMemberPath="Name" MinWidth="160" HorizontalAlignment="Left" AutomationProperties.Name="Replacement ED reference and index"/>
     </StackPanel>
     <StackPanel x:Name="ReferenceChoiceTools" Visibility="Collapsed" Margin="0,8,0,0">
      <TextBlock Style="{StaticResource AppLabel}" Text="Choose the matching reference from your imported ED preset. ED indices identify game references, not Windows connection order." TextWrapping="Wrap"/>
      <WrapPanel Margin="0,4,0,0"><ComboBox Style="{StaticResource AppComboBox}" x:Name="ReferencePicker" DisplayMemberPath="Name" MinWidth="160" AutomationProperties.Name="Matching ED reference"/>
       <Button Style="{StaticResource ToolbarActionButton}" x:Name="LinkReferenceButton" Content="Link selected reference"/>
      </WrapPanel>
     </StackPanel>
     <GroupBox Header="Hardware drawing" Style="{StaticResource DeviceSetupSection}"><StackPanel>
<TextBlock Style="{StaticResource AppLabel}" x:Name="DrawingStatus" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="550"/>
<WrapPanel Margin="0,0,0,6">
      <Button Style="{StaticResource ToolbarActionButton}" x:Name="ChangeDrawingButton" Content="Choose drawing…"/>
      <Button Style="{StaticResource ToolbarActionButton}" x:Name="NoDrawingButton" Content="Unlink drawing"/>

     </WrapPanel>
     <WrapPanel x:Name="DrawingTools" Visibility="Collapsed" Margin="0,6,0,0">
      <ComboBox Style="{StaticResource AppComboBox}" x:Name="HardwarePicker" DisplayMemberPath="Title" MinWidth="160" AutomationProperties.Name="Optional shared hardware drawing"/>
      <Button Style="{StaticResource ToolbarActionButton}" x:Name="UseDrawingButton" Content="Use drawing"/>
     </WrapPanel>
</StackPanel></GroupBox>
    </StackPanel></ScrollViewer>

 <pres:WorkspaceDrawingPreview x:Name="ControllerPreview" Grid.Column="2" Margin="6,0,0,0"/>
 </pres:DeviceDetailsLayout>
 </DockPanel>
</UserControl>
