<UserControl x:Class="Heimdall.App.Games.EliteAssignmentsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:pres="clr-namespace:Heimdall.App" xmlns:games="clr-namespace:Heimdall.App.Games"
 xmlns:local="clr-namespace:Heimdall.App.Games">
 <DockPanel>
 <pres:ActionBar IsFeatureActions="True" Visibility="Collapsed">
<Button Style="{StaticResource ToolbarActionButton}" x:Name="ApplyAssignmentButton" Content="Apply assignment"/>
<Button Style="{StaticResource ToolbarActionButton}" x:Name="ClearAssignmentButton" Content="Clear slot"/>
<Button Style="{StaticResource ToolbarActionButton}" x:Name="StartInputButton" Content="Start input test"/>
<Button Style="{StaticResource ToolbarActionButton}" x:Name="StopInputButton" Content="Stop"/>
<Button Style="{StaticResource ToolbarActionButton}" x:Name="FitDiagramButton" Content="Fit"/>
</pres:ActionBar>

  <games:GameWorkspaceSplit x:Name="AuthoringPanel" pres:WorkspaceLayout.Key="elite.assignments.split">

   <local:GameCommandBrowserView x:Name="CommandBrowser" Margin="0,0,6,0"/>
   <Grid Grid.Column="2" Margin="6,0,0,0">
    <Grid.RowDefinitions><RowDefinition Height=".62*" MinHeight="180"/><RowDefinition Height=".38*" MinHeight="100" MaxHeight="240"/></Grid.RowDefinitions>
    <local:EliteAssignmentArtworkView x:Name="Artwork"/>
    <local:GameAssignmentEditorView x:Name="SelectionEditor" Grid.Row="1"/>
   </Grid>
  </games:GameWorkspaceSplit>
 </DockPanel>
</UserControl>
