<UserControl x:Class="Heimdall.App.Games.WarThunderDevicesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pres="clr-namespace:Heimdall.App" xmlns:games="clr-namespace:Heimdall.App.Games">
 <DockPanel>
  <pres:ActionBar x:Name="Actions" IsFeatureActions="True" Visibility="Collapsed" DockPanel.Dock="Top">
   <Button Style="{StaticResource ToolbarActionButton}" x:Name="Rescan" Content="Rescan"/>
   
   
  </pres:ActionBar>
  <pres:DeviceDetailsLayout pres:WorkspaceLayout.Key="war-thunder.devices.split">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Style="{StaticResource SectionTitle}" Text="Controller setup"/>
   <TextBlock Style="{StaticResource Hint}" Text="Select a controller in the profile on the left. Link its physical controller explicitly, then choose a shared drawing." TextWrapping="Wrap" Margin="0,8"/>
   <GroupBox Header="Physical controller" Style="{StaticResource DeviceSetupSection}"><StackPanel>
<WrapPanel Margin="0,0,0,6"><Button Style="{StaticResource ToolbarActionButton}" x:Name="Link" Content="Link physical controller…"/>
<Button Style="{StaticResource ToolbarActionButton}" x:Name="Unlink" Content="Unlink physical controller…"/>
<Button Style="{StaticResource ToolbarActionButton}" x:Name="Remove" Content="Remove controller…"/></WrapPanel>
<ComboBox Style="{StaticResource AppComboBox}" x:Name="Physical" DisplayMemberPath="Title" AutomationProperties.Name="Physical controller" Margin="0,6"/>
</StackPanel></GroupBox>
   
   <GroupBox Header="Hardware drawing" Style="{StaticResource DeviceSetupSection}"><StackPanel>
<WrapPanel Margin="0,0,0,6"><Button Style="{StaticResource ToolbarActionButton}" x:Name="ChooseDrawing" Content="Choose drawing…"/><Button Style="{StaticResource ToolbarActionButton}" x:Name="UnlinkDrawing" Content="Unlink drawing…"/></WrapPanel>
   <ComboBox Style="{StaticResource AppComboBox}" x:Name="Drawing" DisplayMemberPath="Title" AutomationProperties.Name="Hardware drawing" Margin="0,6"/>
</StackPanel></GroupBox>
   <pres:WorkspaceDiagnosticsPanel><ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Style="{StaticResource Hint}" x:Name="NativeDetails" TextWrapping="Wrap" Margin="0,8"/>
    <TextBox x:Name="LayoutTrace" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="240" AutomationProperties.Name="Native input translation trace"/>
   </StackPanel></ScrollViewer></pres:WorkspaceDiagnosticsPanel>
   <TextBlock Style="{StaticResource Hint}" Text="Native mapping ranges do not identify a Windows controller. Physical and drawing links require explicit unlink before replacement. These links do not renumber the exported native inputs." TextWrapping="Wrap" Margin="0,16"/>
  </StackPanel></ScrollViewer>
  <pres:WorkspaceDrawingPreview x:Name="ControllerPreview" Grid.Column="2" Margin="6,0,0,0"/>
 </pres:DeviceDetailsLayout>
 </DockPanel>
</UserControl>
