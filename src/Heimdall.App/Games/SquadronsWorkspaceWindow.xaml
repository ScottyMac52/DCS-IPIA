<Window x:Class="Heimdall.App.Games.SquadronsWorkspaceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:pres="clr-namespace:Heimdall.App" Title="HEIMDALL — Star Wars: Squadrons" Width="1220" Height="820" MinWidth="900" MinHeight="620"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
 <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <WrapPanel>
    <ComboBox x:Name="GamePicker" Style="{StaticResource AppComboBox}" Width="200" SelectionChanged="GameChanged" AutomationProperties.Name="Game selection">
     <ComboBoxItem Content="DCS World" Tag="dcs"/><ComboBoxItem Content="Elite Dangerous" Tag="elite-dangerous"/><ComboBoxItem Content="Star Wars: Squadrons" Tag="star-wars-squadrons"/>
    </ComboBox>
    <Button x:Name="ImportButton" Style="{StaticResource ToolbarActionButton}" Content="Import controls…" Click="ImportClicked" Margin="8,0,0,0"/>
    <Button x:Name="SaveButton" Style="{StaticResource ToolbarActionButton}" Content="Save profile" Click="SaveClicked"/>
    <Button x:Name="DiscardButton" Style="{StaticResource ToolbarActionButton}" Content="Discard changes" Click="DiscardClicked"/>
    <Button x:Name="ExportButton" Style="{StaticResource ToolbarActionButton}" Content="Export review copy…" Click="ExportClicked"/>
   </WrapPanel>
   <WrapPanel Margin="0,8,0,8">
    <TextBlock Style="{StaticResource AppLabel}" Text="Saved profile" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox x:Name="ProfilePicker" Style="{StaticResource AppComboBox}" Width="260" DisplayMemberPath="Name" SelectionChanged="ProfileChanged" AutomationProperties.Name="Squadrons saved profile"/>
    <TextBlock Style="{StaticResource AppLabel}" Text="Name" VerticalAlignment="Center" Margin="16,0,8,0"/>
    <TextBox x:Name="ProfileName" Style="{StaticResource AppTextBox}" Width="260" MaxLength="100" TextChanged="NameChanged" AutomationProperties.Name="Squadrons configuration name"/>
    <TextBlock x:Name="SaveState" Style="{StaticResource Hint}" Margin="12,4,0,0"/>
   </WrapPanel>
  </StackPanel>
  <TextBlock Grid.Row="1" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
   Text="Edit captured joystick bindings and export a separate review copy. Keyboard, mouse, gamepad and unsupported combinations are preserved. Saved controller slots do not confirm detection in Squadrons. Hardware artwork, live input testing and reference sheets are coming in a later increment."/>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width=".24*" MinWidth="210"/><ColumnDefinition Width="8"/><ColumnDefinition Width=".76*" MinWidth="500"/></Grid.ColumnDefinitions>
   <DockPanel Margin="0,0,8,0">
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource AppLabel}" Text="Captured controllers" FontSize="18" Margin="0,0,0,8"/>
    <ListBox x:Name="DevicePicker" DisplayMemberPath="Name" SelectionChanged="FilterChanged" AutomationProperties.Name="Squadrons controller filter"/>
   </DockPanel>
   <GridSplitter Grid.Column="1" Style="{StaticResource WorkspaceDivider}"/>
   <Grid Grid.Column="2" Margin="8,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <WrapPanel>
      <ComboBox x:Name="SectionPicker" Style="{StaticResource AppComboBox}" Width="190" SelectionChanged="FilterChanged" AutomationProperties.Name="Squadrons command context"/>
      <ComboBox x:Name="TypePicker" Style="{StaticResource AppComboBox}" Width="170" Margin="8,0,0,0" SelectionChanged="FilterChanged" AutomationProperties.Name="Squadrons input type"/>
      <TextBox x:Name="Search" Style="{StaticResource AppTextBox}" Width="200" Margin="8,0,0,0" TextChanged="SearchChanged" AutomationProperties.Name="Search Squadrons commands"/>
     </WrapPanel>
     <TextBlock x:Name="CountText" Style="{StaticResource Hint}" Margin="0,6,0,6"/>
    </StackPanel>
    <DataGrid x:Name="BindingsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" SelectionChanged="BindingChanged" AutomationProperties.Name="Squadrons assignments">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Command" Binding="{Binding CommandName}" Width="*"/>
      <DataGridTextColumn Header="Context" Binding="{Binding Section}" Width="140"/>
      <DataGridTextColumn Header="Controller" Binding="{Binding DeviceLabel}" Width="190"/>
      <DataGridTextColumn Header="Input" Binding="{Binding InputLabel}" Width="175"/>
      <DataGridTextColumn Header="Binding" Binding="{Binding BindingLabel}" Width="85"/>
     </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
     <TextBlock x:Name="AssignmentHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Select an assignment to edit."/>
     <WrapPanel Margin="0,8,0,0">
      <ComboBox x:Name="TargetDevice" Style="{StaticResource AppComboBox}" Width="260" DisplayMemberPath="Name" AutomationProperties.Name="Squadrons assignment controller"/>
      <ComboBox x:Name="InputPicker" Style="{StaticResource AppComboBox}" Width="220" Margin="8,0,0,0" DisplayMemberPath="DisplayName" AutomationProperties.Name="Squadrons assignment input"/>
      <Button x:Name="ApplyButton" Style="{StaticResource ToolbarActionButton}" Content="Apply assignment" Margin="8,0,0,0" Click="ApplyClicked"/>
     </WrapPanel>
    </StackPanel>
   </Grid>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Window>
