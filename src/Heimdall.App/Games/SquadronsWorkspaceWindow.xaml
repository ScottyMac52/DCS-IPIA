<Window x:Class="Heimdall.App.Games.SquadronsWorkspaceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:pres="clr-namespace:Heimdall.App" xmlns:games="clr-namespace:Heimdall.App.Games" Title="HEIMDALL — Star Wars: Squadrons" Width="1420" Height="900" MinWidth="1100" MinHeight="680"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
 <Window.Resources>
  <Style x:Key="SquadronsActionButton" TargetType="Button" BasedOn="{StaticResource ToolbarActionButton}">
   <Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="80"/><Setter Property="Padding" Value="12,0"/>
  </Style>
  <Style x:Key="SquadronsCellText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="4"/></Style>
  <Style x:Key="SquadronsSectionSplitter" TargetType="GridSplitter">
   <Setter Property="Height" Value="6"/>
   <Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="ResizeDirection" Value="Rows"/>
   <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
   <Setter Property="ShowsPreview" Value="True"/>
   <Setter Property="Cursor" Value="SizeNS"/>
   <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
  </Style>
  <!-- Shared per-field layout inside the aligned Squadrons command-filter grid. -->
  <Style x:Key="SquadronsFilterLabel" TargetType="TextBlock" BasedOn="{StaticResource AppLabel}">
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <Style x:Key="SquadronsFilterCombo" TargetType="ComboBox" BasedOn="{StaticResource ToolbarComboBox}">
   <Setter Property="Width" Value="Auto"/>
   <Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="Margin" Value="0,0,12,0"/>
  </Style>
  <Style x:Key="SquadronsFilterTextBox" TargetType="TextBox" BasedOn="{StaticResource AppTextBox}">
   <Setter Property="Height" Value="30"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="0,0,12,0"/>
  </Style>
 </Window.Resources>
 <games:GameWorkspaceShell Margin="16">
  <StackPanel>
   <WrapPanel>
    <ComboBox x:Name="GamePicker" Style="{StaticResource ToolbarComboBox}" VerticalAlignment="Center" Width="200" SelectionChanged="GameChanged" AutomationProperties.Name="Game selection">
     <ComboBoxItem Content="DCS World" Tag="dcs"/><ComboBoxItem Content="Elite Dangerous" Tag="elite-dangerous"/><ComboBoxItem Content="Star Wars: Squadrons" Tag="star-wars-squadrons"/>
    </ComboBox>
    <Button x:Name="ImportButton" Style="{StaticResource SquadronsActionButton}" Content="Import controls…" Click="ImportClicked"/>
    <Button x:Name="SaveButton" Style="{StaticResource SquadronsActionButton}" Content="Save profile" Click="SaveClicked"/>
    <Button x:Name="DiscardButton" Style="{StaticResource SquadronsActionButton}" Content="Discard changes" Click="DiscardClicked"/>
    <Button x:Name="ExportButton" Style="{StaticResource SquadronsActionButton}" Content="Export review copy…" Click="ExportClicked"/>
   </WrapPanel>
   <WrapPanel Margin="0,8,0,8">
    <TextBlock Style="{StaticResource AppLabel}" Text="Saved profile" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox x:Name="ProfilePicker" Style="{StaticResource ToolbarComboBox}" Width="220" DisplayMemberPath="Name" SelectionChanged="ProfileChanged" AutomationProperties.Name="Squadrons saved profile"/>
    <TextBlock Style="{StaticResource AppLabel}" Text="Name" VerticalAlignment="Center" Margin="16,0,8,0"/>
    <TextBox x:Name="ProfileName" Style="{StaticResource SquadronsFilterTextBox}" Width="220" Margin="0" MaxLength="100" TextChanged="NameChanged" AutomationProperties.Name="Squadrons configuration name"/>
    <TextBlock x:Name="SaveState" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
   </WrapPanel>
  </StackPanel>
  <TextBlock Grid.Row="1" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
   Text="Choose a controller or a read-only Mouse, Keyboard or Gamepad source to inspect captured assignments. Controller setup manages linked joystick hardware."/>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width=".24*" MinWidth="210"/><ColumnDefinition Width="8"/><ColumnDefinition Width=".76*" MinWidth="500"/></Grid.ColumnDefinitions>
   <DockPanel Margin="0,0,8,0">
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource AppLabel}" Text="Controllers" FontSize="18" Margin="0,0,0,8"/>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
     <TextBlock x:Name="ControllerSummary" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <Expander x:Name="ControllerSetup" Header="Controller setup" IsExpanded="False" Foreground="{DynamicResource PrimaryTextBrush}" Collapsed="SetupCollapsed">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280" Margin="0,8,0,0">
     <StackPanel>
      <TextBlock x:Name="LinkStatus" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
      <TextBlock Style="{StaticResource AppLabel}" Text="Physical controller" Margin="0,8,0,4"/>
      <ComboBox x:Name="ConnectedPicker" Style="{StaticResource AppComboBox}" HorizontalContentAlignment="Stretch" SelectionChanged="ConnectedChanged" AutomationProperties.Name="Squadrons physical controller">
       <ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding PhysicalGuid}" FontSize="10" TextWrapping="Wrap"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
      <WrapPanel Margin="0,8,0,0">
       <Button x:Name="RescanControllerButton" Style="{StaticResource SquadronsActionButton}" Content="Rescan" Click="RescanClicked"/>
       <Button x:Name="IdentifyControllerButton" Style="{StaticResource SquadronsActionButton}" Content="Identify…" Click="IdentifyClicked"/>
       <Button x:Name="CancelIdentificationButton" Style="{StaticResource SquadronsActionButton}" Content="Stop" Click="StopIdentificationClicked"/>
      </WrapPanel>
      <TextBlock x:Name="IdentificationStatus" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,4" AutomationProperties.LiveSetting="Polite"/>
      <WrapPanel>
       <Button x:Name="LinkControllerButton" Style="{StaticResource SquadronsActionButton}" Content="Link / replace…" Click="LinkClicked"/>
       <Button x:Name="UnlinkControllerButton" Style="{StaticResource SquadronsActionButton}" Content="Unlink…" Click="UnlinkClicked"/>
       <Button x:Name="ClearSlotButton" Style="{StaticResource SquadronsActionButton}" Content="Clear assignments…" Click="ClearSlotClicked"/>
       <Button x:Name="RemoveUnusedSlotButton" Style="{StaticResource SquadronsActionButton}" Content="Remove unused slot…" Click="RemoveUnusedSlotClicked"/>
      </WrapPanel>
      <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0" Text="Select a captured slot first. Identify finds the physical unit; verify its slot in Squadrons before linking. For another slot, bind an input on that device in Squadrons and import a fresh capture."/>
     </StackPanel>
    </ScrollViewer>
     </Expander>
    </StackPanel>
    <ListBox x:Name="DevicePicker" AllowDrop="True" ToolTip="Drag controllers to renumber their native Squadrons slots; Ctrl+Up/Down also works. Changes require review." HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="FilterChanged" AutomationProperties.Name="Squadrons controller filter">
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <GridSplitter Grid.Column="1" Style="{StaticResource WorkspaceDivider}"/>
   <Grid Grid.Column="2" Margin="8,0,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width=".38*" MinWidth="230"/><ColumnDefinition Width="8"/><ColumnDefinition Width=".62*" MinWidth="300"/></Grid.ColumnDefinitions>
    <DockPanel Grid.Column="0" Margin="0,0,6,0">
     <StackPanel DockPanel.Dock="Bottom">
      <Button x:Name="ShowCommandButton" Style="{StaticResource SquadronsActionButton}" Content="Show saved assignments" Click="ShowCommandClicked"/>
      <TextBlock x:Name="CommandHint" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
      <Expander Header="Captured record filters" IsExpanded="False">
       <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><StackPanel>
        <ComboBox x:Name="SectionPicker" Style="{StaticResource AppComboBox}" SelectionChanged="FilterChanged" AutomationProperties.Name="Squadrons captured context"/>
        <ComboBox x:Name="TypePicker" Style="{StaticResource AppComboBox}" SelectionChanged="FilterChanged" AutomationProperties.Name="Squadrons captured input type"/>
        <TextBox x:Name="Search" Style="{StaticResource AppTextBox}" TextChanged="SearchChanged" AutomationProperties.Name="Search Squadrons captured records"/>
        <CheckBox x:Name="ReviewCaptured" Content="Review captured records (advanced)" Style="{StaticResource AppCheckBox}" IsChecked="False" Checked="CaptureReviewChanged" Unchecked="CaptureReviewChanged"/>
       </StackPanel></ScrollViewer>
      </Expander>
      <TextBlock x:Name="CountText" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
     </StackPanel>
     <games:GameCommandBrowserView x:Name="CommandBrowser" ToolTip="Select a command, then click an outlined control to assign. Dragging also works."/>
    </DockPanel>
    <GridSplitter Grid.Column="1" Style="{StaticResource WorkspaceDivider}" ToolTip="Resize Commands and Assignment workspace"/>
    <Grid Grid.Column="2" Margin="6,0,0,0">
     <Grid.RowDefinitions><RowDefinition Height=".36*" MinHeight="105"/><RowDefinition Height="6"/><RowDefinition Height=".64*" MinHeight="150"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DataGrid x:Name="BindingsGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" SelectionChanged="BindingChanged" PreviewMouseRightButtonDown="RecordRightClicked" ContextMenuOpening="RecordContextOpening" AutomationProperties.Name="Squadrons assignments">
     <DataGrid.ContextMenu>
      <ContextMenu>
       <MenuItem x:Name="EditNativeRecordItem" Header="Edit selected assignment" Click="EditSelectedClicked"/>
       <MenuItem x:Name="ClearNativeRecordItem" Header="Clear selected assignment…" Click="ClearSelectedClicked"/>
      </ContextMenu>
     </DataGrid.ContextMenu>
     <DataGrid.Columns>
      <DataGridTextColumn Header="Command" Binding="{Binding CommandName}" Width="2*" MinWidth="260" ElementStyle="{StaticResource SquadronsCellText}"/>
      <DataGridTextColumn x:Name="ContextColumn" Header="Context" Binding="{Binding Section}" Width="180" Visibility="Collapsed" ElementStyle="{StaticResource SquadronsCellText}"/>
      <DataGridTextColumn x:Name="HardwareColumn" Header="Hardware check" Binding="{Binding HardwareStatus}" Width="220" Visibility="Collapsed" ElementStyle="{StaticResource SquadronsCellText}"/>
      <DataGridTextColumn x:Name="ControllerColumn" Header="Controller" Binding="{Binding DeviceLabel}" Width="210" ElementStyle="{StaticResource SquadronsCellText}"/>
      <DataGridTextColumn Header="Input" Binding="{Binding InputLabel}" Width="190" ElementStyle="{StaticResource SquadronsCellText}"/>
      <DataGridTextColumn x:Name="BindingColumn" Header="Binding" Binding="{Binding BindingLabel}" Width="85" Visibility="Collapsed"/>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="EmptyState" Grid.Row="0" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="24,60,24,24" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"/>
    <GridSplitter x:Name="DrawingSplitter" Grid.Row="1" Visibility="Visible" Style="{StaticResource SquadronsSectionSplitter}" ToolTip="Drag to resize Assignments and Drawing"/>
    <Expander x:Name="DrawingPanel" Grid.Row="2" Header="Controller drawing and assignments" IsExpanded="True" Margin="0,8,0,0" Expanded="DrawingExpanded" Collapsed="DrawingCollapsed" SizeChanged="DrawingPanelSizeChanged">
     <Grid Margin="0,6,0,0" MinHeight="0" ClipToBounds="True">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="0"/></Grid.RowDefinitions>
      <WrapPanel Grid.Row="0" Margin="0,0,0,6">
       <TextBlock Style="{StaticResource SquadronsFilterLabel}" Text="Hardware drawing"/>
       <ComboBox x:Name="DrawingPicker" Style="{StaticResource ToolbarComboBox}" Width="340" DisplayMemberPath="Title" SelectionChanged="DrawingChanged" AutomationProperties.Name="Squadrons shared hardware drawing"/>
       <Button x:Name="ClearDrawingButton" Style="{StaticResource SquadronsActionButton}" Content="Hide drawing" Click="ClearDrawingClicked"/>
       <TextBlock Style="{StaticResource SquadronsFilterLabel}" Text="Zoom" Margin="12,0,8,0"/>
       <Slider x:Name="DrawingZoom" Minimum="0.1" Maximum="3" Value="1" Width="140" VerticalAlignment="Center" AutomationProperties.Name="Squadrons drawing zoom"/>
       <Button x:Name="FitDrawingButton" Style="{StaticResource SquadronsActionButton}" Content="Fit" Margin="8,0,0,0" Click="FitDrawingClicked" ToolTip="Fit controller drawing to the available pane"/>
       <TextBlock x:Name="DrawingDropFeedback" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" Text="Select a command and click an outlined control to assign. Dragging also works."/>
      </WrapPanel>
      <!-- The ScrollViewer must measure the zoomed Canvas directly. A stretching Grid
           between them can mask the vertically transformed content extent. -->
      <Grid Grid.Row="1" MinHeight="0" ClipToBounds="True">
       <ScrollViewer x:Name="DrawingScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False" Focusable="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ToolTip="Wheel: vertical · Shift+wheel: horizontal · Ctrl+wheel: zoom at cursor · Middle-drag: pan">
        <Canvas x:Name="DrawingCanvas" Background="Transparent" Width="600" Height="200" HorizontalAlignment="Left" VerticalAlignment="Top"/>
       </ScrollViewer>
       <TextBlock x:Name="DrawingHint" Text="Choose a linked controller and select a shared hardware drawing above." Style="{StaticResource Hint}" Margin="12" TextWrapping="Wrap" IsHitTestVisible="False"/>
      </Grid>
     </Grid>
    </Expander>
    <games:GameAssignmentEditorView x:Name="SelectionEditor" Grid.Row="3"><games:GameAssignmentEditorView.NativeEditor>
    <StackPanel x:Name="AssignmentEditor" Margin="0,12,0,0" Visibility="Collapsed">
     <TextBlock x:Name="AssignmentHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Select an assignment to edit."/>
     <WrapPanel Margin="0,8,0,0">
      <ComboBox x:Name="TargetDevice" Style="{StaticResource ToolbarComboBox}" Width="260" DisplayMemberPath="Name" SelectionChanged="TargetChanged" AutomationProperties.Name="Squadrons assignment controller"/>
      <ComboBox x:Name="InputPicker" Style="{StaticResource ToolbarComboBox}" Width="220" Margin="8,0,0,0" DisplayMemberPath="DisplayName" SelectionChanged="InputChanged" AutomationProperties.Name="Squadrons assignment input"/>
      <Button x:Name="ApplyButton" Style="{StaticResource SquadronsActionButton}" Content="Apply assignment" Margin="8,0,0,0" Click="ApplyClicked"/>
     </WrapPanel>
    </StackPanel>
    </games:GameAssignmentEditorView.NativeEditor></games:GameAssignmentEditorView>
   </Grid>
  </Grid>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
 </games:GameWorkspaceShell>
</Window>
