<Window x:Class="Heimdall.App.Games.SquadronsWorkspaceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:pres="clr-namespace:Heimdall.App" xmlns:games="clr-namespace:Heimdall.App.Games" Title="HEIMDALL — Star Wars: Squadrons" Icon="{x:Static pres:ApplicationBranding.Icon}"
 Width="1340" Height="860" MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterOwner">
 <games:GameWorkspaceShell x:Name="WorkspaceRoot" Margin="10">
  <WrapPanel Margin="0,0,0,10">
   <ComboBox x:Name="GamePicker" Style="{StaticResource AppComboBox}" Width="180" SelectionChanged="GameChanged" AutomationProperties.Name="Game selection"><ComboBoxItem Content="DCS World" Tag="dcs"/><ComboBoxItem Content="Elite Dangerous" Tag="elite-dangerous"/><ComboBoxItem Content="Star Wars: Squadrons" Tag="star-wars-squadrons"/><ComboBoxItem Content="War Thunder" Tag="war-thunder"/></ComboBox>
   <ComboBox x:Name="ProfilePicker" Style="{StaticResource AppComboBox}" Width="220" Margin="8,0" DisplayMemberPath="Name" SelectionChanged="ProfileChanged" AutomationProperties.Name="Squadrons saved profile"/>
   <Button x:Name="NewProfileButton" Style="{StaticResource ToolbarActionButton}" Content="New profile…" Click="NewProfileClicked" ToolTip="Create an independent profile with no joystick assignments, using the current controller setup and native game settings."/>
   <Button x:Name="SaveButton" Style="{StaticResource ToolbarActionButton}" Content="Save" Click="SaveClicked"/>
   <Button x:Name="DiscardButton" Style="{StaticResource ToolbarActionButton}" Content="Discard" Click="DiscardClicked"/>
   <Button x:Name="ExportButton" Style="{StaticResource ToolbarActionButton}" Content="Export" Click="ExportClicked"/>
   <TextBlock x:Name="SaveState" Style="{StaticResource AppLabel}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="6,0"/>
  </WrapPanel>
  <Expander Grid.Row="1" Header="Configuration and export settings" Margin="0,0,0,6" pres:WorkspaceLayout.Key="squadrons.configuration">
   <StackPanel Margin="0,6,0,0">
    <WrapPanel><Button x:Name="ImportTemplatesButton" Style="{StaticResource ToolbarActionButton}" Content="Import templates…" Click="ImportTemplatesClicked" ToolTip="Recover cleared-command metadata from an original Squadrons capture without replacing this configuration’s bindings or controller links."/>
    <Button x:Name="ImportButton" Style="{StaticResource ToolbarActionButton}" Content="Add / Import…" Click="ImportClicked"/>
     <TextBlock Style="{StaticResource AppLabel}" Text="Profile name:" VerticalAlignment="Center" Margin="8,0"/>
     <TextBox x:Name="ProfileName" Style="{StaticResource AppTextBox}" Width="250" MaxLength="100" TextChanged="NameChanged" AutomationProperties.Name="Squadrons configuration name"/>
    </WrapPanel>
    <TextBlock Style="{StaticResource Hint}" Text="Export writes a separate review copy. Back up game settings before manually installing it." TextWrapping="Wrap" Margin="0,6,0,0"/>
   </StackPanel>
  </Expander>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <games:GameFeatureNavigation x:Name="FeaturePicker" SelectionChanged="FeatureChanged">
    <ListBoxItem Content="Devices"/><ListBoxItem Content="Assignments &amp; Testing"/>
   </games:GameFeatureNavigation>
   <pres:FeatureActionBar x:Name="FeatureActions" Grid.Row="1" ButtonStyle="{StaticResource ToolbarActionButton}" Margin="0,6,0,8"/>
   <games:GameControllerWorkspace Grid.Row="2" pres:WorkspaceLayout.Key="squadrons.controllers.split">
    <DockPanel Margin="0,0,10,0">
     <StackPanel DockPanel.Dock="Top"><TextBlock Style="{StaticResource AppLabel}" Text="Controllers in profile" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Style="{StaticResource Hint}" Text="Drag to reorder native slots" TextWrapping="Wrap" Margin="0,0,0,6"/></StackPanel>
     <TextBlock x:Name="ControllerSummary" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
     <ListBox x:Name="DevicePicker" Style="{StaticResource WorkspaceControllerList}" AllowDrop="True" SelectionChanged="FilterChanged" AutomationProperties.Name="Squadrons controller filter" ToolTip="Native slot moves require review. Ctrl+Up / Ctrl+Down also works."><ListBox.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource AppLabel}" Text="{Binding Name}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    </DockPanel>
    <ContentControl x:Name="FeatureContent" Grid.Column="2" Margin="6,0,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   </games:GameControllerWorkspace>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource AppLabel}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
 </games:GameWorkspaceShell>
</Window>
