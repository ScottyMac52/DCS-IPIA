<Window x:Class="Heimdall.App.Games.EliteWorkspaceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:pres="clr-namespace:Heimdall.App" xmlns:games="clr-namespace:Heimdall.App.Games" Title="HEIMDALL — Elite Dangerous" Icon="{x:Static pres:ApplicationBranding.Icon}"
 Width="1340" Height="860" MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterOwner">
 <games:GameWorkspaceShell x:Name="WorkspaceRoot" Margin="10">
  <WrapPanel Margin="0,0,0,10">
   <ComboBox Style="{StaticResource AppComboBox}" x:Name="GamePicker" Width="180" SelectionChanged="GameChanged" AutomationProperties.Name="Game selection"><ComboBoxItem Content="DCS World" Tag="dcs"/><ComboBoxItem Content="Elite Dangerous" Tag="elite-dangerous"/><ComboBoxItem Content="Star Wars: Squadrons" Tag="star-wars-squadrons"/></ComboBox>
   <ComboBox Style="{StaticResource AppComboBox}" x:Name="ProfilePicker" Width="220" DisplayMemberPath="Name" SelectionChanged="ProfileChanged" Margin="8,0" AutomationProperties.Name="Elite controls profile"/>
   <Button Style="{StaticResource ToolbarActionButton}" x:Name="SaveProfileButton" Content="Save" Click="SaveClicked"/>
   <Button Style="{StaticResource ToolbarActionButton}" x:Name="DiscardProfileButton" Content="Discard" Click="DiscardClicked"/>
   <Button Style="{StaticResource ToolbarActionButton}" x:Name="ExportPresetButton" Content="Export" Click="ExportClicked"/>
   <TextBlock Style="{StaticResource AppLabel}" x:Name="SaveState" VerticalAlignment="Center" FontWeight="SemiBold" Margin="6,0"/>
  </WrapPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,6">
   <Expander Header="Configuration and export settings" pres:WorkspaceLayout.Key="elite.configuration">
    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">  <StackPanel>
   <WrapPanel Margin="0,4,0,8">
   <Button Style="{StaticResource ToolbarActionButton}" x:Name="ImportPresetButton" Content="Add / Import…" Click="ImportClicked"/>

    <Button Style="{StaticResource ToolbarActionButton}" x:Name="NewConfigurationButton" Content="New configuration…" Click="NewConfigurationClicked" ToolTip="Start with this configuration’s commands and controllers, with all assignments cleared. Without a configuration, choose an ED preset as a command template."/>
    <Button Style="{StaticResource ToolbarActionButton}" x:Name="DuplicateConfigurationButton" Content="Duplicate…" Click="DuplicateConfigurationClicked" ToolTip="Create an independent named copy, including current pending edits."/>
    <Button Style="{StaticResource ToolbarActionButton}" x:Name="RenameConfigurationButton" Content="Rename…" Click="RenameConfigurationClicked" ToolTip="Stage a name change; Save persists it."/>
    <Button Style="{StaticResource ToolbarActionButton}" x:Name="DeleteConfigurationButton" Content="Delete…" Click="DeleteConfigurationClicked" ToolTip="Delete this saved HEIMDALL configuration. Exported ED presets remain in place."/>
   </WrapPanel>
   <WrapPanel><TextBlock Style="{StaticResource AppLabel}" Text="Profile name:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Style="{StaticResource AppTextBox}" x:Name="ProfileName" Width="250" TextChanged="ProfileNameChanged" MaxLength="100"/>

   </WrapPanel>
   <Expander Header="Export destination" Margin="0,6,0,0">
    <StackPanel>
     <Grid Margin="0,4,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource AppLabel}" Text="Bindings directory:" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox Style="{StaticResource AppTextBox}" x:Name="BindingsDirectoryText" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="ED bindings export directory"/>
      <Button Style="{StaticResource ToolbarActionButton}" x:Name="BrowseBindingsDirectoryButton" Grid.Column="2" Content="Browse…" Click="BrowseBindingsDirectoryClicked"/>
      <Button Style="{StaticResource ToolbarActionButton}" x:Name="ResetBindingsDirectoryButton" Grid.Column="3" Content="Reset to default" Click="ResetBindingsDirectoryClicked"/>
     </Grid>
     <CheckBox Style="{StaticResource AppCheckBox}" x:Name="ExportToReviewFolder" Content="Export to a separate review folder" ToolTip="Keep installation manual by exporting a separate copy instead of writing to the bindings directory."/>
     <TextBlock Style="{StaticResource Hint}" Text="Direct export writes only the named preset. Replacing it requires confirmation and creates a backup. Close ED before exporting to its Bindings folder." Margin="0,4,0,0"/>
    </StackPanel>
   </Expander>
  </StackPanel></ScrollViewer>
   </Expander>
    <ListBox x:Name="SectionPicker" Margin="0,4,0,0" SelectionChanged="SectionChanged" AutomationProperties.Name="Elite controls section"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
     <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="10,4"/></Style></ListBox.ItemContainerStyle>
     <ListBoxItem Content="All"/><ListBoxItem Content="Ship"/><ListBoxItem Content="SRV"/><ListBoxItem Content="On Foot"/><ListBoxItem Content="General"/>
    </ListBox>
  </StackPanel>
  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <ListBox x:Name="FeaturePicker" SelectionChanged="FeatureChanged" AutomationProperties.Name="Game feature navigation"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
    <ListBoxItem Content="Devices"/><ListBoxItem Content="Assignments &amp; Testing"/><ListBoxItem Content="Reference Sheets"/>
   </ListBox>
   <pres:FeatureActionBar ButtonStyle="{StaticResource ToolbarActionButton}" x:Name="FeatureActions" Grid.Row="1" Margin="0,6,0,8"/>
   <Grid Grid.Row="2" x:Name="ControllerPanes" pres:WorkspaceLayout.Key="elite.controllers.split">
    <Grid.ColumnDefinitions><ColumnDefinition Width=".18*" MinWidth="160"/><ColumnDefinition Width="8"/><ColumnDefinition Width=".82*" MinWidth="540"/></Grid.ColumnDefinitions>
    <DockPanel Margin="0,0,10,0">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource AppLabel}" Text="Controllers in profile" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBlock Style="{StaticResource AppLabel}" Text="Drag to reorder" Margin="0,0,0,6"/>
     </StackPanel>
     <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Button Style="{StaticResource ToolbarActionButton}" Width="Auto" HorizontalAlignment="Stretch" x:Name="MoveControllerUpButton" Content="Move up" Click="MoveControllerUpClicked" ToolTip="Move selected controller up (Ctrl+Up)"/>
      <Button Style="{StaticResource ToolbarActionButton}" Grid.Row="2" Width="Auto" HorizontalAlignment="Stretch" x:Name="MoveControllerDownButton" Content="Move down" Click="MoveControllerDownClicked" ToolTip="Move selected controller down (Ctrl+Down)"/>
     </Grid>
     <ListBox Style="{StaticResource WorkspaceControllerList}" x:Name="DevicePicker" SelectionChanged="DeviceChanged" AllowDrop="True" AutomationProperties.Name="Elite native device references"
              ToolTip="Display order only. Drag a controller or use Ctrl+Up / Ctrl+Down.">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource AppLabel}" Text="{Binding Name}" TextWrapping="Wrap" ToolTip="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
    <GridSplitter Grid.Column="1" Style="{StaticResource WorkspaceDivider}" AutomationProperties.Name="Controllers and workspace divider"/>
    <ContentControl x:Name="FeatureContent" Margin="6,0,0,0" Grid.Column="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="3">
   <Expander Header="Export status and installation details" Margin="0,5,0,0"><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
   <TextBlock Style="{StaticResource AppLabel}" x:Name="ExportState" Text="Save stages your profile in HEIMDALL. Export writes its named preset to the selected destination." TextWrapping="Wrap" Margin="0,5,0,0" AutomationProperties.Name="ED export and installation status"/>
   </ScrollViewer></Expander>
   <TextBlock Style="{StaticResource AppLabel}" x:Name="AccessStatus" Margin="0,5,0,0" TextWrapping="Wrap"/>
  <TextBlock Style="{StaticResource AppLabel}" x:Name="WorkspaceStatus" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </games:GameWorkspaceShell>
</Window>

