<UserControl x:Class="Heimdall.App.Games.WarThunderNativeEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:games="clr-namespace:Heimdall.App.Games" xmlns:pres="clr-namespace:Heimdall.App">
 <games:GameAssignmentEditorView x:Name="Frame"><games:GameAssignmentEditorView.NativeEditor>
  <StackPanel>
   <WrapPanel><StackPanel Width="210" Margin="0,0,8,0"><TextBlock Style="{StaticResource AppLabel}" Text="Controller"/><ComboBox Style="{StaticResource AppComboBox}" x:Name="Target" AutomationProperties.Name="Native target mapping"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding Id}" FontSize="10"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
    <StackPanel Width="120" Margin="0,0,8,0"><TextBlock Style="{StaticResource AppLabel}" Text="Input (zero-based)"/><TextBox Style="{StaticResource AppTextBox}" x:Name="Index" Text="0" AutomationProperties.Name="Native local index"/></StackPanel>

   </WrapPanel>
   <pres:ActionBar IsFeatureActions="True" FeatureOrder="-1" Visibility="Collapsed"><Button Style="{StaticResource ToolbarActionButton}" x:Name="Apply" Content="Apply assignment"/><Button Style="{StaticResource ToolbarActionButton}" x:Name="Add" Content="Add alternative"/><Button Style="{StaticResource ToolbarActionButton}" x:Name="Clear" Content="Clear assignment" ToolTip="Clear only the selected joystick alternative; preserve other alternatives."/>
   </pres:ActionBar>
   <CheckBox x:Name="Inverse" Content="Invert axis" Style="{StaticResource AppCheckBox}" Margin="0,6"/>
   <Expander x:Name="NativeDetails" Header="Native record details" IsExpanded="False"><StackPanel>
    <ComboBox Style="{StaticResource AppComboBox}" x:Name="Input" DisplayMemberPath="Address" AutomationProperties.Name="Native input occurrence"/>
   <WrapPanel><TextBlock Style="{StaticResource AppLabel}" Text="Captured axis parameter" VerticalAlignment="Center"/><ComboBox Style="{StaticResource AppComboBox}" x:Name="Parameter" DisplayMemberPath="Path" Width="220" Margin="8,0"/>
    <TextBox Style="{StaticResource AppTextBox}" x:Name="Literal" Width="100" AutomationProperties.Name="Native parameter literal"/><Button Style="{StaticResource ToolbarActionButton}" x:Name="SetParameter" Content="Apply parameter"/>
   </WrapPanel>
   </StackPanel></Expander>
  </StackPanel>
 </games:GameAssignmentEditorView.NativeEditor></games:GameAssignmentEditorView>
</UserControl>
