<UserControl x:Class="Heimdall.App.Games.WarThunderNativeEditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:games="clr-namespace:Heimdall.App.Games">
 <games:GameAssignmentEditorView x:Name="Frame"><games:GameAssignmentEditorView.NativeEditor>
  <StackPanel>
   <WrapPanel><StackPanel Width="210" Margin="0,0,8,0"><TextBlock Style="{StaticResource AppLabel}" Text="Saved native mapping"/><ComboBox Style="{StaticResource AppComboBox}" x:Name="Target" DisplayMemberPath="Id" AutomationProperties.Name="Native target mapping"/></StackPanel>
    <StackPanel Width="120" Margin="0,0,8,0"><TextBlock Style="{StaticResource AppLabel}" Text="Index (zero-based)"/><TextBox Style="{StaticResource AppTextBox}" x:Name="Index" Text="0" AutomationProperties.Name="Native local index"/></StackPanel>
    <StackPanel Width="180"><TextBlock Style="{StaticResource AppLabel}" Text="Input occurrence"/><ComboBox Style="{StaticResource AppComboBox}" x:Name="Input" DisplayMemberPath="Address" AutomationProperties.Name="Native input occurrence"/></StackPanel>
   </WrapPanel>
   <WrapPanel Margin="0,5"><Button Style="{StaticResource ToolbarActionButton}" x:Name="Apply" Content="Apply native input"/><Button Style="{StaticResource ToolbarActionButton}" x:Name="Add" Content="Add native alternative"/><Button Style="{StaticResource ToolbarActionButton}" x:Name="Clear" Content="Clear joystick alternative"/>
    <CheckBox x:Name="Inverse" Content="Inverse axis" VerticalAlignment="Center" Margin="8,0"/>
   </WrapPanel>
   <WrapPanel><TextBlock Style="{StaticResource AppLabel}" Text="Captured axis parameter" VerticalAlignment="Center"/><ComboBox Style="{StaticResource AppComboBox}" x:Name="Parameter" DisplayMemberPath="Path" Width="220" Margin="8,0"/>
    <TextBox Style="{StaticResource AppTextBox}" x:Name="Literal" Width="100" AutomationProperties.Name="Native parameter literal"/><Button Style="{StaticResource ToolbarActionButton}" x:Name="SetParameter" Content="Apply parameter"/>
   </WrapPanel>
  </StackPanel>
 </games:GameAssignmentEditorView.NativeEditor></games:GameAssignmentEditorView>
</UserControl>
