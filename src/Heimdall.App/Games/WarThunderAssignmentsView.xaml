<UserControl x:Class="Heimdall.App.Games.WarThunderAssignmentsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pres="clr-namespace:Heimdall.App" xmlns:games="clr-namespace:Heimdall.App.Games">
 <DockPanel>
  <pres:ActionBar IsFeatureActions="True" Visibility="Collapsed">
   <Button Style="{StaticResource ToolbarActionButton}" x:Name="Start" Content="Start input test"/><Button Style="{StaticResource ToolbarActionButton}" x:Name="Stop" Content="Stop"/><Button Style="{StaticResource ToolbarActionButton}" x:Name="Fit" Content="Fit"/>
  </pres:ActionBar>
  <games:GameWorkspaceSplit pres:WorkspaceLayout.Key="war-thunder.assignments.split">
   <DockPanel Margin="0,0,6,0">
    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Text="Commands come from the imported profile. Inherited presets may contain additional commands." TextWrapping="Wrap" Margin="0,8,0,0"/>
    <games:GameCommandBrowserView x:Name="Browser"/>
   </DockPanel>
   <Grid Grid.Column="2" Margin="6,0,0,0"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="180"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Expander Header="Controller drawing" IsExpanded="True" Margin="0,8,0,0"><games:GameDrawingView x:Name="Artwork" Margin="0,6,0,0"/></Expander>
    <Expander x:Name="CapturedAssignments" Grid.Row="1" Header="Captured assignments and diagnostics" IsExpanded="False" pres:WorkspaceLayout.Key="war-thunder.assignments.table">
     <DataGrid x:Name="Records" MaxHeight="170" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" AutomationProperties.Name="Native binding records">
      <DataGrid.Columns><DataGridTextColumn Header="Command" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Input" Binding="{Binding Inputs}" Width="2*"/><DataGridTextColumn Header="Native fields" Binding="{Binding Details}" Width="2*"/></DataGrid.Columns>
     </DataGrid>
    </Expander>
    <games:WarThunderNativeEditorView x:Name="Editor" Grid.Row="2" Margin="0,12,0,0"/>
   </Grid>
  </games:GameWorkspaceSplit>
 </DockPanel>
</UserControl>
