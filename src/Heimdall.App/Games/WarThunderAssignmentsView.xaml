<UserControl x:Class="Heimdall.App.Games.WarThunderAssignmentsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:pres="clr-namespace:Heimdall.App" xmlns:games="clr-namespace:Heimdall.App.Games">
 <DockPanel>
  <pres:ActionBar IsFeatureActions="True" Visibility="Collapsed" DockPanel.Dock="Top">
   <Button Style="{StaticResource ToolbarActionButton}" x:Name="Start" Content="Start input test"/><Button Style="{StaticResource ToolbarActionButton}" x:Name="Stop" Content="Stop input test"/><Button Style="{StaticResource ToolbarActionButton}" x:Name="Fit" Content="Fit drawing"/>
  </pres:ActionBar>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <games:GameCommandBrowserView x:Name="Browser" Margin="6"/>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
   <Grid Grid.Column="2" Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Style="{StaticResource AppLabel}" Text="Captured commands only; inherited presets may contain additional commands." TextWrapping="Wrap"/>
     <games:WarThunderNativeEditorView x:Name="Editor" Margin="0,6"/>
    </StackPanel>
    <DataGrid x:Name="Records" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" AutomationProperties.Name="Native binding records">
     <DataGrid.Columns><DataGridTextColumn Header="Command" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Native input (zero-based)" Binding="{Binding Inputs}" Width="2*"/><DataGridTextColumn Header="Native fields" Binding="{Binding Details}" Width="2*"/></DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="2" Margin="0,8,0,0">
     <StackPanel DockPanel.Dock="Top"><TextBlock Style="{StaticResource AppLabel}" Text="Drawing shows physical controls. Native indices are edited above; their physical correspondence has not been verified." TextWrapping="Wrap"/>
      <Slider x:Name="Zoom" Minimum="0.15" Maximum="3" Value="1" AutomationProperties.Name="Drawing zoom"/>
      <TextBox Style="{StaticResource AppTextBox}" x:Name="Activity" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" AutomationProperties.Name="Physical input activity"/>
     </StackPanel>
     <ScrollViewer x:Name="DrawingScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Canvas x:Name="DrawingCanvas"/></ScrollViewer>
    </DockPanel>
   </Grid>
  </Grid>
 </DockPanel>
</UserControl>
