{
  "SchemaVersion": 1,
  "Theme": "Light",
  "OccupiedDestinationBehavior": "Ask",
  "SavedGamesDcsFolder": "",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "Heimdall.App": "Error",
        "Heimdall.Application": "Error",
        "Heimdall.Dcs": "Error",
        "Heimdall.Domain": "Error",
        "Heimdall.Infrastructure": "Error",
        "Heimdall.Packaging": "Error",
        "Heimdall.Rendering": "Error",
        "Microsoft": "Error",
        "System": "Error",
        "Heimdall.EliteDangerous": "Error"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%/HEIMDALL/Logs/heimdall-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}
