<UserControl x:Class="Heimdall.App.Features.InputTest.InputTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pres="clr-namespace:Heimdall.App">
    <Grid x:Name="InputTestPanes" Margin="4" pres:WorkspaceLayout.Key="input-test.split">
      <Grid.ColumnDefinitions><ColumnDefinition Width=".35*" MinWidth="240"/><ColumnDefinition Width="8"/><ColumnDefinition Width=".65*" MinWidth="280"/></Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="70"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" MaxHeight="160" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Style="{StaticResource AppLabel}"/>
            <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="Feedback device:" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource AppLabel}"/>
                <ComboBox Visibility="Collapsed" SelectedValuePath="ProfileId" x:Name="FeedbackDevice" Width="240" DisplayMemberPath="Title" Style="{StaticResource ToolbarComboBox}"/>
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
                <pres:ActionBar IsFeatureActions="True" Visibility="Collapsed">
                    <Button x:Name="StartInputTestButton" Content="Start test" Click="StartInputTestClicked" Style="{StaticResource ActionButton}"/>
                    <Button x:Name="StopInputTestButton" Content="Stop test" Click="StopInputTestClicked" Style="{StaticResource ActionButton}" IsEnabled="False"/>
                </pres:ActionBar>
            </WrapPanel>
            <ComboBox x:Name="InputTestSnapshotChoice" SelectedIndex="0"><ComboBoxItem Content="Current edits"/><ComboBoxItem Content="Saved profile"/></ComboBox>
            <TextBlock x:Name="InputTestLogMessage"/>
            <TextBlock x:Name="InputTestStatus" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource AppLabel}"/>
            <TextBlock x:Name="InputTestModifiers" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource AppLabel}"/>
        </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="Events" VerticalAlignment="Center" Style="{StaticResource AppLabel}"/>
                <Button x:Name="ClearInputTestLogButton" IsEnabled="False" Content="Clear log" Click="ClearInputTestLogClicked" Padding="6,2" Margin="8,0,0,0" Style="{StaticResource ActionButton}"/>
                <Button Style="{StaticResource ActionButton}" x:Name="CopyInputTestLogButton" Content="Copy events" Click="CopyInputTestLogClicked" IsEnabled="False"/>
                <ComboBox x:Name="EventFilter" Width="100" Margin="12,0,0,0" SelectedIndex="0" SelectionChanged="EventFilterChanged" Style="{StaticResource ToolbarComboBox}">
                    <ComboBoxItem Content="Both"/>
                    <ComboBoxItem Content="Press"/>
                    <ComboBoxItem Content="Release"/>
                </ComboBox>
                <CheckBox x:Name="ShowAxis" Content="Show axis values" Style="{StaticResource AppCheckBox}" Margin="12,0,0,0" Checked="EventFilterChanged" Unchecked="EventFilterChanged"/>
            </WrapPanel>
            <ListBox x:Name="InputTestLog" SelectionMode="Extended" DisplayMemberPath="Display"/>
        </DockPanel>
        <Expander Grid.Row="2" Header="SHIFT / MODIFIER legend" IsExpanded="True" pres:WorkspaceLayout.Key="input-test.legend">
          <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ModifierLegend" AutomationProperties.Name="Live shift and modifier legend">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}"
                                        Margin="0,0,0,5" Padding="2,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <pres:ContrastOutlineBorder Grid.Column="0" Width="15" Height="15" VerticalAlignment="Top" Margin="0,3,0,0"
                                                Background="{Binding Color}" BorderBrush="{Binding Color}"
                                                BorderThickness="1">
                                            <pres:ContrastOutlineBorder.Style>
                                                <Style TargetType="pres:ContrastOutlineBorder">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </pres:ContrastOutlineBorder.Style>
                                        </pres:ContrastOutlineBorder>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11"/>
                                        <TextBlock Grid.Column="2" Text="●" Margin="5,0,0,0"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"
                                                   AutomationProperties.Name="Modifier active">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
          </ScrollViewer>
        </Expander>
      </Grid>
      <GridSplitter Grid.Column="1" Style="{StaticResource WorkspaceDivider}" x:Name="InputTestSplitter" AutomationProperties.Name="Events and controller divider"/>
            <DockPanel Grid.Column="2" Margin="6,0,0,0">
            <TextBlock x:Name="DeviceTitle" DockPanel.Dock="Top" Margin="0,0,0,4" Style="{StaticResource AppLabel}"/>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button Style="{StaticResource ActionButton}" x:Name="FitDiagramButton" Content="Fit" Click="FitDiagramClicked" Padding="8,2" Margin="0,0,8,0"/>
                <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource AppLabel}"/>
                <Slider x:Name="Zoom" Width="100" Minimum="0.01" Maximum="2.5" Value="1"
                ValueChanged="ZoomChanged" VerticalAlignment="Center" MouseDoubleClick="Zoom_MouseDoubleClick"/>
                <TextBox x:Name="ZoomPercent" Width="50" Margin="8,0,0,0" Text="100" LostFocus="ZoomPercentChanged" VerticalAlignment="Center" Style="{StaticResource AppTextBox}"/>
                <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,0,0" Style="{StaticResource AppLabel}"/>
            </WrapPanel>
            <ScrollViewer x:Name="DiagramScroll" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="Diagram"/>
            </ScrollViewer>
            </DockPanel>
    </Grid>
</UserControl>
