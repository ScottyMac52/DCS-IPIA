<UserControl x:Class="Heimdall.App.Features.Devices.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pres="clr-namespace:Heimdall.App">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText"/>
            <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource AppLabel}"/>
                <ComboBox x:Name="DevicesScope" Width="140" Margin="0,0,12,0" SelectionChanged="ScopeChanged" Style="{StaticResource AppComboBox}" >
                    <ComboBoxItem Content="Module"/>
                    <ComboBoxItem Content="Module UI Layer"/>
                </ComboBox>
                <pres:ActionBar IsFeatureActions="True" Visibility="Collapsed" Margin="12,0,0,0">
                    <Button Content="Load built-in hardware" Click="LoadHardwareClicked" Style="{StaticResource ActionButton}"/>
                    <Button Content="New" Click="NewDeviceClicked" Style="{StaticResource ActionButton}"/>
                    <Button Content="Save to database" Click="SaveClicked" Style="{StaticResource ActionButton}"/>
                    <Button Content="Discard draft" Click="DiscardClicked" Style="{StaticResource ActionButton}"/>
                    <Button Content="Import DCS axis defaults…" Click="ImportAxisDefaultsClicked" Style="{StaticResource ActionButton}"/>
                </pres:ActionBar>
            </WrapPanel>
        </StackPanel>
        <pres:DeviceDetailsLayout Grid.Row="1" pres:WorkspaceLayout.Key="devices.split">
            <DataGrid Visibility="Collapsed" SelectedValuePath="ProfileId" x:Name="ManagedDevices" Grid.Column="0" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,4,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Device" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Instance" Binding="{Binding Instance}" Width="100"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="0" Margin="4,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <TextBlock Text="Controller setup" Style="{StaticResource SectionTitle}"/>
                    <GroupBox Header="Physical controller" Style="{StaticResource DeviceSetupSection}"><StackPanel>
<Button x:Name="UnlinkPhysicalButton" Content="Unlink physical controller…" Click="UnlinkPhysicalClicked" Style="{StaticResource ActionButton}"/>
                        <ComboBox x:Name="DetectedDevice" DisplayMemberPath="Title" SelectionChanged="DetectedDeviceChanged" Margin="0,4,0,10" Style="{StaticResource AppComboBox}"/>
</StackPanel></GroupBox>
                    <TextBlock Text="Adopted hardware inventory" Style="{StaticResource AppLabel}"/>
                    <ComboBox x:Name="InventoryUnits" DisplayMemberPath="Title" Margin="0,4,0,8" Style="{StaticResource AppComboBox}"/>
                    <Button Content="Add inventory unit with generic controls" Click="AddInventoryClicked" Padding="8,4" Margin="0,0,0,10" Style="{StaticResource ActionButton}"/>
                    <GroupBox Header="Hardware drawing" Style="{StaticResource DeviceSetupSection}"><StackPanel>
<Button x:Name="UnlinkDrawingButton" Content="Unlink drawing" Click="UnlinkDrawingClicked" Style="{StaticResource ActionButton}"/>
                    <Button x:Name="UseRetainedDrawingButton" Content="Link retained drawing" Click="UseRetainedDrawingClicked" Style="{StaticResource ActionButton}"/>
                    <ComboBox x:Name="CustomMappingRevisions" DisplayMemberPath="Title" Margin="0,4,0,8" Style="{StaticResource AppComboBox}"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Refresh mappings" Click="RefreshUserMappingsClicked" Padding="8,4" Style="{StaticResource ActionButton}"/>
                        <Button x:Name="ApplyCustomDrawingButton" Content="Apply drawing to selected device" Click="AdoptCustomMappingClicked" Padding="8,4" Margin="6,0,0,0" Style="{StaticResource ActionButton}"/>
                    </WrapPanel>
                    <TextBlock Text="Shared hardware" Style="{StaticResource AppLabel}"/>
                    <ComboBox x:Name="ManagedHardware" DisplayMemberPath="Title" Margin="0,4,0,10" Style="{StaticResource AppComboBox}"/>
</StackPanel></GroupBox>
                    <Expander Header="DCS device settings" Margin="0,8,0,0"><StackPanel>
                    <TextBlock Text="Native DCS filename" Style="{StaticResource AppLabel}"/>
                    <TextBox x:Name="ManagedFileName" Margin="0,4,0,10" Style="{StaticResource AppTextBox}"/>
                    <TextBlock Text="Instance (optional)" Style="{StaticResource AppLabel}"/>
                    <TextBox x:Name="ManagedInstance" Margin="0,4,0,10" Style="{StaticResource AppTextBox}"/>
                    <TextBlock Text="Role (optional)" Style="{StaticResource AppLabel}"/>
                    <TextBox x:Name="ManagedRole" Margin="0,4,0,10" Style="{StaticResource AppTextBox}"/>
                    <GroupBox x:Name="KneeboardTitleFields" Header="Module kneeboard" Padding="8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Kneeboard title" Style="{StaticResource AppLabel}"/>
                            <TextBox x:Name="ManagedKneeboardTitle" Margin="0,4,0,0" Style="{StaticResource AppTextBox}"/>
                            <TextBlock Text="Kneeboard subtitle (optional)" Style="{StaticResource AppLabel}" Margin="0,8,0,0"/>
                            <TextBox x:Name="ManagedKneeboardSubtitle" Margin="0,4,0,0" Style="{StaticResource AppTextBox}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="MfdLabelFields" Header="Module MFD labels" Padding="8" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Left" Style="{StaticResource AppLabel}"/>
                            <TextBox x:Name="MfdLeft" Style="{StaticResource AppTextBox}"/>
                            <TextBlock Text="Right" Style="{StaticResource AppLabel}"/>
                            <TextBox x:Name="MfdRight" Style="{StaticResource AppTextBox}"/>
                            <TextBlock Text="Top" Style="{StaticResource AppLabel}"/>
                            <TextBox x:Name="MfdTop" Style="{StaticResource AppTextBox}"/>
                            <TextBlock Text="Bottom" Style="{StaticResource AppLabel}"/>
                            <TextBox x:Name="MfdBottom" Style="{StaticResource AppTextBox}"/>
                        </StackPanel>
                    </GroupBox>
                    </StackPanel></Expander>
                        <pres:ActionBar Margin="0,8,0,0">
                            <Button Content="Update" Click="UpdateDeviceClicked" Style="{StaticResource ActionButton}"/>
                            <Button Content="Remove" Click="RemoveDeviceClicked" Style="{StaticResource ActionButton}"/>
                            <Button Content="Clear assignments" Click="ClearDeviceAssignmentsClicked" Style="{StaticResource ActionButton}"/>
                            <Button Content="Add" Click="AddDeviceClicked" Style="{StaticResource ActionButton}"/>
                            <Button Content="Rebind physical unit…" Click="RebindDeviceClicked" Style="{StaticResource ActionButton}"/>
                        </pres:ActionBar>
                        <TextBlock x:Name="StatusMessage" TextWrapping="Wrap" Margin="0,12,0,0" Style="{StaticResource AppLabel}"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
            <pres:WorkspaceDrawingPreview x:Name="ControllerPreview" Grid.Column="2" Margin="6,0,0,0"/>
        </pres:DeviceDetailsLayout>
    </Grid>
</UserControl>
