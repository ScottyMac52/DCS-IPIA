<Window x:Class="Heimdall.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HEIMDALL settings" Width="540" Height="520" MinWidth="420" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="24">
    <TextBlock FontSize="23" FontWeight="SemiBold" Text="Settings"/>
    <TextBlock Margin="0,6,0,22" Foreground="{DynamicResource SecondaryTextBrush}"
               Text="Choose preferences for this profile. Customize appearance offers an Apply/Cancel preview."/>
    <TextBlock x:Name="EditionStatus" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <Button Content="Install owner license…" Click="InstallOwnerLicenseClicked" HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,12"/>
    <TextBlock FontWeight="SemiBold" Text="UI skin"/>
    <ComboBox x:Name="ThemeChoice" Width="180" HorizontalAlignment="Left" Margin="0,6,0,8"
              AutomationProperties.Name="Appearance theme" SelectionChanged="ThemeChoice_SelectionChanged">
      <ComboBoxItem Content="Modern Light" Tag="Light"/>
      <ComboBoxItem Content="Modern Dark" Tag="Dark"/>
      <ComboBoxItem Content="Navy/Amber" Tag="NavyAmber"/>
      <ComboBoxItem Content="Cockpit Green" Tag="CockpitGreen"/>
    </ComboBox>
    <Button x:Name="CustomizeAppearance" Content="Customize appearance…" Click="CustomizeAppearanceClicked"
            HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,8"/>
    <Button x:Name="ResetAppearance" Content="Restore default appearance" Click="ResetAppearanceClicked"
            HorizontalAlignment="Left" Padding="10,4" Margin="0,0,0,16"
            AutomationProperties.Name="Restore default appearance"/>
    <TextBlock FontWeight="SemiBold" Text="Occupied destination"/>
    <ComboBox x:Name="ConflictChoice" Width="235" HorizontalAlignment="Left" Margin="0,6,0,8"
              AutomationProperties.Name="Occupied destination behavior" SelectionChanged="ConflictChoice_SelectionChanged">
      <ComboBoxItem Content="Ask before replacing" Tag="Ask"/>
      <ComboBoxItem Content="Replace in draft" Tag="ReplaceInDraft"/>
      <ComboBoxItem Content="Do not replace" Tag="Reject"/>
    </ComboBox>
    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
               Text="This choice controls assignment drops for the selected data profile."/>
    <TextBlock FontWeight="SemiBold" Text="Saved Games DCS Folder" Margin="0,14,0,4"/>
    <TextBlock x:Name="SavedGamesFolder" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
    <Button Content="Browse…" Click="BrowseSavedGamesClicked" HorizontalAlignment="Left" Padding="14,4" Margin="0,8,0,0" AutomationProperties.Name="Browse Saved Games DCS Folder"/>
    <TextBlock x:Name="SaveStatus" Margin="0,12,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
  </ScrollViewer>
</Window>
