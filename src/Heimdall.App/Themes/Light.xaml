<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F7FB"/>
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#17263D"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="White"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#D9E2EF"/>
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#475569"/>
  <SolidColorBrush x:Key="SampleControlBrush" Color="#E8F0FF"/>
  <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#EFF6FF"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="#1D4ED8"/>
  <SolidColorBrush x:Key="CanvasBorderBrush" Color="#9DB4D7"/>
  <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#F2F6FD"/>
  <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#EAF0F8"/>
  <SolidColorBrush x:Key="StatusTextBrush" Color="#334155"/>
  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ControlForegroundBrush" Color="#17263D"/>
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#9DB4D7"/>
  <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#DBEAFE"/>
  <SolidColorBrush x:Key="DisabledTextBrush" Color="#475569"/>
  <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#E8EEF6"/>
  <SolidColorBrush x:Key="ErrorTextBrush" Color="#A61B1B"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="White"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#17263D"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#17263D"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="White"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="White"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#9DB4D7"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#9DB4D7"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#475569"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#DBEAFE"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#17263D"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#DBEAFE"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#17263D"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#17263D"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="White"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#17263D"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ScrollBarBrushKey}" Color="White"/>
  <SolidColorBrush x:Key="ControlSurfaceBrush" Color="White"/>
  <SolidColorBrush x:Key="OpaqueControlBackgroundBrush" Color="#FFFFFF"/>
    <!-- Functional contrast edges stay black/white around every live input-state color. -->
    <SolidColorBrush x:Key="InputOutlineDarkBrush" Color="#000000"/>
    <SolidColorBrush x:Key="InputOutlineLightBrush" Color="#FFFFFF"/>
</ResourceDictionary>
