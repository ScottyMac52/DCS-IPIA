<Window x:Class="DcsIpia.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DcsIpia.Presentation"
        Title="DCS-IPIA — Modules" Icon="{x:Static local:ApplicationBranding.Icon}"
        Width="780" Height="620" MinWidth="620" MinHeight="450"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" AutomationProperties.Name="Application menu">
      <MenuItem Header="_File">
        <MenuItem Header="_New module…" Command="{x:Static local:MainWindowCommands.NewModule}"/>
        <MenuItem Header="_Open selected module…" Command="{x:Static local:MainWindowCommands.OpenModule}"/>
        <MenuItem Header="_Import module sources…" Command="{x:Static local:MainWindowCommands.ImportModule}"/>
        <MenuItem Header="_Restore module snapshot…" Command="{x:Static local:MainWindowCommands.RestoreModule}"/>
        <MenuItem Header="_Delete selected module…" Command="{x:Static local:MainWindowCommands.DeleteModule}"/>
        <Separator/>
        <MenuItem Header="E_xit" Command="{x:Static local:MainWindowCommands.Exit}"/>
      </MenuItem>
      <MenuItem Header="_Hardware">
        <MenuItem Header="_Discover devices… / Rescan" Command="{x:Static local:MainWindowCommands.DiscoverHardware}"/>
        <MenuItem Header="_Manage devices…" Command="{x:Static local:MainWindowCommands.ManageHardware}"/>
        <MenuItem Header="_Hardware drawings… / Import draw.io" Command="{x:Static local:MainWindowCommands.UserMappings}"/>
      </MenuItem>
      <MenuItem Header="_Module">
        <MenuItem Header="_Open workspace — edit, save, validate and build…" Command="{x:Static local:MainWindowCommands.OpenModule}"/>
        <MenuItem Header="_Shared default UI Layer…" Command="{x:Static local:MainWindowCommands.SharedDefaults}"/>
      </MenuItem>
      <MenuItem Header="_Deployment">
        <MenuItem Header="_Saved Games destination…" Command="{x:Static local:MainWindowCommands.Destination}"/>
        <MenuItem Header="_Fly Now!" Command="{x:Static local:MainWindowCommands.FlyNow}"/>
        <MenuItem Header="_Clear active deployment" Command="{x:Static local:MainWindowCommands.ClearDeployment}"/>
      </MenuItem>
      <MenuItem Header="_Data &amp; recovery">
        <MenuItem Header="_Back up user data…" Command="{x:Static local:MainWindowCommands.Backup}"/>
        <MenuItem Header="_Restore backup…" Command="{x:Static local:MainWindowCommands.RestoreData}"/>
        <MenuItem Header="Review restored _deployment…" Command="{x:Static local:MainWindowCommands.Recovery}"/>
        <MenuItem Header="Show data _location" Command="{x:Static local:MainWindowCommands.DataLocation}"/>
        <MenuItem Header="Test _profiles and reset…" Command="{x:Static local:MainWindowCommands.Profiles}"/>
      </MenuItem>
      <MenuItem Header="_Settings">
        <MenuItem Header="_Resume / rerun hardware setup…" Command="{x:Static local:MainWindowCommands.Setup}"/>
        <MenuItem Header="_Preferences…" Command="{x:Static local:MainWindowCommands.Settings}"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem x:Name="TrainingMenuItem" Header="_Training / Guided workflows…" Click="TrainingClicked"/>
        <MenuItem Header="_Export support report…" Command="{x:Static local:MainWindowCommands.SupportReport}"/>
        <MenuItem Header="_About and workflow help…" Command="{x:Static local:MainWindowCommands.About}"/>
      </MenuItem>
    </Menu>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
        <ComboBox x:Name="ThemePicker" Width="140" Height="28" Margin="0,0,8,0"
                  AutomationProperties.Name="Appearance theme"
                  SelectionChanged="ThemePicker_SelectionChanged"
                  VerticalAlignment="Center">
          <ComboBoxItem Content="Modern Light" Tag="Light"/>
          <ComboBoxItem Content="Modern Dark" Tag="Dark"/>
          <ComboBoxItem Content="Navy/Amber" Tag="NavyAmber"/>
          <ComboBoxItem Content="Cockpit Green" Tag="CockpitGreen"/>
        </ComboBox>
        <Button Content="Settings" Padding="10,4" Height="28" VerticalAlignment="Center"
                Click="ExecuteMainQuickAction" Tag="{x:Static local:MainWindowCommands.Settings}"/>
      </StackPanel>
      <DockPanel>
        <Image x:Name="FlightPatchBadge" DockPanel.Dock="Left" Source="{x:Static local:ApplicationBranding.Badge}"
               Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Top" AutomationProperties.Name="DCS-IPIA Flight Patch"/>
      <StackPanel>
        <TextBlock FontSize="26" FontWeight="Bold" Text="DCS-IPIA"/>
        <TextBlock x:Name="EditionStatus" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
        <TextBlock x:Name="ProfileIndicator" TextWrapping="Wrap" Margin="0,4,0,4"/>
        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Choose a module to work on"/>
      </StackPanel>
      </DockPanel>
    </DockPanel>
    <Border Grid.Row="1" Style="{DynamicResource Card}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{DynamicResource SectionTitle}" Text="Modules"/>
        <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,16"
                   Text="Create a module, open a saved module, or import module sources."/>
        <StackPanel Orientation="Horizontal">
          <ComboBox x:Name="SavedModules" MinWidth="300" HorizontalAlignment="Left"
                  DisplayMemberPath="DisplayName" AutomationProperties.Name="Saved module selection"
                  SelectionChanged="SavedModuleChanged"/>
          <Button x:Name="DeleteModuleButton" Content="Delete" Padding="16,9" Margin="8,0,0,0"
                  IsEnabled="False" Click="ExecuteMainQuickAction" Tag="{x:Static local:MainWindowCommands.DeleteModule}" AutomationProperties.Name="Delete selected module"
                  ToolTip="Delete the selected module and all of its saved data from the local database."/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button x:Name="NewModuleButton" Content="New module" Padding="16,9" Click="ExecuteMainQuickAction" Tag="{x:Static local:MainWindowCommands.NewModule}" Margin="0,0,8,0" AutomationProperties.Name="Create new module"/>
          <Button x:Name="OpenModuleButton" Content="Open module" Padding="16,9" Click="ExecuteMainQuickAction" Tag="{x:Static local:MainWindowCommands.OpenModule}" Margin="0,0,8,0"/>
          <Button x:Name="ImportButton" Content="Import module sources" Padding="16,9"
                  Click="ExecuteMainQuickAction" Tag="{x:Static local:MainWindowCommands.ImportModule}" ToolTip="Choose a module Git repository or a DCS Saved Games module/joystick folder."/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button x:Name="RestoreModuleSnapshotButton" Content="Restore module snapshot…" Click="ExecuteMainQuickAction" Tag="{x:Static local:MainWindowCommands.RestoreModule}" Padding="16,9" ToolTip="Restore a verified exported module into the database without replacing an existing module."/>
          <Button x:Name="ClearFlyNowButton" Content="Clear" Click="ExecuteMainQuickAction" Tag="{x:Static local:MainWindowCommands.ClearDeployment}" Padding="16,9" Margin="8,0,0,0" IsEnabled="False" AutomationProperties.Name="Clear active Fly Now deployment" ToolTip="Delete exactly the files copied by the active Fly Now deployment, including its UI Layer."/>
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Saved Games DCS Folder" Margin="0,16,0,4"/>
        <TextBlock x:Name="SavedGamesDestination" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="BrowseSavedGamesButton" Content="Browse…" Padding="16,9" Click="ExecuteMainQuickAction" Tag="{x:Static local:MainWindowCommands.Destination}" AutomationProperties.Name="Browse Saved Games DCS Folder"/>
          <Button x:Name="FlyNowButton" Content="Fly Now!" Padding="16,9" Margin="8,0,0,0" IsEnabled="False" Click="ExecuteMainQuickAction" Tag="{x:Static local:MainWindowCommands.FlyNow}" AutomationProperties.Name="Fly Now selected module"/>
        </StackPanel>
        <TextBlock x:Name="FlyNowStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="SharedDefaultsButton" Content="Shared default UI Layer" Click="ExecuteMainQuickAction" Tag="{x:Static local:MainWindowCommands.SharedDefaults}"
                HorizontalAlignment="Left" Padding="16,9" Margin="0,12,0,0"/>
      </StackPanel>
      </ScrollViewer>
    </Border>
    <Border Grid.Row="2" Background="{DynamicResource StatusBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
      <StackPanel>
        <TextBlock x:Name="ThemeSaveStatus" TextWrapping="Wrap" Foreground="{DynamicResource StatusTextBrush}"/>
        <TextBlock x:Name="ImportStatus" TextWrapping="Wrap" Foreground="{DynamicResource StatusTextBrush}"/>
      </StackPanel>
    </Border>
  </Grid>
  </DockPanel>
</Window>
