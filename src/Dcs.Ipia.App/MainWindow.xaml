<Window x:Class="DcsIpia.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCS-IPIA — Module workspace"
        Width="1280" Height="840" MinWidth="1024" MinHeight="700"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock FontSize="26" FontWeight="Bold" Text="DCS-IPIA"/>
        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Module workspace · interactive layout preview"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="ThemePicker" Width="105" Margin="0,0,12,0"
                  AutomationProperties.Name="Appearance theme"
                  SelectionChanged="ThemePicker_SelectionChanged">
          <ComboBoxItem Content="Light" Tag="Light"/>
          <ComboBoxItem Content="Dark" Tag="Dark"/>
        </ComboBox>
        <Button x:Name="ImportHueyButton" Content="Open Huey (read-only)" Padding="14,8" Margin="6,0"
                Click="ImportHuey_Click" ToolTip="Select committed Huey and DCS-Common Git checkouts." />
        <Button x:Name="ViewImportedButton" Content="View imported" IsEnabled="False" Padding="14,8" Margin="6,0"
                Click="ViewImported_Click" ToolTip="Review the last imported source data."/>
        <Button Content="Validate" IsEnabled="False" Padding="14,8" Margin="6,0"
                ToolTip="Available when module validation is connected."/>
        <Button Content="Build package" IsEnabled="False" Padding="14,8" Margin="6,0"
                ToolTip="Available after snapshot-only builds are verified."/>
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Style="{DynamicResource Card}">
      <DockPanel>
        <Border Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="6" Padding="10,5" DockPanel.Dock="Right">
          <TextBlock Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Text="DESIGN PREVIEW · sample data"/>
        </Border>
        <StackPanel>
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="UH-1H Huey"/>
          <TextBlock Style="{DynamicResource Hint}"
                     Text="Example module · input ID UH-1H · shared UI Layer from DCS-Common"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl Grid.Row="2" TabStripPlacement="Left" Background="Transparent"
                BorderThickness="0" ItemContainerStyle="{DynamicResource NavigationItem}"
                AutomationProperties.Name="Module workspace sections">
      <TabItem Header="Overview" IsSelected="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,0,0">
          <StackPanel>
            <TextBlock Style="{DynamicResource SectionTitle}" Text="One place for a module"/>
            <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,20"
                       Text="The example below shows the proposed route from DCS exports to a reviewed package. Navigation works; import and editing are intentionally disabled in this design preview."/>
            <Border Style="{DynamicResource Card}">
              <StackPanel>
                <TextBlock Style="{DynamicResource SectionTitle}" Text="1  Import and resolve"/>
                <TextBlock Style="{DynamicResource Hint}"
                           Text="Choose DCS exports. Review detected profiles, device instances, modifier chords and source provenance. Resolve ambiguous devices in a focused queue before accepting the import."/>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card}">
              <StackPanel>
                <TextBlock Style="{DynamicResource SectionTitle}" Text="2  Assign and preview"/>
                <TextBlock Style="{DynamicResource Hint}"
                           Text="Choose a device and instance, select a physical control, then search commands and choose a layer. A side inspector keeps the effective binding, draft change and validation message together."/>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card}">
              <StackPanel>
                <TextBlock Style="{DynamicResource SectionTitle}" Text="3  Validate and build"/>
                <TextBlock Style="{DynamicResource Hint}"
                           Text="Compare authored changes and generated outputs. Build from a validated immutable snapshot with a visible hash and package contents."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Assignments">
        <Grid Margin="20,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{DynamicResource Card}" Margin="0,0,16,0">
            <StackPanel>
              <TextBlock Style="{DynamicResource SectionTitle}" Text="Device assignments"/>
              <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,12"
                         Text="Example: TM MFD · instance MFD3 · Base layer"/>
              <WrapPanel Margin="0,0,0,16">
                <ComboBox Width="170" IsEnabled="False" AutomationProperties.Name="Device instance">
                  <ComboBoxItem Content="MFD3" IsSelected="True"/>
                </ComboBox>
                <ComboBox Width="170" Margin="12,0,0,0" IsEnabled="False"
                          AutomationProperties.Name="Modifier layer">
                  <ComboBoxItem Content="Base layer" IsSelected="True"/>
                </ComboBox>
              </WrapPanel>
              <Border BorderBrush="{DynamicResource CanvasBorderBrush}" BorderThickness="2" CornerRadius="12"
                      Background="{DynamicResource CanvasBackgroundBrush}" Padding="20" MinHeight="300">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <UniformGrid Grid.Row="0" Rows="1" Columns="5">
                    <Border Style="{DynamicResource SampleControl}"><TextBlock Text="OSB 1"/></Border>
                    <Border Style="{DynamicResource SampleControl}"><TextBlock Text="OSB 2"/></Border>
                    <Border Style="{DynamicResource SampleControl}"><TextBlock Text="OSB 3"/></Border>
                    <Border Style="{DynamicResource SampleControl}"><TextBlock Text="OSB 4"/></Border>
                    <Border Style="{DynamicResource SampleControl}"><TextBlock Text="OSB 5"/></Border>
                  </UniformGrid>
                  <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                             FontSize="17" Foreground="{DynamicResource SecondaryTextBrush}" Text="Controller graphic and callouts"/>
                  <UniformGrid Grid.Row="2" Rows="1" Columns="5">
                    <Border Style="{DynamicResource SampleControl}"><TextBlock Text="OSB 15"/></Border>
                    <Border Style="{DynamicResource SampleControl}"><TextBlock Text="OSB 14"/></Border>
                    <Border Style="{DynamicResource SampleControl}"><TextBlock Text="OSB 13"/></Border>
                    <Border Style="{DynamicResource SampleControl}"><TextBlock Text="OSB 12"/></Border>
                    <Border Style="{DynamicResource SampleControl}"><TextBlock Text="OSB 11"/></Border>
                  </UniformGrid>
                </Grid>
              </Border>
              <TextBlock Style="{DynamicResource Hint}" Margin="0,12,0,0"
                         Text="The production view will use shared hardware geometry. A searchable control list will mirror the graphic for keyboard and screen-reader users."/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Style="{DynamicResource Card}">
            <StackPanel>
              <TextBlock Style="{DynamicResource SectionTitle}" Text="Selected control"/>
              <TextBlock FontWeight="SemiBold" FontSize="16" Text="OSB 1 · MFD3"/>
              <TextBlock Style="{DynamicResource Hint}" Margin="0,6,0,18"
                         Text="Source and effective binding will appear here."/>
              <TextBlock Text="Command" FontWeight="SemiBold"/>
              <TextBox Text="Search DCS commands" IsReadOnly="True" IsEnabled="False"
                       Margin="0,6,0,14" AutomationProperties.Name="Command search"/>
              <TextBlock Text="Modifier chord" FontWeight="SemiBold"/>
              <TextBox Text="Base" IsReadOnly="True" IsEnabled="False" Margin="0,6,0,14"/>
              <TextBlock Text="Disposition" FontWeight="SemiBold"/>
              <TextBlock Style="{DynamicResource Hint}" Margin="0,6,0,18"
                         Text="Add · Replace · Remove · Restore"/>
              <Button Content="Stage change" IsEnabled="False" Padding="12,8"
                      ToolTip="Enabled after edit services and validation are connected."/>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="UI Layer">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,0,0">
          <StackPanel>
            <TextBlock Style="{DynamicResource SectionTitle}" Text="UI Layer in this module"/>
            <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,18"
                       Text="The shared DCS-Common template and this module's overlay are always shown with separate ownership."/>
            <Border Style="{DynamicResource Card}">
              <StackPanel>
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Shared template · read-only"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,8,0,0"
                           Text="Canonical functions, control mappings and modifiers imported from DCS-Common. A module edit never writes to this source."/>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card}">
              <StackPanel>
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="UH-1H overlay · module scope"/>
                <TextBlock Style="{DynamicResource Hint}" Margin="0,8,0,0"
                           Text="Add or remove module-only assignments here, then preview the effective result on the same device canvas. Other modules are unaffected."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Kneeboard">
        <Border Style="{DynamicResource Card}" Margin="20,0,0,0">
          <StackPanel>
            <TextBlock Style="{DynamicResource SectionTitle}" Text="Kneeboard preview"/>
            <TextBlock Style="{DynamicResource Hint}"
                       Text="Summary and device pages will appear beside the selected module assignments. Review before and after labels, layers and instance-specific controls."/>
          </StackPanel>
        </Border>
      </TabItem>

      <TabItem Header="Outputs">
        <Border Style="{DynamicResource Card}" Margin="20,0,0,0">
          <StackPanel>
            <TextBlock Style="{DynamicResource SectionTitle}" Text="Review before building"/>
            <TextBlock Style="{DynamicResource Hint}"
                       Text="Validation findings, authored changes, snapshot identity, generated Markdown and package contents will be reviewed here before building from an immutable snapshot."/>
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" Background="{DynamicResource StatusBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
      <StackPanel>
        <TextBlock x:Name="ThemeSaveStatus" TextWrapping="Wrap" Foreground="{DynamicResource StatusTextBrush}"/>
        <TextBlock x:Name="ImportStatus" TextWrapping="Wrap" Foreground="{DynamicResource StatusTextBrush}"/>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource StatusTextBrush}"
                 Text="This workspace layout shows sample data. Open Huey (read-only) to inspect committed sources. Edit and build actions remain unavailable."/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
