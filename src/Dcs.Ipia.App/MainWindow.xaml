<Window x:Class="DcsIpia.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCS-IPIA — Module workspace"
        Width="1280" Height="840" MinWidth="1024" MinHeight="700"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock FontSize="26" FontWeight="Bold" Text="DCS-IPIA"/>
        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Module workspace · canonical device assignment editor"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="ThemePicker" Width="105" Margin="0,0,12,0"
                  AutomationProperties.Name="Appearance theme"
                  SelectionChanged="ThemePicker_SelectionChanged">
          <ComboBoxItem Content="Light" Tag="Light"/>
          <ComboBoxItem Content="Dark" Tag="Dark"/>
        </ComboBox>
        <Button Content="Settings" Padding="14,8" Margin="0,0,6,0"
                Click="Settings_Click" ToolTip="Theme and occupied-destination behavior."/>
        <Button x:Name="ImportHueyButton" Content="Import module sources" Padding="14,8" Margin="6,0"
                Click="ImportHuey_Click" ToolTip="Choose a module Git repository or a DCS Saved Games module/joystick folder." />
        <ComboBox x:Name="SavedModules" Width="180" Margin="6,0" VerticalAlignment="Center" DisplayMemberPath="DisplayName" AutomationProperties.Name="Saved module selection" SelectionChanged="SavedModuleChanged"/>
        <Button Content="Open saved module" Padding="14,8" Margin="6,0" Click="OpenSaved_Click"
                ToolTip="Open editor graphics, catalogs and assignments from the local SQLite database."/>
        <Button x:Name="ViewImportedButton" Content="Open assignment editor" IsEnabled="False" Padding="14,8" Margin="6,0"
                Click="ViewImported_Click" ToolTip="Review the last imported source data."/>
        <Button Content="Validate" IsEnabled="False" Padding="14,8" Margin="6,0"
                ToolTip="Available when module validation is connected."/>
        <Button Content="Build package" IsEnabled="False" Padding="14,8" Margin="6,0"
                ToolTip="Available after snapshot-only builds are verified."/>
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Style="{DynamicResource Card}">
      <DockPanel>
        <Border Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="6" Padding="10,5" DockPanel.Dock="Right">
          <TextBlock Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Text="DESIGN PREVIEW · sample data"/>
        </Border>
        <StackPanel>
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Saved module workspace"/>
          <TextBlock Style="{DynamicResource Hint}"
                     Text="Choose a stored module or import a module to edit its device assignments."/>
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl Grid.Row="2" TabStripPlacement="Left" Background="Transparent"
                BorderThickness="0" ItemContainerStyle="{DynamicResource NavigationItem}"
                AutomationProperties.Name="Module workspace sections">
      <TabItem Header="Overview" IsSelected="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,0,0,0">
          <StackPanel>
            <TextBlock Style="{DynamicResource SectionTitle}" Text="One place for a module"/>
            <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,20"
                       Text="The example below shows the route from DCS exports to a reviewed package. Import committed module and DCS-Common sources to open the graphical assignment editor; Save to database persists assignments."/>
            <Border Style="{DynamicResource Card}">
              <StackPanel>
                <TextBlock Style="{DynamicResource SectionTitle}" Text="1  Import and resolve"/>
                <TextBlock Style="{DynamicResource Hint}"
                           Text="Choose DCS exports. Review detected profiles, device instances, modifier chords and source provenance. Resolve ambiguous devices in a focused queue before accepting the import."/>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card}">
              <StackPanel>
                <TextBlock Style="{DynamicResource SectionTitle}" Text="2  Assign and preview"/>
                <TextBlock Style="{DynamicResource Hint}"
                           Text="Choose a device and instance, select a physical control, then search commands and choose a layer. A side inspector keeps the effective binding, draft change and validation message together."/>
              </StackPanel>
            </Border>
            <Border Style="{DynamicResource Card}">
              <StackPanel>
                <TextBlock Style="{DynamicResource SectionTitle}" Text="3  Validate and build"/>
                <TextBlock Style="{DynamicResource Hint}"
                           Text="Compare authored changes and generated outputs. Build from a validated immutable snapshot with a visible hash and package contents."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Assignments">
        <Border Style="{DynamicResource Card}" Margin="20,0,0,0">
          <StackPanel>
            <TextBlock Style="{DynamicResource SectionTitle}" Text="Assignment editor"/>
            <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,16" TextWrapping="Wrap"
                       Text="Open committed module and DCS-Common sources to see the real device image and draw.io-generated SVG callouts. Search module or UI Layer commands, then drag, right-click, or use the inspector to stage assignments."/>
            <Button Content="Open assignment editor" Click="OpenEditor_Click" Padding="15,9"
                    HorizontalAlignment="Left" AutomationProperties.Name="Open real assignment editor"/>
            <TextBlock Style="{DynamicResource Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                       Text="The editor keeps changes in memory with undo and review. Save to database persists module assignments without changing source repositories."/>
          </StackPanel>
        </Border>
      </TabItem>

      <TabItem Header="UI Layer">
        <Border Style="{DynamicResource Card}" Margin="20,0,0,0">
          <StackPanel>
            <TextBlock Style="{DynamicResource SectionTitle}" Text="UI Layer · this module"/>
            <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,16" TextWrapping="Wrap"
                       Text="Open the same graphical editor and choose UI Layer commands. The DCS-Common SVG and function catalog are shared; staged assignments belong only to the selected module."/>
            <Button Content="Open UI Layer editor" Click="OpenEditor_Click" Padding="15,9"
                    HorizontalAlignment="Left" AutomationProperties.Name="Open graphical UI Layer editor"/>
          </StackPanel>
        </Border>
      </TabItem>

      <TabItem Header="Kneeboard">
        <Border Style="{DynamicResource Card}" Margin="20,0,0,0">
          <StackPanel>
            <TextBlock Style="{DynamicResource SectionTitle}" Text="Kneeboard preview"/>
            <TextBlock Style="{DynamicResource Hint}"
                       Text="Summary and device pages will appear beside the selected module assignments. Review before and after labels, layers and instance-specific controls."/>
          </StackPanel>
        </Border>
      </TabItem>

      <TabItem Header="Outputs">
        <Border Style="{DynamicResource Card}" Margin="20,0,0,0">
          <StackPanel>
            <TextBlock Style="{DynamicResource SectionTitle}" Text="Review before building"/>
            <TextBlock Style="{DynamicResource Hint}"
                       Text="Validation findings, authored changes, snapshot identity, generated Markdown and package contents will be reviewed here before building from an immutable snapshot."/>
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" Background="{DynamicResource StatusBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
      <StackPanel>
        <TextBlock x:Name="ThemeSaveStatus" TextWrapping="Wrap" Foreground="{DynamicResource StatusTextBrush}"/>
        <TextBlock x:Name="ImportStatus" TextWrapping="Wrap" Foreground="{DynamicResource StatusTextBrush}"/>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource StatusTextBrush}"
                 Text="Select a saved module to reopen its stored editor. Repository import reads committed source and writes the resulting workspace to SQLite."/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
