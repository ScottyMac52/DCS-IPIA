<Window x:Class="DcsIpia.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DCS-IPIA — Modules"
        Width="780" Height="620" MinWidth="620" MinHeight="450"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="ThemePicker" Width="105" Margin="0,0,12,0"
                  AutomationProperties.Name="Appearance theme"
                  SelectionChanged="ThemePicker_SelectionChanged">
          <ComboBoxItem Content="Light" Tag="Light"/>
          <ComboBoxItem Content="Dark" Tag="Dark"/>
        </ComboBox>
        <Button Content="Settings" Padding="14,8" Click="Settings_Click"/>
      </StackPanel>
      <StackPanel>
        <TextBlock FontSize="26" FontWeight="Bold" Text="DCS-IPIA"/>
        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Choose a module to work on"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Style="{DynamicResource Card}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Style="{DynamicResource SectionTitle}" Text="Modules"/>
        <TextBlock Style="{DynamicResource Hint}" Margin="0,0,0,16"
                   Text="Create a module, open a saved module, or import module sources."/>
        <StackPanel Orientation="Horizontal">
          <ComboBox x:Name="SavedModules" MinWidth="300" HorizontalAlignment="Left"
                  DisplayMemberPath="DisplayName" AutomationProperties.Name="Saved module selection"
                  SelectionChanged="SavedModuleChanged"/>
          <Button x:Name="DeleteModuleButton" Content="Delete" Padding="16,9" Margin="8,0,0,0"
                  IsEnabled="False" Click="DeleteModule_Click" AutomationProperties.Name="Delete selected module"
                  ToolTip="Delete the selected module and all of its saved data from the local database."/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button x:Name="NewModuleButton" Content="New module" Padding="16,9" Click="NewModule_Click" Margin="0,0,8,0" AutomationProperties.Name="Create new module"/>
          <Button x:Name="OpenModuleButton" Content="Open module" Padding="16,9" Click="OpenSaved_Click" Margin="0,0,8,0"/>
          <Button x:Name="ImportButton" Content="Import module sources" Padding="16,9"
                  Click="ImportModule_Click" ToolTip="Choose a module Git repository or a DCS Saved Games module/joystick folder."/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button x:Name="RestoreModuleSnapshotButton" Content="Restore module snapshot…" Click="RestoreModuleSnapshotClicked" Padding="16,9" ToolTip="Restore a verified exported module into the database without replacing an existing module."/>
          <Button x:Name="ClearFlyNowButton" Content="Clear" Click="ClearFlyNowClicked" Padding="16,9" Margin="8,0,0,0" IsEnabled="False" AutomationProperties.Name="Clear active Fly Now deployment" ToolTip="Delete exactly the files copied by the active Fly Now deployment, including its UI Layer."/>
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Saved Games DCS Folder" Margin="0,16,0,4"/>
        <TextBlock x:Name="SavedGamesDestination" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="BrowseSavedGamesButton" Content="Browse…" Padding="16,9" Click="BrowseSavedGamesClicked" AutomationProperties.Name="Browse Saved Games DCS Folder"/>
          <Button x:Name="FlyNowButton" Content="Fly Now!" Padding="16,9" Margin="8,0,0,0" IsEnabled="False" Click="FlyNowClicked" AutomationProperties.Name="Fly Now selected module"/>
        </StackPanel>
        <TextBlock x:Name="FlyNowStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="SharedDefaultsButton" Content="Shared default UI Layer" Click="SharedDefaults_Click"
                HorizontalAlignment="Left" Padding="16,9" Margin="0,12,0,0"/>
      </StackPanel>
      </ScrollViewer>
    </Border>
    <Border Grid.Row="2" Background="{DynamicResource StatusBackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
      <StackPanel>
        <TextBlock x:Name="ThemeSaveStatus" TextWrapping="Wrap" Foreground="{DynamicResource StatusTextBrush}"/>
        <TextBlock x:Name="ImportStatus" TextWrapping="Wrap" Foreground="{DynamicResource StatusTextBrush}"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
