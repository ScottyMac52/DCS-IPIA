<Window x:Class="DcsIpia.Presentation.AxisTuningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tune axis" Width="440" Height="650" MinWidth="380" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" Foreground="DarkRed" Margin="0,0,0,8"/>
      <WrapPanel HorizontalAlignment="Right">
        <Button Content="Clear tuning" Click="ClearClicked" Padding="12,6" Margin="0,0,8,0"/>
        <Button Content="Cancel" IsCancel="True" Padding="12,6" Margin="0,0,8,0"/>
        <Button Content="Apply to draft" Click="ApplyClicked" Padding="12,6"/>
      </WrapPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="DCS axis filter" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Leave numeric fields blank to omit them. Checkboxes can be checked, unchecked, or unset. Changes remain pending until Save to database."
                   TextWrapping="Wrap" Margin="0,6,0,14"/>
        <TextBlock Text="Deadzone"/><TextBox x:Name="Deadzone" Margin="0,3,0,10"/>
        <TextBlock Text="Saturation X"/><TextBox x:Name="SaturationX" Margin="0,3,0,10"/>
        <TextBlock Text="Saturation Y"/><TextBox x:Name="SaturationY" Margin="0,3,0,10"/>
        <TextBlock Text="Curvature (comma-separated numbers)"/><TextBox x:Name="Curvature" Margin="0,3,0,10"/>
        <CheckBox x:Name="Invert" Content="Invert" IsThreeState="True" Margin="0,4"/>
        <CheckBox x:Name="Slider" Content="Slider" IsThreeState="True" Margin="0,4"/>
        <CheckBox x:Name="HardwareDetent" Content="Hardware detent" IsThreeState="True" Margin="0,4,0,10"/>
        <TextBlock Text="Hardware detent AB"/><TextBox x:Name="HardwareDetentAB" Margin="0,3,0,10"/>
        <TextBlock Text="Hardware detent maximum"/><TextBox x:Name="HardwareDetentMax" Margin="0,3,0,10"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
