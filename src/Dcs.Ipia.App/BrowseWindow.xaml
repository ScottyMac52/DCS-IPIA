<Window x:Class="DcsIpia.Presentation.BrowseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="620" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top">
      <WrapPanel x:Name="Places" Margin="0,0,0,10"/>
      <DockPanel Margin="0,0,0,10">
        <Button Content="_Up" Click="UpClicked" DockPanel.Dock="Left" Margin="0,0,8,0"/>
        <Button Content="_Go" Click="GoClicked" DockPanel.Dock="Right" Margin="8,0,0,0"/>
        <Button Content="_Refresh" Click="RefreshClicked" DockPanel.Dock="Right" Margin="8,0,0,0"/>
        <TextBox x:Name="Location" KeyDown="LocationKeyDown" AutomationProperties.Name="Folder location"/>
      </DockPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
      <DockPanel Margin="0,0,0,8">
        <TextBlock x:Name="NameLabel" Text="File name:" VerticalAlignment="Center" Width="85"/>
        <TextBox x:Name="SelectionName" KeyDown="NameKeyDown" AutomationProperties.Name="File or folder name"/>
      </DockPanel>
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="12,0,0,0">
          <Button x:Name="AcceptSelection" Content="_Open" IsDefault="True" Click="AcceptClicked" MinWidth="90" Margin="0,0,8,0"/>
          <Button x:Name="CancelSelection" Content="_Cancel" IsCancel="True" MinWidth="90"/>
        </StackPanel>
        <Button x:Name="NewFolder" Content="New _folder" Click="NewFolderClicked" DockPanel.Dock="Left" Margin="0,0,8,0"/>
        <ComboBox x:Name="FileTypes" SelectionChanged="FilterChanged" AutomationProperties.Name="File type filter"/>
      </DockPanel>
    </StackPanel>
    <DataGrid x:Name="Entries" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              SelectionUnit="FullRow" SelectionChanged="EntrySelected" MouseDoubleClick="EntryDoubleClicked"
              KeyDown="EntryKeyDown" AutomationProperties.Name="Files and folders">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="100"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
