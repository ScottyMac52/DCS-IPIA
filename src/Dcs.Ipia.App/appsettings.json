{
  "SchemaVersion": 1,
  "Theme": "Light",
  "OccupiedDestinationBehavior": "Ask",
  "SavedGamesDcsFolder": "",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "Dcs.Ipia.App": "Error",
        "Dcs.Ipia.Application": "Error",
        "Dcs.Ipia.Dcs": "Error",
        "Dcs.Ipia.Domain": "Error",
        "Dcs.Ipia.Infrastructure": "Error",
        "Dcs.Ipia.Packaging": "Error",
        "Dcs.Ipia.Rendering": "Error",
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%LOCALAPPDATA%/DCS-IPIA/Logs/ipia-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  }
}
