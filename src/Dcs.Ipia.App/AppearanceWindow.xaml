<Window x:Class="DcsIpia.Presentation.AppearanceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DCS-IPIA — Appearance preview" Width="900" Height="740" MinWidth="740" MinHeight="560"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
   <TextBlock Text="Customize appearance" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock Text="Preview changes across open windows. Apply saves; Cancel restores your previous appearance." TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="CancelAppearance" Content="Cancel" IsCancel="True" Click="CancelClicked" Margin="8,0,0,0" Padding="16,8"/>
    <Button x:Name="ApplyAppearance" Content="Apply" IsDefault="True" Click="ApplyClicked" Margin="8,0,0,0" Padding="16,8"/>
   </StackPanel>
   <TextBlock x:Name="AppearanceStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{DynamicResource Card}" Margin="0,0,16,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Background image" FontSize="18" FontWeight="SemiBold"/>
    <WrapPanel Margin="0,8,0,8">
     <Button Content="Choose JPG / PNG…" Click="ChooseImageClicked" Padding="10,6"/>
     <Button Content="Remove image" Click="RemoveImageClicked" Padding="10,6" Margin="8,0,0,0"/>
    </WrapPanel>
    <TextBlock x:Name="ImageStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <CheckBox x:Name="BackgroundEnabled" Content="Enable background" Checked="AdjustmentChanged" Unchecked="AdjustmentChanged"/>
    <TextBlock Text="Image opacity (0–30%)" Margin="0,12,0,0"/>
    <Slider x:Name="ImageOpacity" Minimum="0" Maximum="0.3" TickFrequency="0.01" IsSnapToTickEnabled="True" SmallChange="0.01" LargeChange="0.05" ValueChanged="SliderChanged" AutomationProperties.Name="Background opacity"/>
    <TextBlock Text="{Binding ElementName=ImageOpacity, Path=Value, StringFormat={}{0:P0}}"/>
    <TextBlock Text="Theme blending" Margin="0,8,0,0"/>
    <Slider x:Name="ImageTint" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" ValueChanged="SliderChanged" AutomationProperties.Name="Background theme blending"/>
    <TextBlock Text="Panel opacity (0–100%)" Margin="0,8,0,0"/>
    <Slider x:Name="PanelOpacity" Minimum="0" Maximum="1" TickFrequency="0.01" IsSnapToTickEnabled="True" SmallChange="0.01" LargeChange="0.05" ValueChanged="SliderChanged" AutomationProperties.Name="Panel opacity"/>
    <TextBlock Text="{Binding ElementName=PanelOpacity, Path=Value, StringFormat={}{0:P0}}"/>
    <TextBlock Text="Image layout" Margin="0,8,0,4"/>
    <ComboBox x:Name="ImageFit" SelectionChanged="FitChanged" AutomationProperties.Name="Image layout">
     <ComboBoxItem Content="Fill — crop proportionally" Tag="Fill"/><ComboBoxItem Content="Fit — show whole image" Tag="Fit"/>
    </ComboBox>
    <TextBlock Text="Horizontal position (left → right)" Margin="0,8,0,0"/>
    <Slider x:Name="CropX" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" ValueChanged="SliderChanged" AutomationProperties.Name="Horizontal image position"/>
    <TextBlock Text="Vertical position (top → bottom)" Margin="0,8,0,0"/>
    <Slider x:Name="CropY" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" ValueChanged="SliderChanged" AutomationProperties.Name="Vertical image position"/>
    <TextBlock Text="Accent and palette" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,8"/>
    <TextBlock Text="Accent #RRGGBB (blank uses skin default)" TextWrapping="Wrap"/>
    <TextBox x:Name="AccentColor" TextChanged="AccentChanged" Margin="0,4,0,8" AutomationProperties.Name="Accent color"/>
    <WrapPanel><Button Content="Import palette JSON…" Click="ImportPaletteClicked" Padding="10,6"/>
     <Button Content="Use skin palette" Click="ClearPaletteClicked" Padding="10,6" Margin="8,0,0,0"/>
    </WrapPanel>
    <TextBlock x:Name="PaletteStatus" TextWrapping="Wrap" Margin="0,8,0,12"/>
    <Button Content="Clear customization" Click="ResetClicked" HorizontalAlignment="Left" Padding="10,6"/>
   </StackPanel></ScrollViewer></Border>
   <StackPanel Grid.Column="1">
    <TextBlock Text="Live preview" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <Border Style="{DynamicResource Card}"><StackPanel>
     <TextBlock Text="Flight controls" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="Text, selections and controls stay readable while the background changes." TextWrapping="Wrap" Margin="0,8,0,16"/>
     <TextBlock Text="Aircraft profile"/><TextBox Text="F-14B — Carrier operations" Margin="0,6,0,12"/>
     <CheckBox Content="Enable controller input" IsChecked="True" Margin="0,0,0,12"/>
     <ListBox Height="90" SelectedIndex="0"><ListBoxItem Content="Joystick — pitch and roll"/><ListBoxItem Content="Throttle — engine power"/></ListBox>
     <WrapPanel Margin="0,12,0,0"><Button Content="Sample action" Padding="12,8"/><Button Content="Unavailable" IsEnabled="False" Padding="12,8" Margin="8,0,0,0"/></WrapPanel>
    </StackPanel></Border>
    <TextBlock Text="The whole application is previewing these changes. Readability protection may soften the photograph or increase panel opacity. Decorative backgrounds are suppressed in Windows high contrast." TextWrapping="Wrap" Margin="0,16,0,0"/>
    <TextBlock Text="To change the base skin, close this editor and use the UI skin selector in Settings. Restore default appearance clears customization and returns to Modern Light." TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel>
  </Grid>
 </DockPanel>
</Window>
