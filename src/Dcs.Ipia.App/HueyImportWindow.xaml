<Window x:Class="DcsIpia.Presentation.HueyImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="1380" Height="840"
        MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <Window.Resources>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="{Binding Summary}" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Commit}" Margin="0,6,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
      <TextBlock Text="{Binding SourceNote}" Margin="0,3,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
    </StackPanel>
    <TabControl x:Name="ImportedTabs" Grid.Row="1" TabStripPlacement="Left" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" ItemContainerStyle="{DynamicResource NavigationItem}"
                AutomationProperties.Name="Imported Huey data">
      <TabItem Header="Profiles">
        <ListBox ItemsSource="{Binding Profiles}" AutomationProperties.Name="Imported device profiles"/>
      </TabItem>
      <TabItem Header="Bindings">
        <ListBox ItemsSource="{Binding Bindings}" AutomationProperties.Name="Imported aircraft bindings"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </TabItem>
      <TabItem Header="Kneeboard">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ListBox x:Name="KneeboardList" Grid.Column="0" ItemsSource="{Binding Pages}"
                   SelectionChanged="KneeboardList_SelectionChanged"
                   AutomationProperties.Name="Kneeboard page selector"/>
          <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource CanvasBackgroundBrush}" BorderThickness="1">
              <Image x:Name="KneeboardPreview" Stretch="Uniform"
                     AutomationProperties.Name="Existing rendered kneeboard PNG"/>
            </Border>
            <TextBlock x:Name="KneeboardCaption" Grid.Row="1" Margin="0,8,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Assignment editor">
        <StackPanel Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
          <TextBlock Text="DCS-Common scaffolding editor" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,16"/>
          <TextBlock TextWrapping="Wrap" FontSize="16" Margin="0,0,0,18"
                     Text="Open the original DCS-Common scaffolding workspace for module devices, module UI Layer devices, and shared UI Layer devices. Its graphical editor has the original command catalog, callouts, and drag-and-drop behavior."/>
          <Button Content="Open DCS-Common scaffolding…" Click="OpenOriginalScaffold_Click" FontSize="16" Padding="18,10" HorizontalAlignment="Left"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Previous editor" Visibility="Collapsed">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="DeviceTitle" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="Instructions" Margin="0,4" TextWrapping="Wrap"
                       Text="Drag a module command onto a callout, or select a callout to assign, clear, restore, or relabel it."/>
            <WrapPanel>
              <TextBlock Text="Device:" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="UiDiagramList" ItemsSource="{Binding UiDiagrams}" DisplayMemberPath="Title"
                        SelectionChanged="UiDiagramList_SelectionChanged" MinWidth="180"
                        AutomationProperties.Name="Device and instance selector"/>
              <TextBlock Text="Modifier layer:" VerticalAlignment="Center" Margin="12,0,8,0"/>
              <ComboBox x:Name="UiModifierChoice" MinWidth="180"
                        SelectionChanged="UiModifierChoice_SelectionChanged" AutomationProperties.Name="Modifier chord"/>
              <Button Content="New chord…" Click="ChooseChord_Click" Margin="8,0,0,0" Padding="10,4"/>
              <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="16,0,6,0"/>
              <Slider x:Name="EditorZoom" Minimum="0.5" Maximum="3" Value="1" Width="140"
                      ValueChanged="EditorZoom_ValueChanged"/>
              <Button Content="Rendered kneeboard…" Click="RenderKneeboard_Click" Margin="16,0,0,0" Padding="10,4"/>
            </WrapPanel>
          </StackPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Back" Padding="20,6" Click="Back_Click"/>
            <StackPanel>
              <TextBlock x:Name="EditorStatus" TextWrapping="Wrap"/>
              <TextBlock Text="White: unchanged   Green: new   Yellow: replaced   Red: conflict   Gray: unassigned" Margin="0,4"/>
              <TextBlock x:Name="DraftCount" FontWeight="SemiBold"/>
            </StackPanel>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="300"/>
              <ColumnDefinition Width="*" MinWidth="350"/>
              <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Command catalog" Padding="6">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                  <WrapPanel>
                    <Button Content="Import catalog…" Click="ImportCatalog_Click" Padding="8,4"/>
                    <Button Content="Load DCS HTML…" Click="LoadDcsHtml_Click" Padding="8,4" Margin="6,0,0,0"/>
                    <Button Content="Save catalog…" Click="SaveCatalog_Click" Padding="8,4" Margin="6,0,0,0"/>
                  </WrapPanel>
                  <ComboBox x:Name="PaletteScope" Margin="0,8,0,4"
                            SelectionChanged="PaletteScope_SelectionChanged" AutomationProperties.Name="Command scope">
                    <ComboBoxItem Content="Module controls"/>
                    <ComboBoxItem Content="Module UI Layer"/>
                  </ComboBox>
                  <TextBox x:Name="PaletteSearch" TextChanged="PaletteSearch_TextChanged"
                           ToolTip="Search command, category, key or alias" Margin="0,4"/>
                  <TextBlock Text="Category"/>
                  <ComboBox x:Name="PaletteCategory" SelectionChanged="PaletteCategory_SelectionChanged"
                            AutomationProperties.Name="Filter commands by named category"/>
                  <TextBlock Text="Type" Margin="0,4,0,0"/>
                  <ComboBox x:Name="PaletteType" SelectionChanged="PaletteFilter_SelectionChanged">
                    <ComboBoxItem Content="All"/><ComboBoxItem Content="Key"/><ComboBoxItem Content="Axis"/>
                  </ComboBox>
                  <TextBlock Text="Availability" Margin="0,4,0,0"/>
                  <ComboBox x:Name="PaletteAvailability" SelectionChanged="PaletteFilter_SelectionChanged">
                    <ComboBoxItem Content="All"/><ComboBoxItem Content="Assignable"/>
                  </ComboBox>
                  <TextBlock Text="Binding state" Margin="0,4,0,0"/>
                  <ComboBox x:Name="PaletteBindingState" SelectionChanged="PaletteFilter_SelectionChanged">
                    <ComboBoxItem Content="All"/><ComboBoxItem Content="Assigned"/><ComboBoxItem Content="Unassigned"/>
                  </ComboBox>
                  <TextBlock x:Name="PaletteCaption" Margin="0,6" TextWrapping="Wrap"/>
                </StackPanel>
                <ListBox x:Name="CommandPaletteList" PreviewMouseLeftButtonDown="DragStart"
                         PreviewMouseMove="CommandDrag" AutomationProperties.Name="Drag a catalog command onto a device callout">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="2,4">
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Category}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="Assignable" FontSize="11"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </GroupBox>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Margin="8,0" Background="{DynamicResource CanvasBackgroundBrush}">
              <Canvas x:Name="UiDiagramCanvas" HorizontalAlignment="Left" VerticalAlignment="Top"
                      AllowDrop="True" DragOver="UiDiagramCanvas_DragOver" Drop="UiDiagramCanvas_Drop"
                      AutomationProperties.Name="Draw.io-generated device SVG with assignment labels"/>
            </ScrollViewer>
            <ListBox x:Name="UiAssignmentList" Visibility="Collapsed" SelectionChanged="UiAssignmentList_SelectionChanged"/>
            <TextBlock x:Name="UiDiagramCaption" Visibility="Collapsed"/>
            <GroupBox Grid.Column="2" Header="Selected control" Padding="10">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock x:Name="SelectedControlTitle" Text="Select a callout" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="SelectedChord" Margin="0,6" TextWrapping="Wrap"/>
                  <Button Content="Choose assignment chord…" Click="ChooseChord_Click" Margin="0,0,0,10" Padding="8,5"/>
                  <TextBlock Text="Current command" FontWeight="SemiBold"/>
                  <TextBlock x:Name="CurrentCommand" TextWrapping="Wrap" Margin="0,2,0,10"/>
                  <TextBlock Text="Pending command" FontWeight="SemiBold"/>
                  <TextBlock x:Name="PendingCommand" TextWrapping="Wrap" Margin="0,2,0,10"/>
                  <TextBlock Text="DCS default label" FontWeight="SemiBold"/>
                  <TextBlock x:Name="DefaultLabel" TextWrapping="Wrap" Margin="0,2,0,10"/>
                  <TextBlock Text="Displayed label" FontWeight="SemiBold"/>
                  <TextBox x:Name="LabelEditor" TextChanged="LabelEditor_TextChanged" IsEnabled="False"
                           Margin="0,4,0,8" TextWrapping="Wrap"/>
                  <TextBlock Text="Axis tuning" FontWeight="SemiBold"/>
                  <TextBlock x:Name="AxisTuningSummary" TextWrapping="Wrap" Margin="0,2,0,6"/>
                  <Button x:Name="TuneAxisButton" Content="Tune axis…" Click="TuneAxis_Click" Margin="0,4" Padding="8,5" IsEnabled="False"/>
                  <Button x:Name="AssignSelectedCommand" Content="Assign selected command" Click="Assign_Click" Margin="0,4" Padding="8,5"/>
                  <Button Content="Clear assignment" Click="Remove_Click" Margin="0,4" Padding="8,5"/>
                  <Button Content="Undo assignment / Restore" Click="Restore_Click" Margin="0,4" Padding="8,5"/>
                  <Button Content="Reset label to DCS default" Click="ResetLabel_Click" Margin="0,4" Padding="8,5"/>
                  <TextBlock Text="Drag an assigned callout onto another compatible callout to move its command."
                             TextWrapping="Wrap" Margin="0,16,0,0"/>
                  <Button Content="Edit shared UI Layer catalog…" Click="OpenSharedUiLayer_Click" Margin="0,12,0,0"/>
                  <Button Content="Settings" Click="EditorSettings_Click" Margin="0,12,0,0"/>
                  <Button x:Name="UndoDraft" Content="Undo" Click="Undo_Click" Margin="0,4"/>
                  <Button Content="Discard draft" Click="Discard_Click" Margin="0,4"/>
                  <ListBox x:Name="DraftReviewList" Visibility="Collapsed"/>
                  <TextBlock x:Name="SelectedAssignment" Visibility="Collapsed"/>
                </StackPanel>
              </ScrollViewer>
            </GroupBox>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem x:Name="DiagnosticsTab" Header="Diagnostics">
        <ListBox ItemsSource="{Binding Diagnostics}" AutomationProperties.Name="Import diagnostics"/>
      </TabItem>
      <TabItem Header="Sources">
        <ListBox ItemsSource="{Binding Provenance}" AutomationProperties.Name="Committed source hashes"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Text="Draft only · no changes are written to either repository."
                 VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <Button Content="Close" DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="90"
              Padding="12,7" Click="Close_Click"/>
    </DockPanel>
  </Grid>
</Window>
