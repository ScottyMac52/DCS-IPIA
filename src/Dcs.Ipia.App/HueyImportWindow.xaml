<Window x:Class="DcsIpia.Presentation.HueyImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="1480" Height="900"
        MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterOwner"
        PreviewMouseLeftButtonUp="Editor_PreviewMouseLeftButtonUp"
        PreviewMouseMove="Editor_PreviewMouseMove"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <Window.Resources>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,8">
      <TextBlock Text="{Binding Summary}" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Commit}" Margin="0,3,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
      <TextBlock Text="{Binding SourceNote}" Margin="0,3,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
    </StackPanel>
    <TabControl x:Name="ImportedTabs" Grid.Row="1" TabStripPlacement="Top" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                AutomationProperties.Name="Imported Huey data">
      <TabItem Header="Module controls">
        <Grid Margin="2,8,2,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="EditorHeading" Text="Module controls" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="Drag a command onto a callout, or drag an assigned callout to another. Select a callout to assign, clear or restore."
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,3,0,8"/>
            <WrapPanel>
              <TextBlock Text="Command scope" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <ComboBox x:Name="PaletteScope" Width="160" Margin="0,0,12,0"
                        SelectionChanged="PaletteScope_SelectionChanged" AutomationProperties.Name="Command scope">
                <ComboBoxItem Content="Module commands"/>
                <ComboBoxItem Content="UI Layer commands"/>
              </ComboBox>
              <TextBlock Text="Device / instance" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <ComboBox x:Name="UiDiagramList" Width="210" Margin="0,0,12,0"
                        ItemsSource="{Binding UiDiagrams}" DisplayMemberPath="Title"
                        SelectionChanged="UiDiagramList_SelectionChanged"
                        AutomationProperties.Name="Device and instance selector"/>
              <TextBlock Text="Modifier layer" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <ComboBox x:Name="UiModifierChoice" Width="145" Margin="0,0,14,0"
                        SelectionChanged="UiModifierChoice_SelectionChanged" AutomationProperties.Name="Modifier chord"/>
              <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <Slider x:Name="DiagramZoom" Width="115" Minimum="0.5" Maximum="2" Value="1"
                      TickFrequency="0.25" IsSnapToTickEnabled="True"
                      AutomationProperties.Name="Device graphic zoom"/>
              <Button Content="Rendered kneeboard…" Margin="14,0,0,0" Padding="10,4"
                      Click="OpenKneeboard_Click"/>
            </WrapPanel>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="300"/>
              <ColumnDefinition Width="*" MinWidth="350"/>
              <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Command catalog" Margin="0,0,10,0">
              <Grid Margin="6">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                  <WrapPanel Margin="0,0,0,8">
                    <Button Content="Import catalog…" Click="LoadModuleCatalog_Click" Margin="0,0,6,4"
                            ToolTip="Import a module command catalog JSON saved by DCS-Common scaffolding."
                            AutomationProperties.Name="Import DCS module command catalog JSON"/>
                    <Button Content="Load DCS HTML…" Click="LoadDcsHtml_Click" Margin="0,0,0,4"
                            ToolTip="Import one or more HTML files generated by DCS Controls."
                            AutomationProperties.Name="Load DCS Controls HTML command catalog"/>
                  </WrapPanel>
                  <TextBox x:Name="PaletteSearch" TextChanged="PaletteSearch_TextChanged"
                           AutomationProperties.Name="Search commands"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
                  <TextBlock Text="Category"/>
                  <ComboBox x:Name="PaletteCategory" Margin="0,3,0,8"
                            SelectionChanged="PaletteCategory_SelectionChanged"
                            AutomationProperties.Name="Filter commands by category"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                  <TextBlock Text="Type"/>
                  <ComboBox x:Name="PaletteType" SelectedIndex="0" Margin="0,3,0,8"
                            SelectionChanged="PaletteFilter_SelectionChanged"
                            AutomationProperties.Name="Filter commands by type">
                    <ComboBoxItem Content="All"/><ComboBoxItem Content="Buttons"/>
                    <ComboBoxItem Content="Axes"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="3">
                  <TextBlock Text="Availability"/>
                  <ComboBox x:Name="PaletteAvailability" SelectedIndex="0" Margin="0,3,0,8"
                            SelectionChanged="PaletteFilter_SelectionChanged"
                            AutomationProperties.Name="Filter commands by control compatibility">
                    <ComboBoxItem Content="All"/><ComboBoxItem Content="Compatible with selected control"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="4">
                  <TextBlock Text="Binding state"/>
                  <ComboBox x:Name="PaletteBindingState" SelectedIndex="0" Margin="0,3,0,8"
                            SelectionChanged="PaletteFilter_SelectionChanged"
                            AutomationProperties.Name="Filter assigned commands">
                    <ComboBoxItem Content="All"/><ComboBoxItem Content="Assigned on this device"/>
                    <ComboBoxItem Content="Unassigned on this device"/>
                  </ComboBox>
                </StackPanel>
                <TextBlock x:Name="PaletteCaption" Grid.Row="5" Margin="0,3,0,5" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <ListBox x:Name="CommandPaletteList" Grid.Row="6"
                         PreviewMouseLeftButtonDown="CommandPaletteList_PreviewMouseLeftButtonDown"
                         AutomationProperties.Name="Drag or select a command to assign">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                      <Setter Property="Cursor" Value="Hand"/>
                      <Setter Property="ToolTip" Value="Drag onto a device callout to assign"/>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="2,4" ToolTip="{Binding Id}">
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Category}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </GroupBox>
            <Grid Grid.Column="1" Margin="0,0,10,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="DiagramHeading" Grid.Row="0" Text="Device graphic · assignment labels"
                         Margin="0,6,0,8" FontWeight="SemiBold"/>
              <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource CanvasBackgroundBrush}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <Canvas x:Name="UiDiagramCanvas" ClipToBounds="True" AllowDrop="True"
                          HorizontalAlignment="Left" VerticalAlignment="Top"
                          DragOver="UiDiagramCanvas_DragOver" Drop="UiDiagramCanvas_Drop"
                          AutomationProperties.Name="Draw.io-generated device SVG with assignment labels">
                    <Canvas.LayoutTransform>
                      <ScaleTransform ScaleX="{Binding Value, ElementName=DiagramZoom}"
                                      ScaleY="{Binding Value, ElementName=DiagramZoom}"/>
                    </Canvas.LayoutTransform>
                  </Canvas>
                </ScrollViewer>
              </Border>
              <Expander Grid.Row="2" Header="Control list for keyboard navigation" Margin="0,5,0,0">
                <ListBox x:Name="UiAssignmentList" Height="100"
                         SelectionChanged="UiAssignmentList_SelectionChanged"
                         AutomationProperties.Name="Keyboard-accessible device controls and assignments"/>
              </Expander>
              <TextBlock x:Name="UiDiagramCaption" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
            </Grid>
            <GroupBox Grid.Column="2" Header="Selected control">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                  <TextBlock x:Name="SelectedControlTitle" Text="Select a callout" FontSize="17"
                             FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="Current command" FontWeight="SemiBold" Margin="0,14,0,3"/>
                  <TextBlock x:Name="SelectedAssignment" TextWrapping="Wrap"/>
                  <TextBlock Text="Pending command" FontWeight="SemiBold" Margin="0,14,0,3"/>
                  <TextBlock x:Name="PendingAssignment" TextWrapping="Wrap"/>
                  <TextBlock Text="DCS default label" FontWeight="SemiBold" Margin="0,14,0,3"/>
                  <TextBlock x:Name="DefaultControlLabel" TextWrapping="Wrap"/>
                  <TextBlock Text="Control and modifier" FontWeight="SemiBold" Margin="0,14,0,3"/>
                  <TextBlock x:Name="SelectedControlIdentity" TextWrapping="Wrap" Margin="0,0,0,12"/>
                  <Button x:Name="AssignSelectedCommand" Content="Assign selected command"
                          Click="Assign_Click" Margin="0,0,0,5"/>
                  <Button Content="Move assignment…" Click="Move_Click" Margin="0,0,0,5"/>
                  <Button Content="Copy assignment…" Click="Copy_Click" Margin="0,0,0,5"/>
                  <Button Content="Swap assignments…" Click="Swap_Click" Margin="0,0,0,5"/>
                  <Button Content="Clear assignment" Click="Remove_Click" Margin="0,0,0,5"/>
                  <Button Content="Restore imported" Click="Restore_Click" Margin="0,0,0,5"/>
                  <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="UndoDraft" Content="Undo" Click="Undo_Click" Margin="0,0,5,5"/>
                    <Button Content="Discard draft" Click="Discard_Click" Margin="0,0,5,5"/>
                    <Button Content="Settings" Click="EditorSettings_Click" Margin="0,0,5,5"/>
                  </WrapPanel>
                  <TextBlock x:Name="EditorStatus" TextWrapping="Wrap" Margin="0,6,0,6"/>
                  <Expander Header="Pending changes" Margin="0,8,0,0">
                    <StackPanel>
                      <TextBlock x:Name="DraftCount" FontWeight="SemiBold" Margin="0,6"/>
                      <ListBox x:Name="DraftReviewList" Height="120"
                               AutomationProperties.Name="Draft before and after review"/>
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </ScrollViewer>
            </GroupBox>
          </Grid>
          <TextBlock Grid.Row="2" Margin="0,5,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     Text="White: imported   Green: new   Amber: replaced   Gray: unassigned     ·     Hold Ctrl while dragging an assignment to copy it."/>
        </Grid>
      </TabItem>
      <TabItem Header="Profiles">
        <ListBox ItemsSource="{Binding Profiles}" AutomationProperties.Name="Imported device profiles"/>
      </TabItem>
      <TabItem Header="Bindings">
        <ListBox ItemsSource="{Binding Bindings}" AutomationProperties.Name="Imported aircraft bindings"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </TabItem>
      <TabItem Header="Kneeboard">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ListBox x:Name="KneeboardList" Grid.Column="0" ItemsSource="{Binding Pages}"
                   SelectionChanged="KneeboardList_SelectionChanged"
                   AutomationProperties.Name="Kneeboard page selector"/>
          <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource CanvasBackgroundBrush}" BorderThickness="1">
              <Image x:Name="KneeboardPreview" Stretch="Uniform"
                     AutomationProperties.Name="Existing rendered kneeboard PNG"/>
            </Border>
            <TextBlock x:Name="KneeboardCaption" Grid.Row="1" Margin="0,8,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="DiagnosticsTab" Header="Diagnostics">
        <ListBox ItemsSource="{Binding Diagnostics}" AutomationProperties.Name="Import diagnostics"/>
      </TabItem>
      <TabItem Header="Sources">
        <ListBox ItemsSource="{Binding Provenance}" AutomationProperties.Name="Committed source hashes"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Text="Draft only · no changes are written to either repository."
                 VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <Button Content="Close" DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="90"
              Padding="12,7" Click="Close_Click"/>
    </DockPanel>
  </Grid>
</Window>
