<Window x:Class="DcsIpia.Presentation.HueyImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Huey · committed import preview" Width="1040" Height="720"
        MinWidth="800" MinHeight="540" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <Window.Resources>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="{Binding Summary}" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Commit}" Margin="0,6,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
      <TextBlock Text="{Binding SourceNote}" Margin="0,3,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
    </StackPanel>
    <TabControl Grid.Row="1" TabStripPlacement="Left" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" ItemContainerStyle="{DynamicResource NavigationItem}"
                AutomationProperties.Name="Imported Huey data">
      <TabItem Header="Profiles">
        <ListBox ItemsSource="{Binding Profiles}" AutomationProperties.Name="Imported device profiles"/>
      </TabItem>
      <TabItem Header="Bindings">
        <ListBox ItemsSource="{Binding Bindings}" AutomationProperties.Name="Imported aircraft bindings"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </TabItem>
      <TabItem Header="Kneeboard">
        <ListBox ItemsSource="{Binding Pages}" AutomationProperties.Name="Imported kneeboard pages"/>
      </TabItem>
      <TabItem Header="UI Layer">
        <ListBox ItemsSource="{Binding UiUsage}" AutomationProperties.Name="UI Layer functions used by Huey"/>
      </TabItem>
      <TabItem Header="Diagnostics">
        <ListBox ItemsSource="{Binding Diagnostics}" AutomationProperties.Name="Import diagnostics"/>
      </TabItem>
      <TabItem Header="Sources">
        <ListBox ItemsSource="{Binding Provenance}" AutomationProperties.Name="Committed source hashes"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Text="Read-only preview · no changes were written to either repository."
                 VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <Button Content="Close" DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="90"
              Padding="12,7" Click="Close_Click"/>
    </DockPanel>
  </Grid>
</Window>
