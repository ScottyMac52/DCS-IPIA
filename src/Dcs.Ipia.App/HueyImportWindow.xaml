<Window x:Class="DcsIpia.Presentation.HueyImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="1380" Height="840"
        MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <Window.Resources>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="{Binding Summary}" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Commit}" Margin="0,6,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
      <TextBlock Text="{Binding SourceNote}" Margin="0,3,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
    </StackPanel>
    <TabControl x:Name="ImportedTabs" Grid.Row="1" TabStripPlacement="Left" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" ItemContainerStyle="{DynamicResource NavigationItem}"
                AutomationProperties.Name="Imported Huey data">
      <TabItem Header="Profiles">
        <ListBox ItemsSource="{Binding Profiles}" AutomationProperties.Name="Imported device profiles"/>
      </TabItem>
      <TabItem Header="Bindings">
        <ListBox ItemsSource="{Binding Bindings}" AutomationProperties.Name="Imported aircraft bindings"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </TabItem>
      <TabItem Header="Kneeboard">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ListBox x:Name="KneeboardList" Grid.Column="0" ItemsSource="{Binding Pages}"
                   SelectionChanged="KneeboardList_SelectionChanged"
                   AutomationProperties.Name="Kneeboard page selector"/>
          <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource CanvasBackgroundBrush}" BorderThickness="1">
              <Image x:Name="KneeboardPreview" Stretch="Uniform"
                     AutomationProperties.Name="Existing rendered kneeboard PNG"/>
            </Border>
            <TextBlock x:Name="KneeboardCaption" Grid.Row="1" Margin="0,8,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Assignment editor">
        <Grid Margin="10,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*" MinWidth="350"/>
            <ColumnDefinition Width="230"/>
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="112"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Device and instance" Margin="8,8,8,6" FontWeight="SemiBold"/>
            <ListBox x:Name="UiDiagramList" Grid.Row="1" ItemsSource="{Binding UiDiagrams}" DisplayMemberPath="Title"
                     SelectionChanged="UiDiagramList_SelectionChanged"
                     AutomationProperties.Name="Device and instance selector"/>
            <ComboBox x:Name="UiModifierChoice" Grid.Row="2" Margin="8,8,8,0"
                      SelectionChanged="UiModifierChoice_SelectionChanged" AutomationProperties.Name="Modifier chord"/>
            <ComboBox x:Name="PaletteScope" Grid.Row="3" Margin="8,12,8,0"
                      SelectionChanged="PaletteScope_SelectionChanged" AutomationProperties.Name="Command scope">
              <ComboBoxItem Content="Module commands"/>
              <ComboBoxItem Content="UI Layer commands"/>
            </ComboBox>
            <TextBlock Grid.Row="4" Text="Available commands" Margin="8,12,8,3" FontWeight="SemiBold"/>
            <TextBox x:Name="PaletteSearch" Grid.Row="5" Margin="8,0,8,6"
                     TextChanged="PaletteSearch_TextChanged" AutomationProperties.Name="Search commands"/>
            <ListBox x:Name="CommandPaletteList" Grid.Row="6" DisplayMemberPath="Display"
                     PreviewMouseMove="CommandPaletteList_PreviewMouseMove"
                     AutomationProperties.Name="Drag or select a command to assign"/>
            <TextBlock x:Name="PaletteCaption" Grid.Row="7" Margin="8,6,8,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
          </Grid>
          <Grid Grid.Column="1" Margin="0,0,10,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
              <RowDefinition Height="120"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Canonical device graphic · assignment labels" Margin="0,6,0,8"
                       FontWeight="SemiBold"/>
            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource CanvasBackgroundBrush}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                  <Canvas x:Name="UiDiagramCanvas" ClipToBounds="True"
                          AutomationProperties.Name="Draw.io-generated device SVG with assignment labels"/>
                </Viewbox>
              </ScrollViewer>
            </Border>
            <ListBox x:Name="UiAssignmentList" Grid.Row="2" Margin="0,8,0,0"
                     SelectionChanged="UiAssignmentList_SelectionChanged"
                     AutomationProperties.Name="Keyboard-accessible device controls and assignments"/>
            <TextBlock x:Name="UiDiagramCaption" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
          </Grid>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Selected control" Margin="0,6,0,8" FontWeight="SemiBold"/>
            <TextBlock x:Name="SelectedControlTitle" Grid.Row="1" Text="Select a control"
                       FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SelectedAssignment" Grid.Row="2" TextWrapping="Wrap" Margin="0,8,0,10"/>
            <Button x:Name="AssignSelectedCommand" Grid.Row="3" Content="Assign selected command" Click="Assign_Click" Margin="0,0,0,5"/>
            <Button Grid.Row="4" Content="Move assignment…" Click="Move_Click" Margin="0,0,0,5"/>
            <Button Grid.Row="5" Content="Copy assignment…" Click="Copy_Click" Margin="0,0,0,5"/>
            <Button Grid.Row="6" Content="Swap assignments…" Click="Swap_Click" Margin="0,0,0,5"/>
            <Button Grid.Row="7" Content="Remove assignment" Click="Remove_Click" Margin="0,0,0,5"/>
            <Button Grid.Row="8" Content="Restore imported" Click="Restore_Click" Margin="0,0,0,5"/>
            <StackPanel Grid.Row="9" Orientation="Horizontal">
              <Button x:Name="UndoDraft" Content="Undo" Click="Undo_Click" Margin="0,0,5,0"/>
              <Button Content="Discard draft" Click="Discard_Click" Margin="0,0,5,0"/>
              <Button Content="Settings" Click="EditorSettings_Click"/>
            </StackPanel>
            <StackPanel Grid.Row="10" Margin="0,12,0,0">
              <TextBlock x:Name="DraftCount" FontWeight="SemiBold"/>
              <TextBlock x:Name="EditorStatus" TextWrapping="Wrap" Margin="0,6,0,6"/>
              <ListBox x:Name="DraftReviewList" AutomationProperties.Name="Draft before and after review"/>
              <ItemsControl ItemsSource="{Binding UiUsage}" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="DiagnosticsTab" Header="Diagnostics">
        <ListBox ItemsSource="{Binding Diagnostics}" AutomationProperties.Name="Import diagnostics"/>
      </TabItem>
      <TabItem Header="Sources">
        <ListBox ItemsSource="{Binding Provenance}" AutomationProperties.Name="Committed source hashes"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Text="Draft only · no changes are written to either repository."
                 VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <Button Content="Close" DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="90"
              Padding="12,7" Click="Close_Click"/>
    </DockPanel>
  </Grid>
</Window>
