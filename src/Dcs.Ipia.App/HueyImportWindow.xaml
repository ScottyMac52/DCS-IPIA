<Window x:Class="DcsIpia.Presentation.HueyImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="1480" Height="900"
        MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterOwner"
        PreviewMouseLeftButtonUp="Editor_PreviewMouseLeftButtonUp"
        PreviewMouseMove="Editor_PreviewMouseMove"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <Window.Resources>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel x:Name="ImportSummary" Grid.Row="0" Margin="0,0,0,8">
      <TextBlock Text="{Binding Summary}" FontSize="19" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Commit}" Margin="0,3,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
      <TextBlock Text="{Binding SourceNote}" Margin="0,3,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
    </StackPanel>
    <TabControl x:Name="ImportedTabs" Grid.Row="1" TabStripPlacement="Top" Background="{DynamicResource SurfaceBrush}"
                SelectionChanged="ImportedTabs_SelectionChanged"
                BorderBrush="{DynamicResource BorderBrush}"
                AutomationProperties.Name="Imported Huey data">
      <TabItem Header="Module controls">
        <DockPanel Margin="10">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="EditorHeading" Text="Module controls" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Drag a command onto a callout, or drag an assigned callout onto another. Select a callout to assign, clear or restore."
                       TextWrapping="Wrap" Margin="0,4"/>
            <WrapPanel Margin="0,2,0,0">
              <TextBlock Text="Modifier layer:" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="UiModifierChoice" MinWidth="180" SelectionChanged="UiModifierChoice_SelectionChanged"
                        AutomationProperties.Name="Modifier chord"/>
              <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="16,0,6,0"/>
              <Slider x:Name="DiagramZoom" Minimum="0.5" Maximum="3" Value="1" Width="140"
                      TickFrequency="0.25" IsSnapToTickEnabled="True" AutomationProperties.Name="Device graphic zoom"/>
              <Button Content="Rendered kneeboard…" Click="OpenKneeboard_Click" Margin="16,0,0,0" Padding="10,4"/>
            </WrapPanel>
            <WrapPanel Margin="0,6,0,0">
              <TextBlock Text="Command scope:" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="PaletteScope" Width="165" SelectionChanged="PaletteScope_SelectionChanged"
                        AutomationProperties.Name="Command scope">
                <ComboBoxItem Content="Module commands"/><ComboBoxItem Content="UI Layer commands"/>
              </ComboBox>
              <TextBlock Text="Device / instance:" VerticalAlignment="Center" Margin="16,0,8,0"/>
              <ComboBox x:Name="UiDiagramList" Width="240" ItemsSource="{Binding UiDiagrams}" DisplayMemberPath="Title"
                        SelectionChanged="UiDiagramList_SelectionChanged" AutomationProperties.Name="Device and instance selector"/>
            </WrapPanel>
          </StackPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button Content="Close" DockPanel.Dock="Right" Padding="20,6" Click="Close_Click"/>
            <StackPanel>
              <TextBlock x:Name="EditorStatus" TextWrapping="Wrap"/>
              <TextBlock Text="White: unchanged   Green: new   Yellow: replaced   Red: conflict   Gray: unassigned"
                         Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock x:Name="DraftCount" FontWeight="SemiBold"/>
            </StackPanel>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Command catalog" Padding="6">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                  <WrapPanel>
                    <Button Content="Import catalog…" Click="LoadModuleCatalog_Click" Padding="8,4"
                            ToolTip="Import a DCS-Common module command catalog JSON."/>
                    <Button Content="Load DCS HTML…" Click="LoadDcsHtml_Click" Padding="8,4" Margin="6,0,0,0"
                            ToolTip="Import DCS Controls HTML exports."/>
                  </WrapPanel>
                  <TextBox x:Name="PaletteSearch" TextChanged="PaletteSearch_TextChanged" Margin="0,8,0,4"
                           AutomationProperties.Name="Search commands"/>
                  <TextBlock Text="Category"/><ComboBox x:Name="PaletteCategory" Margin="0,2,0,0"
                   SelectionChanged="PaletteCategory_SelectionChanged" AutomationProperties.Name="Filter commands by category"/>
                  <TextBlock Text="Type" Margin="0,4,0,0"/>
                  <ComboBox x:Name="PaletteType" SelectedIndex="0" SelectionChanged="PaletteFilter_SelectionChanged"
                            AutomationProperties.Name="Filter commands by type">
                    <ComboBoxItem Content="All"/><ComboBoxItem Content="Buttons"/><ComboBoxItem Content="Axes"/>
                  </ComboBox>
                  <TextBlock Text="Availability" Margin="0,4,0,0"/>
                  <ComboBox x:Name="PaletteAvailability" SelectedIndex="0" SelectionChanged="PaletteFilter_SelectionChanged"
                            AutomationProperties.Name="Filter commands by control compatibility">
                    <ComboBoxItem Content="All"/><ComboBoxItem Content="Compatible with selected control"/>
                  </ComboBox>
                  <TextBlock Text="Binding state" Margin="0,4,0,0"/>
                  <ComboBox x:Name="PaletteBindingState" SelectedIndex="0" SelectionChanged="PaletteFilter_SelectionChanged"
                            AutomationProperties.Name="Filter assigned commands">
                    <ComboBoxItem Content="All"/><ComboBoxItem Content="Assigned on this device"/>
                    <ComboBoxItem Content="Unassigned on this device"/>
                  </ComboBox>
                  <TextBlock x:Name="PaletteCaption" Margin="0,6"/>
                </StackPanel>
                <ListBox x:Name="CommandPaletteList" AutomationProperties.Name="Drag or select a command to assign">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="CommandPaletteList_PreviewMouseLeftButtonDown"/>
                      <Setter Property="Cursor" Value="Hand"/>
                      <Setter Property="ToolTip" Value="Drag onto a device callout to assign"/>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="2,4">
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Category}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="Assignable" FontSize="11"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </GroupBox>
            <ScrollViewer Grid.Column="1" Margin="8,0" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" Background="{DynamicResource CanvasBackgroundBrush}">
              <Canvas x:Name="UiDiagramCanvas" ClipToBounds="True" AllowDrop="True"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      DragOver="UiDiagramCanvas_DragOver" Drop="UiDiagramCanvas_Drop"
                      AutomationProperties.Name="Draw.io-generated device SVG with assignment labels">
                <Canvas.LayoutTransform>
                  <ScaleTransform ScaleX="{Binding Value, ElementName=DiagramZoom}"
                                  ScaleY="{Binding Value, ElementName=DiagramZoom}"/>
                </Canvas.LayoutTransform>
              </Canvas>
            </ScrollViewer>
            <GroupBox Grid.Column="2" Header="Selected control" Padding="10">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock x:Name="SelectedControlTitle" Text="Select a callout" FontSize="18"
                             FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="SelectedControlIdentity" Margin="0,6,0,10" TextWrapping="Wrap"/>
                  <TextBlock Text="Current command" FontWeight="SemiBold"/>
                  <TextBlock x:Name="SelectedAssignment" Margin="0,2,0,10" TextWrapping="Wrap"/>
                  <TextBlock Text="Pending command" FontWeight="SemiBold"/>
                  <TextBlock x:Name="PendingAssignment" Margin="0,2,0,10" TextWrapping="Wrap"/>
                  <TextBlock Text="DCS default label" FontWeight="SemiBold"/>
                  <TextBlock x:Name="DefaultControlLabel" Margin="0,2,0,10" TextWrapping="Wrap"/>
                  <Button x:Name="AssignSelectedCommand" Content="Assign selected command"
                          Click="Assign_Click" Margin="0,4" Padding="8,5"/>
                  <Button Content="Clear assignment" Click="Remove_Click" Margin="0,4" Padding="8,5"/>
                  <Button Content="Undo assignment / Restore" Click="Restore_Click" Margin="0,4" Padding="8,5"/>
                  <Button Content="Move assignment…" Click="Move_Click" Margin="0,4" Padding="8,5"/>
                  <Button Content="Copy assignment…" Click="Copy_Click" Margin="0,4" Padding="8,5"/>
                  <Button Content="Swap assignments…" Click="Swap_Click" Margin="0,4" Padding="8,5"/>
                  <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="UndoDraft" Content="Undo" Click="Undo_Click" Margin="0,0,5,5"/>
                    <Button Content="Discard draft" Click="Discard_Click" Margin="0,0,5,5"/>
                    <Button Content="Settings" Click="EditorSettings_Click" Margin="0,0,5,5"/>
                  </WrapPanel>
                  <TextBlock Text="Drag an assigned callout onto another compatible callout to move its command."
                             Margin="0,16,0,0" TextWrapping="Wrap"/>
                  <Expander Header="Pending changes" Margin="0,12,0,0">
                    <ListBox x:Name="DraftReviewList" Height="120"
                             AutomationProperties.Name="Draft before and after review"/>
                  </Expander>
                </StackPanel>
              </ScrollViewer>
            </GroupBox>
            <StackPanel Grid.Column="1" Visibility="Collapsed">
              <TextBlock x:Name="DiagramHeading"/>
              <ListBox x:Name="UiAssignmentList" SelectionChanged="UiAssignmentList_SelectionChanged"/>
              <TextBlock x:Name="UiDiagramCaption"/>
            </StackPanel>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Profiles">
        <ListBox ItemsSource="{Binding Profiles}" AutomationProperties.Name="Imported device profiles"/>
      </TabItem>
      <TabItem Header="Bindings">
        <ListBox ItemsSource="{Binding Bindings}" AutomationProperties.Name="Imported aircraft bindings"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </TabItem>
      <TabItem Header="Kneeboard">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ListBox x:Name="KneeboardList" Grid.Column="0" ItemsSource="{Binding Pages}"
                   SelectionChanged="KneeboardList_SelectionChanged"
                   AutomationProperties.Name="Kneeboard page selector"/>
          <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource CanvasBackgroundBrush}" BorderThickness="1">
              <Image x:Name="KneeboardPreview" Stretch="Uniform"
                     AutomationProperties.Name="Existing rendered kneeboard PNG"/>
            </Border>
            <TextBlock x:Name="KneeboardCaption" Grid.Row="1" Margin="0,8,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="DiagnosticsTab" Header="Diagnostics">
        <ListBox ItemsSource="{Binding Diagnostics}" AutomationProperties.Name="Import diagnostics"/>
      </TabItem>
      <TabItem Header="Sources">
        <ListBox ItemsSource="{Binding Provenance}" AutomationProperties.Name="Committed source hashes"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </TabItem>
    </TabControl>

  </Grid>
</Window>
