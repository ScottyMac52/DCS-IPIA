<Window x:Class="DcsIpia.Presentation.HueyImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="1040" Height="720"
        MinWidth="800" MinHeight="540" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <Window.Resources>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="{Binding Summary}" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Commit}" Margin="0,6,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
      <TextBlock Text="{Binding SourceNote}" Margin="0,3,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
    </StackPanel>
    <TabControl x:Name="ImportedTabs" Grid.Row="1" TabStripPlacement="Left" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" ItemContainerStyle="{DynamicResource NavigationItem}"
                AutomationProperties.Name="Imported Huey data">
      <TabItem Header="Profiles">
        <ListBox ItemsSource="{Binding Profiles}" AutomationProperties.Name="Imported device profiles"/>
      </TabItem>
      <TabItem Header="Bindings">
        <ListBox ItemsSource="{Binding Bindings}" AutomationProperties.Name="Imported aircraft bindings"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </TabItem>
      <TabItem Header="Kneeboard">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ListBox x:Name="KneeboardList" Grid.Column="0" ItemsSource="{Binding Pages}"
                   SelectionChanged="KneeboardList_SelectionChanged"
                   AutomationProperties.Name="Kneeboard page selector"/>
          <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource CanvasBackgroundBrush}" BorderThickness="1">
              <Image x:Name="KneeboardPreview" Stretch="Uniform"
                     AutomationProperties.Name="Existing rendered kneeboard PNG"/>
            </Border>
            <TextBlock x:Name="KneeboardCaption" Grid.Row="1" Margin="0,8,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="UI Layer">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Device and instance" Margin="8,8,8,6" FontWeight="SemiBold"/>
            <ListBox x:Name="UiDiagramList" ItemsSource="{Binding UiDiagrams}" DisplayMemberPath="Title"
                     SelectionChanged="UiDiagramList_SelectionChanged"
                     AutomationProperties.Name="UI Layer device and instance selector"/>
            <ItemsControl ItemsSource="{Binding UiUsage}" Margin="8,12,8,0"/>
          </StackPanel>
          <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="180"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource CanvasBackgroundBrush}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                  <Canvas x:Name="UiDiagramCanvas" ClipToBounds="True"
                          AutomationProperties.Name="Hardware image with numbered UI Layer assignments"/>
                </Viewbox>
              </ScrollViewer>
            </Border>
            <ListBox x:Name="UiAssignmentList" Grid.Row="1" Margin="0,8,0,0"
                     AutomationProperties.Name="Numbered UI Layer assignments and modifier chords"/>
            <TextBlock x:Name="UiDiagramCaption" Grid.Row="2" Margin="0,8,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="DiagnosticsTab" Header="Diagnostics">
        <ListBox ItemsSource="{Binding Diagnostics}" AutomationProperties.Name="Import diagnostics"/>
      </TabItem>
      <TabItem Header="Sources">
        <ListBox ItemsSource="{Binding Provenance}" AutomationProperties.Name="Committed source hashes"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Text="Read-only preview · no changes were written to either repository."
                 VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
      <Button Content="Close" DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="90"
              Padding="12,7" Click="Close_Click"/>
    </DockPanel>
  </Grid>
</Window>
