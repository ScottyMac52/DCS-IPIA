<Window x:Class="DcsIpia.Presentation.NewModuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New module" Width="850" Height="850" MinWidth="650" MinHeight="550"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="CreationError" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True" Padding="16,8" Margin="0,0,8,0"/>
        <Button x:Name="CreateButton" Content="Create module" IsDefault="True" Padding="16,8" Click="CreateClicked"/>
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Create a module" FontSize="24" FontWeight="Bold"/>
        <TextBlock Text="Enter the exact DCS input folder name for this aircraft." TextWrapping="Wrap" Margin="0,12,0,8"/>
        <Label Target="{Binding ElementName=DcsIdInput}" Content="DCS input folder"/>
        <TextBox x:Name="DcsIdInput" AutomationProperties.Name="DCS input folder"/>
        <Label Target="{Binding ElementName=DisplayNameInput}" Content="Display name"/>
        <TextBox x:Name="DisplayNameInput" AutomationProperties.Name="Module display name"/>
        <TextBlock x:Name="BaselineText" TextWrapping="Wrap" Margin="0,12,0,8"/>
        <TextBlock Text="Initial aircraft devices are optional. Add each physical unit separately; the same hardware template can be used repeatedly. For an offline unit, enter its captured native filename. GUIDs must come from the unit, not the hardware template."
                   TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Label Target="{Binding ElementName=PhysicalChoices}" Content="Physical unit"/>
        <ComboBox x:Name="PhysicalChoices" DisplayMemberPath="Title" SelectionChanged="PhysicalChanged"/>
        <WrapPanel Margin="0,8,0,8">
          <Button x:Name="RefreshDevicesButton" Content="Refresh devices" Click="RefreshDevicesClicked" Padding="10,6"/>
          <Button Content="Saved Games folder…" Click="SavedGamesClicked" Margin="8,0,0,0" Padding="10,6"/>
          <Button x:Name="ManualFileButton" Content="Use typed filename" Click="ManualFileClicked" Margin="8,0,0,0" Padding="10,6"/>
        </WrapPanel>
        <Label Target="{Binding ElementName=HardwareChoices}" Content="Shared hardware template"/>
        <ComboBox x:Name="HardwareChoices" DisplayMemberPath="Title" SelectionChanged="HardwareChanged" AutomationProperties.Name="Initial module hardware"/>
        <Label Target="{Binding ElementName=NativeFileInput}" Content="Native GUID-qualified DCS filename"/>
        <TextBox x:Name="NativeFileInput"/>
        <Label Target="{Binding ElementName=UnitInstance}" Content="Instance label (for example Left or Right)"/>
        <TextBox x:Name="UnitInstance"/>
        <Label Target="{Binding ElementName=UnitRole}" Content="Role (optional)"/>
        <TextBox x:Name="UnitRole"/>
        <Label Target="{Binding ElementName=BaselineChoices}" Content="Copied UI Layer profile to rebind (optional)"/>
        <ComboBox x:Name="BaselineChoices"/>
        <TextBlock Text="Rebinding retains that profile's assignments and modifier references. Leave this empty to add an independent unit. Copied profiles not selected here retain their saved baseline identity and can be rebound in Devices."
                   TextWrapping="Wrap" Margin="0,8,0,8"/>
        <WrapPanel>
          <Button Content="Use a new unit" Click="ClearBaselineClicked" Padding="10,6"/>
          <Button x:Name="AddUnitButton" Content="Add selected unit" Click="AddUnitClicked" Margin="8,0,0,0" Padding="10,6"/>
          <Button Content="Remove selected row" Click="RemoveUnitClicked" Margin="8,0,0,0" Padding="10,6"/>
        </WrapPanel>
        <ListBox x:Name="SelectedUnits" DisplayMemberPath="Title" Height="130" Margin="0,12,0,0" AutomationProperties.Name="Selected physical units"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
