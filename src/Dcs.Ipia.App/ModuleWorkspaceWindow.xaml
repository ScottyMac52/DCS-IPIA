<Window x:Class="DcsIpia.Presentation.ModuleWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:DcsIpia.Presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="{x:Static local:ApplicationBranding.Icon}" Title="{Binding WindowTitle}" Width="1380" Height="840"
        MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <!-- Reserve the same toolbar space for every feature, even when there are no actions. -->
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="{Binding Summary}" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Commit}" Margin="0,6,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
      <TextBlock Text="{Binding SourceNote}" Margin="0,3,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
      <ListBox x:Name="ImportDiagnostics" ItemsSource="{Binding Diagnostics}" MaxHeight="100"/>
      <Expander Header="Import details" Margin="0,8,0,0" AutomationProperties.Name="Imported profiles and bindings">
        <Grid Height="180"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <GroupBox Header="Profiles" Margin="0,0,8,0"><ListBox ItemsSource="{Binding Profiles}" AutomationProperties.Name="Imported device profiles"/></GroupBox>
          <GroupBox Header="Bindings" Grid.Column="1"><ListBox ItemsSource="{Binding Bindings}" AutomationProperties.Name="Imported aircraft bindings"/></GroupBox>
        </Grid>
      </Expander>
    </StackPanel>
    <ListBox x:Name="FeatureNav" Grid.Row="2" Width="160" HorizontalAlignment="Left"
        SelectionChanged="FeatureNavChanged">
        <ListBoxItem Content="Devices" Tag="Devices"/>
        <ListBoxItem Content="Modifiers" Tag="Modifiers"/>
        <ListBoxItem Content="Assignments" Tag="Assignments"/>
        <ListBoxItem Content="Input Test" Tag="InputTest"/>
        <ListBoxItem Content="Commands" Tag="Commands"/>
        <ListBoxItem Content="Pages" Tag="Pages"/>
        <ListBoxItem Content="Kneeboards" Tag="Kneeboards"/>
        <ListBoxItem Content="Documentation" Tag="Documentation"/>
    </ListBox>

        <local:FeatureActionBar x:Name="FeatureActions" Grid.Row="1" Margin="170,0,0,0"/>
        <ContentControl x:Name="FeatureContent" Grid.Row="2" Margin="170,0,0,0"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <DockPanel Grid.Row="3" Margin="0,16,0,0">
      <StackPanel DockPanel.Dock="Left" MaxWidth="800">
        <TextBlock x:Name="PendingSummary" Text="No pending assignment changes"/>
        <TextBlock x:Name="EditorMessage"/>
        <TextBlock x:Name="OutputFailureDiagnostic"/>
        <WrapPanel>
          <TextBlock Text="Package version:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="PackageVersion" Width="110" ToolTip="Version included in the ZIP filename"
                   TextChanged="BuildVersionChanged" AutomationProperties.Name="OvGME package version"/>
          <Button x:Name="ValidateModuleButton" Content="Validate saved module" IsEnabled="False" Margin="10,0,0,0" Padding="12,4" Click="ValidateModuleClicked"/>
          <Button x:Name="ExportModuleSnapshotButton" Content="Export module snapshot…" IsEnabled="False" Margin="10,0,0,0" Padding="12,4" Click="ExportModuleSnapshotClicked"/>
          <Button x:Name="ExportModuleDocumentationButton" Content="Export module documentation…" IsEnabled="False" Margin="10,0,0,0" Padding="12,4" Click="ExportModuleDocumentationClicked"/>
          <Button x:Name="ExportCompleteReleaseButton" Content="Export Complete release…" IsEnabled="False" Margin="10,0,0,0" Padding="12,4" Click="ExportCompleteReleaseClicked"/>
          <Button x:Name="BuildButton" Content="Build OvGME package…" IsEnabled="False"
                  Margin="10,0,0,0" Padding="12,4" Click="BuildClicked"/>
        </WrapPanel>
        <TextBlock x:Name="BuildStatus" Text="Build uses saved database state. Save pending edits first."
                   Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
      </StackPanel>
      <Button x:Name="WorkspaceSettingsButton" Content="Settings" DockPanel.Dock="Right" Margin="0,0,8,0" Padding="12,4" Click="SettingsClicked"/>
      <Button Content="Close" DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="90"
              Padding="12,4" Click="Close_Click"/>
    </DockPanel>
  </Grid>
</Window>


