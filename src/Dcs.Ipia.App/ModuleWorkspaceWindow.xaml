<Window x:Class="DcsIpia.Presentation.ModuleWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="1380" Height="840"
        MinWidth="1100" MinHeight="680" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <Window.Resources>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="RowBackground" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="{Binding Summary}" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Commit}" Margin="0,6,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
      <TextBlock Text="{Binding SourceNote}" Margin="0,3,0,0"
                 Foreground="{DynamicResource SecondaryTextBrush}"/>
      <Expander Header="Import details" Margin="0,8,0,0" AutomationProperties.Name="Imported profiles and bindings">
        <Grid Height="180"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <GroupBox Header="Profiles" Margin="0,0,8,0"><ListBox ItemsSource="{Binding Profiles}" AutomationProperties.Name="Imported device profiles"/></GroupBox>
          <GroupBox Header="Bindings" Grid.Column="1"><ListBox ItemsSource="{Binding Bindings}" AutomationProperties.Name="Imported aircraft bindings"/></GroupBox>
        </Grid>
      </Expander>
    </StackPanel>
    <ListBox x:Name="FeatureNav" Grid.Row="1" Width="160" HorizontalAlignment="Left"
        SelectionChanged="FeatureNavChanged">
        <ListBoxItem Content="Devices"/>
        <ListBoxItem Content="Modifiers"/>
        <ListBoxItem Content="Assignments"/>
    </ListBox>
    <ContentControl x:Name="FeatureContent" Grid.Row="1" Margin="170,0,0,0"/>
        <TabControl x:Name="ImportedTabs" Grid.Row="1" TabStripPlacement="Left" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" ItemContainerStyle="{DynamicResource NavigationItem}"
                AutomationProperties.Name="Imported module data" Visibility="Collapsed">
      <TabItem Header="Assignments">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="DeviceTitle" FontSize="20" FontWeight="SemiBold" Text="Module controls" TextWrapping="Wrap"/>
            <TextBlock Text="Drag a command onto a callout, or drag an assigned callout onto another. Changes remain pending until Save to database." Margin="0,4" TextWrapping="Wrap"/>
            <WrapPanel>
              <TextBlock Text="Device:" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="DeviceChoice" MinWidth="180" DisplayMemberPath="Title" SelectionChanged="DeviceChanged"/>
              <TextBlock Text="Modifier layer:" VerticalAlignment="Center" Margin="12,0,8,0"/>
              <ComboBox x:Name="Layers" MinWidth="180" SelectionChanged="LayerChanged"/>
              <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="12,0,8,0"/>
              <ComboBox x:Name="Scope" MinWidth="140" SelectionChanged="ScopeChanged">
                <ComboBoxItem Content="Module controls"/>
                <ComboBoxItem Content="Module UI Layer"/>
              </ComboBox>
              <Button Content="Clear layer assignments" Click="ClearLayerAssignmentsClicked" Margin="12,0,0,0" Padding="10,4"/>
              <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="16,0,6,0"/>
              <Slider x:Name="Zoom" Minimum="0.5" Maximum="3" Value="1" Width="140" ValueChanged="ZoomChanged"/>
              <Button x:Name="StartInputTestButton" Content="Test Inputs" Click="StartInputTestClicked" Margin="12,0,0,0" Padding="10,4"/>
              <Button x:Name="StopInputTestButton" Content="Stop test" Click="StopInputTestClicked" IsEnabled="False" Margin="6,0,0,0" Padding="10,4"/>
              <ComboBox x:Name="InputTestSnapshotChoice" SelectedIndex="0" MinWidth="140" Margin="6,0,0,0"><ComboBoxItem Content="Current edits"/><ComboBoxItem Content="Saved profile"/></ComboBox>
              <Button Content="Rendered kneeboard…" Click="RenderClicked" Margin="16,0,0,0" Padding="10,4"/>
            </WrapPanel>
          </StackPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Save to database" Padding="20,6" Click="SaveClicked"/>
            <Button DockPanel.Dock="Right" Content="Discard draft" Padding="20,6" Margin="0,0,8,0" Click="DiscardClicked"/>
            <Button DockPanel.Dock="Right" Content="Load authored labels…" Padding="12,6" Margin="0,0,8,0" Click="LoadAuthoredLabelsClicked"/>
            <StackPanel>
              <TextBlock x:Name="EditorMessage" TextWrapping="Wrap"/>
              <TextBlock Text="White: unchanged   Green: new   Yellow: replaced   Gray: unassigned" Margin="0,4"/>
              <TextBlock x:Name="PendingSummary" FontWeight="SemiBold"/>
            </StackPanel>
          </DockPanel>
          <Grid x:Name="AssignmentPanes">
            <Grid.RowDefinitions>
              <RowDefinition x:Name="InputTestRow" Height="1*" MinHeight="60"/>
              <RowDefinition Height="6"/>
              <RowDefinition Height="2*" MinHeight="100"/>
            </Grid.RowDefinitions>
            <Expander x:Name="InputTestPane" Grid.Row="0" Header="Live input test" IsExpanded="True" VerticalContentAlignment="Stretch" Margin="0,0,0,6" Expanded="InputTestPaneExpanded" Collapsed="InputTestPaneCollapsed">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="InputTestStatus" Text="Test physical inputs against generated Lua. Built-in DCS defaults and in-game execution are outside this test." TextWrapping="Wrap"/>
                <TextBlock x:Name="InputTestModifiers" Grid.Row="1" TextWrapping="Wrap"/>
                <DockPanel Grid.Row="2" Margin="0,4">
                  <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="ClearInputTestLogButton" Content="Clear" Click="ClearInputTestLogClicked" Padding="10,4"
                            IsEnabled="{Binding ElementName=InputTestLog, Path=HasItems}" ToolTip="Clear events without stopping the test"/>
                    <Button x:Name="CopyInputTestLogButton" Content="Copy" Click="CopyInputTestLogClicked" Padding="10,4" Margin="6,0,0,0"
                            IsEnabled="{Binding ElementName=InputTestLog, Path=HasItems}" ToolTip="Copy selected events, or all events when none are selected, as an HTML table"/>
                  </StackPanel>
                  <TextBlock x:Name="InputTestLogMessage" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <ListBox x:Name="InputTestLog" Grid.Row="3" FontFamily="Consolas" DisplayMemberPath="Display" SelectionMode="Extended"
                         AutomationProperties.Name="Input test event log" ToolTip="Use Ctrl or Shift to select events to copy"/>
              </Grid>
            </Expander>
            <GridSplitter x:Name="InputTestSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          Background="{DynamicResource BorderBrush}" Cursor="SizeNS" Focusable="True"
                          ToolTip="Drag to resize input testing and assignment editor" AutomationProperties.Name="Resize input test and assignment panes"/>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
              <GroupBox Header="Command catalog" Padding="6">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top">
                    <TextBox x:Name="CommandSearch" TextChanged="FiltersChanged" ToolTip="Search command, category or ID" Margin="0,8,0,4"/>
                    <TextBlock Text="Category"/>
                    <ComboBox x:Name="CommandCategory" SelectionChanged="FiltersChanged"/>
                    <TextBlock Text="Type" Margin="0,4,0,0"/>
                    <ComboBox x:Name="CommandType" SelectionChanged="FiltersChanged">
                      <ComboBoxItem Content="All"/><ComboBoxItem Content="Key"/><ComboBoxItem Content="Axes"/>
                    </ComboBox>
                    <TextBlock Text="Binding state" Margin="0,4,0,0"/>
                    <ComboBox x:Name="BindingState" SelectionChanged="FiltersChanged"
                              ToolTip="Bound/Unbound: selected device and modifier. Bound by all: assigned on every device in this scope. Unbound by all: assigned on no device in this scope.">
                      <ComboBoxItem Content="All"/><ComboBoxItem Content="Bound"/><ComboBoxItem Content="Unbound"/>
                      <ComboBoxItem Content="Bound by all"/><ComboBoxItem Content="Unbound by all"/>
                    </ComboBox>
                    <TextBlock x:Name="CommandCount" Margin="0,6"/>
                  </StackPanel>
                  <ListBox x:Name="Commands" PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="CommandDrag">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="2,4">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Category}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </GroupBox>
              <ScrollViewer Grid.Column="1" Margin="8,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                            Background="{DynamicResource CanvasBackgroundBrush}">
                <Canvas x:Name="Diagram" HorizontalAlignment="Left" VerticalAlignment="Top"/>
              </ScrollViewer>
              <GroupBox Grid.Column="2" Header="Selected control" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <TextBlock x:Name="PhysicalInput" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Text="Select a callout"/>
                    <TextBlock x:Name="Chord" Margin="0,6" TextWrapping="Wrap"/>
                    <TextBlock Text="Current command" FontWeight="SemiBold"/><TextBlock x:Name="CurrentCommand" TextWrapping="Wrap" Margin="0,2,0,10"/>
                    <TextBlock Text="Pending command" FontWeight="SemiBold"/><TextBlock x:Name="PendingCommand" TextWrapping="Wrap" Margin="0,2,0,10"/>
                    <TextBlock Text="DCS default label" FontWeight="SemiBold"/><TextBlock x:Name="DefaultLabel" TextWrapping="Wrap" Margin="0,2,0,10"/>
                    <TextBlock Text="Physical control name" FontWeight="SemiBold"/>
                    <TextBox x:Name="GenericControlName" IsEnabled="False" Margin="0,4,0,4"/>
                    <Button x:Name="RenameGenericControlButton" Content="Set control name" Click="RenameGenericControlClicked" IsEnabled="False" Margin="0,0,0,8"/>
                    <TextBlock Text="Displayed label" FontWeight="SemiBold"/><TextBox x:Name="LabelEditor" TextChanged="LabelChanged" IsEnabled="False" Margin="0,4,0,8"/>
                    <TextBlock Text="Axis tuning" FontWeight="SemiBold"/><TextBlock x:Name="AxisTuningSummary" Margin="0,2,0,6" TextWrapping="Wrap"/>
                    <Button x:Name="TuneAxisButton" Content="Tune axis…" Click="TuneAxisClicked" IsEnabled="False" Padding="8,5"/>
                    <Button Content="Assign selected command" Click="AssignClicked" Margin="0,4" Padding="8,5"/>
                    <Button Content="Clear assignment" Click="ClearClicked" Margin="0,4" Padding="8,5"/>
                    <Button Content="Undo assignment / Restore" Click="UndoClicked" Margin="0,4" Padding="8,5"/>
                    <Button Content="Reset label to DCS default" Click="ResetClicked" Margin="0,4" Padding="8,5"/>
                    <TextBlock Text="Drag an assigned callout onto another compatible callout to move its command." TextWrapping="Wrap" Margin="0,16,0,0"/>
                  </StackPanel>
                </ScrollViewer>
              </GroupBox>
            </Grid>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Commands">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Aircraft commands — changes apply to this module. Save to database to keep them." TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel>
              <Button x:Name="LoadCommandJsonButton" Content="Load commands from JSON…" Click="LoadCommandJsonClicked" Padding="10,6"/>
              <Button x:Name="LoadCommandHtmlButton" Content="Load commands from DCS HTML…" Click="LoadCommandHtmlClicked" Padding="10,6" Margin="8,0,0,0"/>
            </WrapPanel>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="AuthoredCommands" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                      SelectionChanged="AuthoredCommandSelected" AutomationProperties.Name="Aircraft command catalog" Margin="0,0,12,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                <DataGridTextColumn Header="DCS code" Binding="{Binding Id}" Width="*"/>
                <DataGridCheckBoxColumn Header="Axis" Binding="{Binding IsAxis}"/>
              </DataGrid.Columns>
            </DataGrid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Button Content="New command" Click="NewAircraftCommandClicked" HorizontalAlignment="Left" Padding="10,6"/>
                <TextBlock Text="DCS command code" Margin="0,12,0,4"/>
                <TextBox x:Name="AircraftCommandCode" AutomationProperties.Name="Aircraft DCS command code"/>
                <TextBlock Text="Name" Margin="0,12,0,4"/><TextBox x:Name="AircraftCommandName"/>
                <TextBlock Text="Category" Margin="0,12,0,4"/><TextBox x:Name="AircraftCommandCategory"/>
                <TextBlock Text="Input type" Margin="0,12,0,4"/>
                <ComboBox x:Name="AircraftCommandType" SelectedIndex="0">
                  <ComboBoxItem Content="Key / button"/><ComboBoxItem Content="Axis"/>
                </ComboBox>
                <Button x:Name="StageAircraftCommandButton" Content="Stage command" Click="StageAircraftCommandClicked" Margin="0,16,0,8" Padding="10,6"/>
                <Button Content="Remove selected command" Click="RemoveAircraftCommandClicked" Padding="10,6"/>
                <TextBlock Text="Command codes stay fixed after creation. Clear assignments before removing a command or changing its input type."
                           TextWrapping="Wrap" Margin="0,12,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="SaveAuthoringButton" Content="Save to database" Click="SaveClicked" Padding="12,6"/>
              <Button x:Name="DiscardAuthoringButton" Content="Discard draft" Click="DiscardClicked" Padding="12,6" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="CommandAuthoringStatus" TextWrapping="Wrap" Margin="0,0,12,0"/>
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Pages">
        <Grid Margin="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="New page" Click="NewAuthoredPageClicked" Padding="10,6" Margin="0,0,8,0"/>
            <Button x:Name="MissingDevicePagesButton" Content="Add missing device pages" Click="MissingDevicePagesClicked" Padding="10,6"/>
            <Button x:Name="GenerateSummaryButton" Content="Generate Summary" Click="GenerateSummaryClicked" Padding="10,6" Margin="8,0,0,0"/>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="AuthoredPages" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" Margin="0,0,12,0"
                      AllowDrop="True" PreviewMouseLeftButtonDown="AuthoredPageMouseDown" PreviewMouseMove="AuthoredPageMouseMove"
                      PreviewMouseLeftButtonUp="AuthoredPageMouseUp" PreviewDragOver="AuthoredPageDragOver" PreviewDrop="AuthoredPageDrop"
                      ToolTip="Drag rows to reorder and renumber pages. Save to database to keep the order."
                      SelectionChanged="AuthoredPageSelected" AutomationProperties.Name="Authored kneeboard pages">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Page" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="File" Binding="{Binding StableKey}" Width="*"/>
                <DataGridTextColumn Header="Layout" Binding="{Binding Kind}"/>
                <DataGridTextColumn Header="Order" Binding="{Binding Order}"/>
              </DataGrid.Columns>
            </DataGrid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Layout"/>
                <ComboBox x:Name="AuthoredPageKind" SelectionChanged="AuthoredPageKindChanged"/>
                <TextBlock Text="Device" Margin="0,8,0,4"/>
                <ComboBox x:Name="AuthoredPageDevice" DisplayMemberPath="SourceName"/>
                <TextBlock Text="Output page name (without .png)" Margin="0,8,0,4"/><TextBox x:Name="AuthoredPageFile"/>
                <TextBlock Text="Heading" Margin="0,8,0,4"/><TextBox x:Name="AuthoredPageTitle"/>
                <TextBlock Text="Subtitle" Margin="0,8,0,4"/><TextBox x:Name="AuthoredPageSubtitle"/>
                <TextBlock Text="Order" Margin="0,8,0,4"/><TextBox x:Name="AuthoredPageOrder" Text="0"/>
                <GroupBox x:Name="SummaryCardsGroup" Header="Summary cards — two columns, up to 14 cards" Margin="0,12,0,0" Padding="8">
                  <StackPanel>
                    <TextBlock Style="{DynamicResource Hint}" Text="Drag rows to reorder and renumber cards. Stage page, then Save." TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <ListBox x:Name="SummaryCards" DisplayMemberPath="Display" Height="110" MinHeight="110" MaxHeight="700" SelectionChanged="SummaryCardSelected"
                             AllowDrop="True" PreviewMouseLeftButtonDown="SummaryCardMouseDown" PreviewMouseMove="SummaryCardMouseMove"
                             PreviewMouseLeftButtonUp="SummaryCardMouseUp" PreviewDragOver="SummaryCardDragOver" PreviewDrop="SummaryCardDrop"
                             AutomationProperties.Name="Summary cards in display order"/>
                    <Thumb x:Name="SummaryCardsResizeHandle" Height="12" Margin="0,2,0,0" Cursor="SizeNS" Focusable="True"
                           Background="{DynamicResource BorderBrush}" DragDelta="SummaryCardsResizeDragged" KeyDown="SummaryCardsResizeKeyDown"
                           ToolTip="Drag to resize the card list. Use Up or Down when focused."
                           AutomationProperties.Name="Resize summary card list vertically">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border Background="{TemplateBinding Background}">
                            <Border Width="40" Height="2" Background="{DynamicResource SecondaryTextBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                    <TextBlock Text="Card heading" Margin="0,8,0,4"/><TextBox x:Name="SummaryCardKey"/>
                    <TextBlock Text="Description" Margin="0,8,0,4"/><TextBox x:Name="SummaryCardText"/>
                    <TextBlock Text="Accent" Margin="0,8,0,4"/><ComboBox x:Name="SummaryCardAccent"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Button Content="New card" Click="NewSummaryCardClicked" Padding="8,5" Margin="0,0,6,0"/>
                      <Button x:Name="SetSummaryCardButton" Content="Set card" Click="SetSummaryCardClicked" Padding="8,5" Margin="0,0,6,0"/>
                      <Button Content="Remove card" Click="RemoveSummaryCardClicked" Padding="8,5"/>
                    </StackPanel>
                  </StackPanel>
                </GroupBox>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button x:Name="StageAuthoredPageButton" Content="Stage page" Click="StageAuthoredPageClicked" Padding="10,6" Margin="0,0,8,0"/>
                  <Button Content="Preview draft" Click="PreviewAuthoredPageClicked" Padding="10,6"/>
                </StackPanel>
                <Button x:Name="RemoveAuthoredPageButton" Content="Remove page" Click="RemoveAuthoredPageClicked" Padding="10,6" Margin="0,8,0,0"/>
                <TextBlock Text="Each device uses one combined page with its pinned hardware layout. Device headings and output names can be edited; summary cards follow their listed order."
                           TextWrapping="Wrap" Margin="0,12,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Save to database" Click="SaveClicked" Padding="12,6"/>
              <Button Content="Discard draft" Click="DiscardClicked" Padding="12,6" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="PageAuthoringStatus" TextWrapping="Wrap" Margin="0,0,12,0"/>
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Kneeboard">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ListBox x:Name="KneeboardList" Grid.Column="0" ItemsSource="{Binding Pages}"
                   SelectionChanged="KneeboardList_SelectionChanged"
                   AutomationProperties.Name="Kneeboard page selector"/>
          <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}"
                    Background="{DynamicResource CanvasBackgroundBrush}" BorderThickness="1">
              <Image x:Name="KneeboardPreview" Stretch="Uniform"
                     AutomationProperties.Name="Existing rendered kneeboard PNG"/>
            </Border>
            <StackPanel Grid.Row="1">
              <ComboBox x:Name="GenericPageChoice" SelectionChanged="GenericPageChanged" AutomationProperties.Name="Generic kneeboard page" IsEnabled="False" Margin="0,8,0,0"/>
              <TextBlock x:Name="KneeboardCaption" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Documentation">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Integration instructions" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Load explicit JSON instructions or a consumer Markdown guide for this module. Review before staging, then Save to database. Saved instructions appear in documentation and Complete exports." TextWrapping="Wrap" Margin="0,6"/>
            <TextBlock Text="Instructions describe configuration; they do not install integration scripts. Review imported guide paths against the generated installation and control mappings." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
            <WrapPanel Margin="0,10,0,0">
              <Button x:Name="LoadIntegrationInstructionsButton" Content="Load integration instructions…" Click="LoadIntegrationInstructionsClicked" Padding="12,7" Margin="0,0,8,0"/>
              <Button x:Name="RemoveIntegrationInstructionButton" Content="Remove selected instruction" Click="RemoveIntegrationInstructionClicked" Padding="12,7"/>
            </WrapPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="IntegrationStatus" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <WrapPanel>
              <Button x:Name="SaveIntegrationInstructionsButton" Content="Save to database" Click="SaveClicked" Padding="12,7" Margin="0,0,8,0"/>
              <Button x:Name="DiscardIntegrationInstructionsButton" Content="Discard draft" Click="DiscardClicked" Padding="12,7"/>
            </WrapPanel>
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="IntegrationInstructions" DisplayMemberPath="Name" SelectionChanged="IntegrationInstructionSelected" AutomationProperties.Name="Module integration instruction groups" Margin="0,0,12,0"/>
            <TextBox x:Name="IntegrationInstructionText" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Captured integration instructions"/>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem x:Name="DiagnosticsTab" Header="Diagnostics">
        <DockPanel>
          <TextBlock x:Name="OutputFailureDiagnostic" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="8"/>
          <ListBox ItemsSource="{Binding Diagnostics}" AutomationProperties.Name="Import diagnostics"/>
        </DockPanel>
      </TabItem>
      <TabItem Header="Sources">
        <ListBox ItemsSource="{Binding Provenance}" AutomationProperties.Name="Committed source hashes"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <StackPanel DockPanel.Dock="Left" MaxWidth="800">
        <WrapPanel>
          <TextBlock Text="Package version:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="PackageVersion" Width="110" ToolTip="Version included in the ZIP filename"
                   TextChanged="BuildVersionChanged" AutomationProperties.Name="OvGME package version"/>
          <Button x:Name="ValidateModuleButton" Content="Validate saved module" IsEnabled="False" Margin="10,0,0,0" Padding="12,7" Click="ValidateModuleClicked"/>
          <Button x:Name="ExportModuleSnapshotButton" Content="Export module snapshot…" IsEnabled="False" Margin="10,0,0,0" Padding="12,7" Click="ExportModuleSnapshotClicked"/>
          <Button x:Name="ExportModuleDocumentationButton" Content="Export module documentation…" IsEnabled="False" Margin="10,0,0,0" Padding="12,7" Click="ExportModuleDocumentationClicked"/>
          <Button x:Name="ExportCompleteReleaseButton" Content="Export Complete release…" IsEnabled="False" Margin="10,0,0,0" Padding="12,7" Click="ExportCompleteReleaseClicked"/>
          <Button x:Name="BuildButton" Content="Build OvGME package…" IsEnabled="False"
                  Margin="10,0,0,0" Padding="12,7" Click="BuildClicked"/>
        </WrapPanel>
        <TextBlock x:Name="BuildStatus" Text="Build uses saved database state. Save pending edits first."
                   Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
      </StackPanel>
      <Button x:Name="WorkspaceSettingsButton" Content="Settings" DockPanel.Dock="Right" Margin="0,0,8,0" Padding="12,7" Click="SettingsClicked"/>
      <Button Content="Close" DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="90"
              Padding="12,7" Click="Close_Click"/>
    </DockPanel>
  </Grid>
</Window>

