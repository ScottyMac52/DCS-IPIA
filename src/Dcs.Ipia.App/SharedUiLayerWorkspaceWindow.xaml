<Window x:Class="DcsIpia.Presentation.SharedUiLayerWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shared default UI Layer" Width="1000" Height="680" MinWidth="680" MinHeight="420"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Style="{DynamicResource SectionTitle}" Text="Shared default UI Layer"/>
      <TextBlock x:Name="RevisionText"/>
      <TextBlock Style="{DynamicResource Hint}" Text="Edit shared defaults independently. Existing modules retain their pinned sources."/>
    </StackPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="Bindings">
        <Grid Margin="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Device profile"/>
            <ComboBox x:Name="ProfilePaths" SelectionChanged="ProfileChanged" Margin="0,4,0,10"/>
            <WrapPanel Margin="0,0,0,10">
              <TextBlock Text="Modifier layer:" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="ClearLayerChoice" MinWidth="160"/>
              <Button x:Name="ClearLayerButton" Content="Clear layer assignments" Click="ClearLayerClicked" Padding="10,6" Margin="8,0,0,0"/>
            </WrapPanel>
          </StackPanel>
          <DataGrid x:Name="BindingRows" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                    SelectionChanged="BindingSelected" Margin="0,0,0,10">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Command" Binding="{Binding CommandName}" Width="*"/>
              <DataGridTextColumn Header="Input" Binding="{Binding InputKey}" Width="150"/>
              <DataGridTextColumn Header="Modifiers" Binding="{Binding Reformers.Count}" Width="80"/>
              <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="80"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Disposition}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="260">
            <StackPanel x:Name="BindingFields">
              <TextBlock Text="Command"/><ComboBox x:Name="CommandChoice" DisplayMemberPath="Name" Margin="0,4,0,8"/>
              <TextBlock Text="DCS input key (for example JOY_BTN1)"/><TextBox x:Name="InputKey" Margin="0,4,0,8"/>
              <TextBlock Text="Modifier chord (names separated by +; blank for base)"/><TextBox x:Name="ModifierChord" Margin="0,4,0,8"/>
              <TextBlock x:Name="DeclaredModifiers" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <TextBlock Text="Add/Update stages the selected key binding. Axis bindings and removal history remain read-only." TextWrapping="Wrap" Margin="0,0,0,8"/>
              <WrapPanel>
                <Button Content="New binding" Click="NewBindingClicked" Padding="10,6" Margin="0,0,8,0"/>
                <Button Content="Add" Click="AddBindingClicked" Padding="10,6" Margin="0,0,8,0"/>
                <Button x:Name="UpdateBindingButton" Content="Update" Click="UpdateBindingClicked" Padding="10,6" Margin="0,0,8,0"/>
                <Button Content="Remove" Click="RemoveBindingClicked" Padding="10,6"/>
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Commands">
        <Grid Margin="10">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DataGrid x:Name="CatalogRows" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                    SelectionChanged="CatalogSelected" Margin="0,0,0,10">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Identity" Binding="{Binding Id}" Width="150"/>
              <DataGridTextColumn Header="DCS command code" Binding="{Binding Command}" Width="*"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Label}" Width="180"/>
              <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
            </DataGrid.Columns>
          </DataGrid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="260">
            <StackPanel x:Name="CatalogFields">
              <TextBlock Text="Catalog identity (stable after adding)"/><TextBox x:Name="CatalogIdentity" Margin="0,4,0,8"/>
              <TextBlock Text="DCS command code"/><TextBox x:Name="CatalogCode" Margin="0,4,0,8"/>
              <TextBlock Text="Name"/><TextBox x:Name="CatalogLabel" Margin="0,4,0,8"/>
              <TextBlock Text="Category"/><TextBox x:Name="CatalogCategory" Margin="0,4,0,8"/>
              <TextBlock Text="Command codes must come from DCS. Clear assignments before removing an entry or changing an assigned command's code." TextWrapping="Wrap" Margin="0,0,0,8"/>
              <WrapPanel>
                <Button Content="New command" Click="NewCommandClicked" Padding="10,6" Margin="0,0,8,0"/>
                <Button x:Name="AddCommandButton" Content="Add" Click="AddCommandClicked" Padding="10,6" Margin="0,0,8,0"/>
                <Button x:Name="UpdateCommandButton" Content="Update" Click="UpdateCommandClicked" Padding="10,6" Margin="0,0,8,0"/>
                <Button x:Name="RemoveCommandButton" Content="Remove" Click="RemoveCommandClicked" Padding="10,6"/>
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Devices">
        <Grid Margin="10">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DataGrid x:Name="DeviceRows" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                    SelectionChanged="DeviceSelected" Margin="0,0,0,10">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Native DCS filename" Binding="{Binding FileName}" Width="*"/>
              <DataGridTextColumn Header="Active assignments" Binding="{Binding ActiveBindings}" Width="120"/>
              <DataGridTextColumn Header="Modifiers" Binding="{Binding ModifierCount}" Width="80"/>
              <DataGridCheckBoxColumn Header="Protected" Binding="{Binding Protected}" Width="80"/>
            </DataGrid.Columns>
          </DataGrid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="240">
            <StackPanel x:Name="DeviceFields">
              <TextBlock Text="Exact native DCS joystick filename, including {physical GUID}.diff.lua" TextWrapping="Wrap"/>
              <TextBox x:Name="DeviceFileName" Margin="0,4,0,8"/>
              <TextBlock Text="Copy from an existing joystick profile (blank creates an empty profile)" TextWrapping="Wrap"/>
              <ComboBox x:Name="CloneProfileChoice" DisplayMemberPath="FileName" Margin="0,4,0,8"/>
              <TextBlock Text="Rename keeps the same physical GUID and updates modifier device names. Clear assignments and device modifiers before deleting. The keyboard profile is protected." TextWrapping="Wrap" Margin="0,0,0,8"/>
              <WrapPanel>
                <Button x:Name="NewProfileButton" Content="New profile" Click="NewProfileClicked" Padding="10,6" Margin="0,0,8,0"/>
                <Button x:Name="AddProfileButton" Content="Add" Click="AddProfileClicked" Padding="10,6" Margin="0,0,8,0"/>
                <Button x:Name="RenameProfileButton" Content="Rename" Click="RenameProfileClicked" Padding="10,6" Margin="0,0,8,0"/>
                <Button x:Name="RemoveProfileButton" Content="Remove" Click="RemoveProfileClicked" Padding="10,6"/>
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Modifiers">
        <Grid Margin="10">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DataGrid x:Name="ModifierRows" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                    SelectionChanged="ModifierSelected" Margin="0,0,0,10">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
              <DataGridTextColumn Header="Native device" Binding="{Binding Device}" Width="*"/>
              <DataGridTextColumn Header="DCS input" Binding="{Binding Key}" Width="120"/>
              <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="80"/>
            </DataGrid.Columns>
          </DataGrid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="260">
            <StackPanel x:Name="ModifierFields">
              <TextBlock Text="Modifier name"/><TextBox x:Name="ModifierName" Margin="0,4,0,8"/>
              <TextBlock Text="Native device"/><ComboBox x:Name="ModifierDevice" Margin="0,4,0,8"/>
              <TextBlock Text="DCS input key"/><TextBox x:Name="ModifierInput" Margin="0,4,0,8"/>
              <TextBlock Text="Mode"/><ComboBox x:Name="ModifierModeChoice" Margin="0,4,0,8"/>
              <TextBlock Text="Hold is a modifier; Toggle is a switch. Keyboard defaults are protected. Clear assignments before removing or renaming a modifier they use." TextWrapping="Wrap" Margin="0,0,0,8"/>
              <WrapPanel>
                <Button Content="New modifier" Click="NewModifierClicked" Padding="10,6" Margin="0,0,8,0"/>
                <Button x:Name="AddModifierButton" Content="Add" Click="AddModifierClicked" Padding="10,6" Margin="0,0,8,0"/>
                <Button x:Name="UpdateModifierButton" Content="Update" Click="UpdateModifierClicked" Padding="10,6" Margin="0,0,8,0"/>
                <Button x:Name="RemoveModifierButton" Content="Remove" Click="RemoveModifierClicked" Padding="10,6"/>
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="Module impact">
        <Grid Margin="10">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Review proposed shared source changes against saved modules before saving. Refresh after edits or module changes." TextWrapping="Wrap"/>
            <TextBlock Text="Matches baseline: pinned source is unchanged. Different source: module has another source version. Not pinned: no source evidence. Matches proposal: source already agrees. This review does not apply changes to modules." TextWrapping="Wrap" Margin="0,6,0,6"/>
            <Button x:Name="ImpactRefreshButton" Content="Refresh module impact" Click="ReviewImpactClicked" HorizontalAlignment="Left" Padding="10,6"/>
            <TextBlock x:Name="ImpactStatus" Text="Refresh to review saved modules. Module adoption is a separate action." TextWrapping="Wrap" Margin="0,8,0,8"/>
          </StackPanel>
          <DataGrid x:Name="ImpactChanges" Grid.Row="1" MaxHeight="140" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,10"
                    AutomationProperties.Name="Proposed shared source changes">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Source" Binding="{Binding Path}" Width="*"/>
              <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="ImpactModules" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="ImpactModuleSelected" Margin="0,0,10,0"
                      AutomationProperties.Name="Saved module impact summary">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="*"/>
                <DataGridTextColumn Header="Review" Binding="{Binding Status}" Width="120"/>
              </DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="ImpactDetails" Grid.Column="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                      AutomationProperties.Name="Selected module source evidence">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Source" Binding="{Binding Path}" Width="*"/>
                <DataGridTextColumn Header="Evidence" Binding="{Binding Status}" Width="140"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Sources (read-only)">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="SourcePaths" SelectionChanged="SourceChanged" Margin="0,0,12,0"
               AutomationProperties.Name="Shared default source files"/>
      <TextBox x:Name="SourceText" Grid.Column="1" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"
               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
               AutomationProperties.Name="Saved shared default source text"/>
    </Grid>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock x:Name="EditorStatus" TextWrapping="Wrap"/>
      <WrapPanel Margin="0,8,0,0">
        <Button x:Name="SaveDefaultsButton" Content="Save new default revision" Click="SaveClicked" Padding="14,7" Margin="0,0,8,0"/>
        <Button x:Name="DiscardDefaultsButton" Content="Discard draft" Click="DiscardClicked" Padding="14,7"/>
      </WrapPanel>
    </StackPanel>
  </Grid>
</Window>


