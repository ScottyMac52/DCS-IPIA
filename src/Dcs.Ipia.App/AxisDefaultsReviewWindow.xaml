<Window x:Class="DcsIpia.Presentation.AxisDefaultsReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review DCS axis defaults" Width="850" Height="600" MinWidth="650" MinHeight="400"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock x:Name="AxisDefaultsHeading" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="Verify this file was captured from this aircraft, device and scope. DCS diff.lua does not identify the aircraft. Back up your current controls. Reset the device's axes to defaults in DCS, clear all axes, then Save Profile. Restore your backed-up controls afterward." TextWrapping="Wrap" Margin="0,8"/>
      <TextBlock Text="This replaces the selected device's captured axis baseline. Export removes these defaults except exact command, axis and modifier combinations you assigned in IPIA. Keys and other devices are unchanged. Save keeps the draft; Discard undoes it." TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" IsCancel="True" Padding="16,4" Margin="0,0,8,0"/>
      <Button x:Name="StageAxisDefaultsButton" Content="Stage axis defaults" IsDefault="True" Click="StageClicked" Padding="16,4"/>
    </StackPanel>
    <TextBox x:Name="AxisDefaultsChanges" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Captured default axis removals"/>
  </DockPanel>
</Window>
