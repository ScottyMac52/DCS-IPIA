<Window x:Class="DcsIpia.Presentation.Games.EliteWorkspaceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:pres="clr-namespace:DcsIpia.Presentation" Title="IPIA — Elite Dangerous" Icon="{x:Static pres:ApplicationBranding.Icon}"
 Width="1340" Height="860" MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterOwner">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel Margin="0,0,0,10">
   <ComboBox x:Name="GamePicker" Width="180" SelectionChanged="GameChanged" AutomationProperties.Name="Game selection"><ComboBoxItem Content="DCS World" Tag="dcs"/><ComboBoxItem Content="Elite Dangerous" Tag="elite-dangerous"/></ComboBox>
   <ComboBox x:Name="ProfilePicker" Width="220" DisplayMemberPath="Name" SelectionChanged="ProfileChanged" Margin="8,0" AutomationProperties.Name="Elite controls profile"/>
   <Button x:Name="ImportPresetButton" Content="Import bindings…" Click="ImportClicked"/>
   <Button x:Name="SaveProfileButton" Content="Save" Click="SaveClicked" Margin="8,0"/>
   <Button x:Name="DiscardProfileButton" Content="Discard" Click="DiscardClicked"/>
   <Button x:Name="ExportPresetButton" Content="Export for review…" Click="ExportClicked" Margin="8,0"/>
   <TextBlock x:Name="SaveState" VerticalAlignment="Center" FontWeight="SemiBold" Margin="6,0"/>
  </WrapPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,8">
   <WrapPanel><TextBlock Text="Profile name:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="ProfileName" Width="250" TextChanged="ProfileNameChanged" MaxLength="200"/>
    <ComboBox x:Name="SectionPicker" Width="130" Margin="16,0,0,0" SelectionChanged="SectionChanged" AutomationProperties.Name="Elite controls section">
     <ComboBoxItem Content="All"/><ComboBoxItem Content="Ship"/><ComboBoxItem Content="SRV"/><ComboBoxItem Content="On Foot"/><ComboBoxItem Content="General"/>
    </ComboBox>
   </WrapPanel>
   <TextBlock x:Name="AccessStatus" Margin="0,5,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,10,0">
    <ListBox x:Name="FeaturePicker" SelectionChanged="FeatureChanged" AutomationProperties.Name="Game feature navigation">
     <ListBoxItem Content="Devices"/><ListBoxItem Content="Assignments"/><ListBoxItem Content="Input Testing"/><ListBoxItem Content="Reference Sheets"/>
    </ListBox>
    <TextBlock Text="Hardware" FontWeight="SemiBold" Margin="0,20,0,6"/>
    <ListBox x:Name="DevicePicker" DisplayMemberPath="Name" SelectionChanged="DeviceChanged" MinHeight="120" MaxHeight="350" AutomationProperties.Name="Elite native device references"/>
   </StackPanel>
   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel x:Name="DeviceTools" Margin="0,0,0,10">
     <TextBlock Text="Associate a native reference with your hardware" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="Choose the drawing and the exact connected controller. Names in a preset do not identify a Windows device." TextWrapping="Wrap" Margin="0,4,0,8"/>
     <WrapPanel><ComboBox x:Name="HardwarePicker" DisplayMemberPath="Title" Width="300" AutomationProperties.Name="Shared hardware drawing"/>
      <ComboBox x:Name="ConnectedPicker" DisplayMemberPath="Title" Width="330" Margin="8,0" AutomationProperties.Name="Exact connected controller"/>
      <Button Content="Rescan" Click="RescanClicked"/><Button x:Name="AssociateButton" Content="Associate" Click="AssociateClicked" Margin="8,0"/>
     </WrapPanel>
    </StackPanel>
    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
     <Grid Margin="0,0,10,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
      <WrapPanel Margin="0,0,0,6"><Button x:Name="StartInputButton" Content="Start input test" Click="StartInputClicked"/>
       <Button x:Name="StopInputButton" Content="Stop" Click="StopInputClicked" Margin="8,0"/>
       <Button x:Name="ExportSheetButton" Content="Export reference PNG…" Click="ExportSheetClicked"/>
       <Button Content="Fit" Click="FitDiagramClicked" Margin="4,0"/>
       <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="4,0"/>
       <Slider x:Name="DiagramZoom" Minimum="0.1" Maximum="3" Value="1" Width="140" VerticalAlignment="Center" AutomationProperties.Name="Elite drawing zoom"/>
      </WrapPanel>
      <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
       <ScrollViewer x:Name="DiagramScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid><TextBlock x:Name="DiagramHint" Text="Import a bindings preset, then associate a hardware drawing to show its controls." TextWrapping="Wrap" Margin="20"/>
         <Canvas x:Name="DiagramCanvas" Width="600" Height="600" Background="Transparent"/>
        </Grid>
       </ScrollViewer>
      </Border>
      <DataGrid x:Name="AssignmentsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="AssignmentSelected" Margin="0,8,0,0" AutomationProperties.Name="Elite assignments">
       <DataGrid.Columns><DataGridTextColumn Header="Command" Binding="{Binding CommandName}" Width="*"/>
        <DataGridTextColumn Header="Input" Binding="{Binding Input}" Width="100"/><DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="90"/>
        <DataGridTextColumn Header="Chord" Binding="{Binding Chord}" Width="100"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="Commands" FontSize="20" FontWeight="SemiBold"/>
       <TextBox x:Name="CommandSearch" TextChanged="SearchChanged" ToolTip="Search command names" Margin="0,8,0,4" AutomationProperties.Name="Search Elite commands"/>
       <ListBox x:Name="CommandsList" DisplayMemberPath="DisplayName" Height="190" SelectionChanged="CommandChanged" AutomationProperties.Name="Elite command catalog"/>
       <StackPanel x:Name="AssignmentEditor" Margin="0,12,0,0">
        <TextBlock Text="Assignment" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Native input key" Margin="0,8,0,3"/><TextBox x:Name="InputKey" AutomationProperties.Name="Elite input key"/>
        <WrapPanel Margin="0,8,0,0"><ComboBox x:Name="SlotPicker" Width="145" SelectionChanged="SlotChanged"><ComboBoxItem Content="Primary"/><ComboBoxItem Content="Secondary"/></ComboBox>
         <ComboBox x:Name="ModePicker" Width="145" Margin="8,0,0,0"><ComboBoxItem Content="Press"/><ComboBoxItem Content="Hold"/></ComboBox>
        </WrapPanel>
        <StackPanel x:Name="AxisTools" Margin="0,8,0,0"><CheckBox x:Name="InvertAxis" Content="Invert axis"/><TextBlock Text="Deadzone (%)" Margin="0,6,0,3"/><TextBox x:Name="AxisDeadzone" Text="0"/></StackPanel>
        <StackPanel x:Name="ModifierTools" Margin="0,8,0,0">
         <TextBlock Text="Modifier chord" FontWeight="SemiBold"/>
         <ComboBox x:Name="ModifierDevicePicker" DisplayMemberPath="Name" Margin="0,4,0,4"/>
         <TextBox x:Name="ModifierKey" ToolTip="Native modifier key, for example Joy_1 or Key_LeftShift"/>
         <WrapPanel Margin="0,4,0,0"><Button Content="Add modifier" Click="AddModifierClicked"/><Button Content="Remove selected" Click="RemoveModifierClicked" Margin="8,0,0,0"/></WrapPanel>
         <ListBox x:Name="ModifiersList" Height="55" Margin="0,4,0,0"/>
        </StackPanel>
        <CheckBox x:Name="CommandToggle" Content="Toggle this command" Margin="0,8,0,0"/>
        <WrapPanel Margin="0,10,0,0"><Button x:Name="ApplyAssignmentButton" Content="Apply assignment" Click="ApplyClicked"/><Button x:Name="ClearAssignmentButton" Content="Clear slot" Click="ClearClicked" Margin="8,0,0,0"/></WrapPanel>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
  <TextBlock x:Name="WorkspaceStatus" Grid.Row="3" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Window>
