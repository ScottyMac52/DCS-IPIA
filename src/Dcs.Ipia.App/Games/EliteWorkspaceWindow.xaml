<Window x:Class="DcsIpia.Presentation.Games.EliteWorkspaceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:pres="clr-namespace:DcsIpia.Presentation" Title="IPIA — Elite Dangerous" Icon="{x:Static pres:ApplicationBranding.Icon}"
 Width="1340" Height="860" MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterOwner">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel Margin="0,0,0,10">
   <ComboBox x:Name="GamePicker" Width="180" SelectionChanged="GameChanged" AutomationProperties.Name="Game selection"><ComboBoxItem Content="DCS World" Tag="dcs"/><ComboBoxItem Content="Elite Dangerous" Tag="elite-dangerous"/></ComboBox>
   <ComboBox x:Name="ProfilePicker" Width="220" DisplayMemberPath="Name" SelectionChanged="ProfileChanged" Margin="8,0" AutomationProperties.Name="Elite controls profile"/>
   <Button x:Name="ImportPresetButton" Content="Import bindings…" Click="ImportClicked"/>
   <Button x:Name="SaveProfileButton" Content="Save" Click="SaveClicked" Margin="8,0"/>
   <Button x:Name="DiscardProfileButton" Content="Discard" Click="DiscardClicked"/>
   <Button x:Name="ExportPresetButton" Content="Export for review…" Click="ExportClicked" Margin="8,0"/>
   <TextBlock x:Name="SaveState" VerticalAlignment="Center" FontWeight="SemiBold" Margin="6,0"/>
  </WrapPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,8">
   <WrapPanel><TextBlock Text="Profile name:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="ProfileName" Width="250" TextChanged="ProfileNameChanged" MaxLength="200"/>
    <ListBox x:Name="SectionPicker" Margin="16,0,0,0" SelectionChanged="SectionChanged" AutomationProperties.Name="Elite controls section"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
     <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="10,4"/></Style></ListBox.ItemContainerStyle>
     <ListBoxItem Content="All"/><ListBoxItem Content="Ship"/><ListBoxItem Content="SRV"/><ListBoxItem Content="On Foot"/><ListBoxItem Content="General"/>
    </ListBox>
   </WrapPanel>
   <TextBlock x:Name="AccessStatus" Margin="0,5,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,10,0">
    <ListBox x:Name="FeaturePicker" SelectionChanged="FeatureChanged" AutomationProperties.Name="Game feature navigation">
     <ListBoxItem Content="Devices"/><ListBoxItem Content="Assignments"/><ListBoxItem Content="Input Testing"/><ListBoxItem Content="Reference Sheets"/>
    </ListBox>
    <TextBlock Text="Controllers in profile" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,20,0,6"/>
    <ListBox x:Name="DevicePicker" SelectionChanged="DeviceChanged" MinHeight="120" MaxHeight="350" AutomationProperties.Name="Elite native device references">
     <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" ToolTip="{Binding Name}"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </StackPanel>
   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel x:Name="DeviceTools" Margin="0,0,0,10">
     <TextBlock Text="Add a controller" FontSize="18" FontWeight="SemiBold"/>
     <TextBlock Text="Choose your connected controller. IPIA links a matching ED reference or adds a new one. Drawings are optional." TextWrapping="Wrap" Margin="0,4,0,8"/>
     <WrapPanel>
      <ComboBox x:Name="ConnectedPicker" DisplayMemberPath="Title" Width="430" SelectionChanged="ConnectedChanged" AutomationProperties.Name="Controller to add"/>
      <Button Content="Rescan" Click="RescanClicked" Margin="8,0"/><Button x:Name="AddControllerButton" Content="Add controller…" Click="AddControllerClicked"/>
     </WrapPanel>
     <StackPanel x:Name="ReferenceChoiceTools" Visibility="Collapsed" Margin="0,8,0,0">
      <TextBlock Text="Choose the matching reference from your imported ED preset. ED indices identify game references, not Windows connection order." TextWrapping="Wrap"/>
      <WrapPanel Margin="0,4,0,0"><ComboBox x:Name="ReferencePicker" DisplayMemberPath="Name" Width="430" AutomationProperties.Name="Matching ED reference"/>
       <Button x:Name="LinkReferenceButton" Content="Link selected reference" Click="LinkReferenceClicked" Margin="8,0"/>
      </WrapPanel>
     </StackPanel>
     <WrapPanel Margin="0,8,0,0"><TextBlock x:Name="DrawingStatus" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="550"/>
      <Button x:Name="ChangeDrawingButton" Content="Change drawing…" Click="ChangeDrawingClicked" Margin="8,0"/>
     </WrapPanel>
     <WrapPanel x:Name="DrawingTools" Visibility="Collapsed" Margin="0,6,0,0">
      <ComboBox x:Name="HardwarePicker" DisplayMemberPath="Title" Width="360" AutomationProperties.Name="Optional shared hardware drawing"/>
      <Button x:Name="UseDrawingButton" Content="Use drawing" Click="UseDrawingClicked" Margin="8,0"/>
      <Button x:Name="NoDrawingButton" Content="No drawing" Click="NoDrawingClicked"/>
     </WrapPanel>
    </StackPanel>
    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
     <Grid Margin="0,0,10,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
      <WrapPanel Margin="0,0,0,6"><Button x:Name="StartInputButton" Content="Start input test" Click="StartInputClicked"/>
       <Button x:Name="StopInputButton" Content="Stop" Click="StopInputClicked" Margin="8,0"/>
       <Button x:Name="ExportSheetButton" Content="Export reference PNG…" Click="ExportSheetClicked"/>
       <Button Content="Fit" Click="FitDiagramClicked" Margin="4,0"/>
       <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="4,0"/>
       <Slider x:Name="DiagramZoom" Minimum="0.1" Maximum="3" Value="1" Width="140" VerticalAlignment="Center" AutomationProperties.Name="Elite drawing zoom"/>
      </WrapPanel>
      <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
       <ScrollViewer x:Name="DiagramScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid><TextBlock x:Name="DiagramHint" Text="Import a bindings preset, then associate a hardware drawing to show its controls." TextWrapping="Wrap" Margin="20"/>
         <Canvas x:Name="DiagramCanvas" Width="600" Height="600" Background="Transparent"/>
        </Grid>
       </ScrollViewer>
      </Border>
      <DataGrid x:Name="AssignmentsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="AssignmentSelected" Margin="0,8,0,0" AutomationProperties.Name="Elite assignments">
       <DataGrid.Columns><DataGridTextColumn Header="Command" Binding="{Binding CommandName}" Width="*"/>
        <DataGridTextColumn Header="Input" Binding="{Binding Input}" Width="100"/><DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="90"/>
        <DataGridTextColumn Header="Chord" Binding="{Binding Chord}" Width="100"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
     <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock Text="Commands" FontSize="20" FontWeight="SemiBold"/>
       <TextBlock Text="Category" Margin="0,8,0,3"/>
       <ComboBox x:Name="CommandCategoryPicker" SelectionChanged="CommandFilterChanged" AutomationProperties.Name="Elite command category"/>
       <WrapPanel Margin="0,6,0,0"><TextBlock Text="Input type" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="CommandTypePicker" Width="150" SelectionChanged="CommandFilterChanged" AutomationProperties.Name="Elite command input type">
         <ComboBoxItem Content="All types"/><ComboBoxItem Content="Buttons"/><ComboBoxItem Content="Axes"/>
        </ComboBox>
        <Button x:Name="ClearCommandFiltersButton" Content="Clear filters" Click="ClearCommandFiltersClicked" Margin="8,0,0,0"/>
       </WrapPanel>
       <TextBox x:Name="CommandSearch" TextChanged="SearchChanged" ToolTip="Search names, native IDs or categories" Margin="0,8,0,4" AutomationProperties.Name="Search Elite commands"/>
       <TextBlock x:Name="CommandCount" Margin="0,0,0,4" AutomationProperties.LiveSetting="Polite"/>
       <TextBlock x:Name="CommandEmptyHint" Text="No matching commands. Clear filters or choose another section." TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,4"/>
       <ListBox x:Name="CommandsList" Height="230" SelectionChanged="CommandChanged" AutomationProperties.Name="Elite command catalog">
        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" ToolTip="{Binding Id}"/></DataTemplate></ListBox.ItemTemplate>
        <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,8,0,4"/>
        </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
       </ListBox>
       <StackPanel x:Name="AssignmentEditor" Margin="0,12,0,0">
        <TextBlock Text="Assignment" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Native input key" Margin="0,8,0,3"/><TextBox x:Name="InputKey" AutomationProperties.Name="Elite input key"/>
        <WrapPanel Margin="0,8,0,0"><ComboBox x:Name="SlotPicker" Width="145" SelectionChanged="SlotChanged"><ComboBoxItem Content="Primary"/><ComboBoxItem Content="Secondary"/></ComboBox>
         <ComboBox x:Name="ModePicker" Width="145" Margin="8,0,0,0"><ComboBoxItem Content="Press"/><ComboBoxItem Content="Hold"/></ComboBox>
        </WrapPanel>
        <StackPanel x:Name="AxisTools" Margin="0,8,0,0"><CheckBox x:Name="InvertAxis" Content="Invert axis"/><TextBlock Text="Deadzone (%)" Margin="0,6,0,3"/><TextBox x:Name="AxisDeadzone" Text="0"/></StackPanel>
        <StackPanel x:Name="ModifierTools" Margin="0,8,0,0">
         <TextBlock Text="Modifier chord" FontWeight="SemiBold"/>
         <ComboBox x:Name="ModifierDevicePicker" DisplayMemberPath="Name" Margin="0,4,0,4"/>
         <TextBox x:Name="ModifierKey" ToolTip="Native modifier key, for example Joy_1 or Key_LeftShift"/>
         <WrapPanel Margin="0,4,0,0"><Button Content="Add modifier" Click="AddModifierClicked"/><Button Content="Remove selected" Click="RemoveModifierClicked" Margin="8,0,0,0"/></WrapPanel>
         <ListBox x:Name="ModifiersList" Height="55" Margin="0,4,0,0"/>
        </StackPanel>
        <CheckBox x:Name="CommandToggle" Content="Toggle this command" Margin="0,8,0,0"/>
        <WrapPanel Margin="0,10,0,0"><Button x:Name="ApplyAssignmentButton" Content="Apply assignment" Click="ApplyClicked"/><Button x:Name="ClearAssignmentButton" Content="Clear slot" Click="ClearClicked" Margin="8,0,0,0"/></WrapPanel>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
  <TextBlock x:Name="WorkspaceStatus" Grid.Row="3" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
 </Grid>
</Window>

