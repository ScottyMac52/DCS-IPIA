<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#101827"/>
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#1B2B42"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#34465F"/>
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1"/>
  <SolidColorBrush x:Key="SampleControlBrush" Color="#274269"/>
  <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#223B61"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="#93C5FD"/>
  <SolidColorBrush x:Key="CanvasBorderBrush" Color="#6681A8"/>
  <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#172840"/>
  <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#1F314D"/>
  <SolidColorBrush x:Key="StatusTextBrush" Color="#E2E8F0"/>
  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#23334D"/>
  <SolidColorBrush x:Key="ControlForegroundBrush" Color="#F8FAFC"/>
  <SolidColorBrush x:Key="ControlBorderBrush" Color="#627A9B"/>
  <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#315B8E"/>
  <SolidColorBrush x:Key="DisabledTextBrush" Color="#B8C5D8"/>
  <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#25334A"/>
  <SolidColorBrush x:Key="ErrorTextBrush" Color="#FFB4B4"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1B2B42"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F8FAFC"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#23334D"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F8FAFC"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#1B2B42"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#1B2B42"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#627A9B"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#627A9B"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#B8C5D8"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#315B8E"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F8FAFC"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#315B8E"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F8FAFC"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#23334D"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#F8FAFC"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1B2B42"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F8FAFC"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ScrollBarBrushKey}" Color="#1B2B42"/>
</ResourceDictionary>
