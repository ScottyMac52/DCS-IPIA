<UserControl x:Class="DcsIpia.Presentation.Views.DevicesComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DcsIpia.Presentation.ViewModels"
             Height="Auto" Width="Auto">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Devices" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="Manage this module's devices and its UI Layer devices." TextWrapping="Wrap" Margin="0,6"/>
      <WrapPanel>
        <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox SelectedIndex="{Binding SelectedScopeIndex}" Width="160">
          <ComboBoxItem Content="Module"/>
          <ComboBoxItem Content="Module UI Layer"/>
        </ComboBox>
        <Button Content="Load built-in hardware" Command="{Binding LoadHardwareCommand}" Margin="12,0,0,0" Padding="10,5"/>
      </WrapPanel>
    </StackPanel>

    <DataGrid Grid.Row="1" ItemsSource="{Binding ManagedDevices}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectedItem="{Binding SelectedManagedDevice}" Margin="0,0,12,0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Device" Binding="{Binding Title}" Width="*"/>
        <DataGridTextColumn Header="Instance" Binding="{Binding Instance}" Width="100"/>
        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
      <TextBlock Text="" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBlock Text="{Binding Message}" VerticalAlignment="Center"/>
      <Button Content="Save to database" Command="{Binding SaveCommand}" Padding="16,6" Margin="16,0,0,0"/>
      <Button Content="Discard draft" Command="{Binding DiscardCommand}" Padding="16,6" Margin="8,0,0,0"/>
    </StackPanel>
  </Grid>
</UserControl>
