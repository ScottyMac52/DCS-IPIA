<UserControl x:Class="DcsIpia.Presentation.Views.AssignmentsComponentView2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="3*" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0">
      <TextBlock Text="Assignments" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="Manage device assignments and test inputs." Margin="0,6"/>
      <WrapPanel>
        <TextBlock Text="Device:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedDevice}" MinWidth="180"/>
        <TextBlock Text="Modifier layer:" VerticalAlignment="Center" Margin="12,0,8,0"/>
        <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" MinWidth="180"/>
        <Button Content="Clear layer assignments" Command="{Binding ClearLayerAssignmentsCommand}" Margin="12,0,0,0" Padding="10,4"/>
      </WrapPanel>

      <!-- Pending summary and simple inspector fields mirrored from VM -->
      <TextBlock Text="Pending Summary" FontWeight="SemiBold" Margin="0,12,0,4"/>
      <TextBlock Text="{Binding PendingSummary}" TextWrapping="Wrap"/>
    </StackPanel>

    <Border Grid.Column="1" BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="12" CornerRadius="4" Background="#FFF">
      <StackPanel>
        <TextBlock Text="Inspector" FontSize="16" FontWeight="SemiBold"/>

        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="Physical Input:" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding InspectorPhysicalInput}" />
        </StackPanel>

        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="Chord:" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding InspectorChord}" />
        </StackPanel>

        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="Current Command:" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding InspectorCurrentCommand}" />
        </StackPanel>

        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="Pending Command:" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding InspectorPendingCommand}" />
        </StackPanel>

        <StackPanel Margin="0,12,0,0">
          <TextBlock Text="Label" FontWeight="SemiBold"/>
          <TextBox Text="{Binding LabelEditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsLabelEditorEnabled}" MinWidth="220"/>
        </StackPanel>

        <StackPanel Margin="0,12,0,0">
          <Button Content="Apply Label" Command="{Binding ApplyLabelCommand}" IsEnabled="{Binding IsLabelEditorEnabled}" Padding="8,4" HorizontalAlignment="Left"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
