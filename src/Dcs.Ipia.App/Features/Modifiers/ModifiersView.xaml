<UserControl x:Class="DcsIpia.Features.Modifiers.ModifiersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pres="clr-namespace:DcsIpia.Presentation">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" Style="{StaticResource AppLabel}" />
            <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource AppLabel}"/>
                <ComboBox x:Name="ModifiersScope" Width="160" SelectionChanged="ScopeChanged" Style="{StaticResource AppComboBox}">
                    <ComboBoxItem Content="Module"/>
                    <ComboBoxItem Content="Module UI Layer"/>
                </ComboBox>
                <pres:ActionBar Margin="12,0,0,0">
                    <Button Content="Update" Click="UpdateModifierClicked" Style="{StaticResource ActionButton}"/>
                    <Button Content="Remove" Click="RemoveModifierClicked" Style="{StaticResource ActionButton}"/>
                    <Button Content="New" Click="NewModifierClicked" Style="{StaticResource ActionButton}"/>
                    <Button Content="Add" Click="AddModifierClicked" Style="{StaticResource ActionButton}"/>
                    <Button Content="Clear assignments" Click="ClearAssignmentsClicked" Style="{StaticResource ActionButton}"/>
                    <Button Content="Save to database" Click="SaveClicked" Style="{StaticResource ActionButton}"/>
                    <Button Content="Discard draft" Click="DiscardClicked" Style="{StaticResource ActionButton}"/>
                </pres:ActionBar>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="360" MinWidth="280"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="ManagedModifiers" Grid.Column="0" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,4,0"
                SelectionChanged="ManagedModifierSelected">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="120"/>
                    <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>
            <GroupBox Grid.Column="2" Header="Modifier" Padding="12" Margin="4,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource AppLabel}"/>
                        <TextBox x:Name="ModifierName" Margin="0,4,0,10" Style="{StaticResource AppTextBox}"/>
                        <TextBlock Text="Semantic layer (optional)" Style="{StaticResource AppLabel}"/>
                        <TextBox x:Name="ModifierSemantic" Margin="0,4,0,10" Style="{StaticResource AppTextBox}"/>
                        <TextBlock Text="Mode" Style="{StaticResource AppLabel}"/>
                        <ComboBox x:Name="ModifierModeChoice" Margin="0,4,0,10" Style="{StaticResource AppComboBox}"/>
                        <TextBlock Text="Device" Style="{StaticResource AppLabel}"/>
                        <ComboBox x:Name="ModifierDevice" DisplayMemberPath="Title" Margin="0,4,0,10" SelectionChanged="ModifierDeviceChanged" Style="{StaticResource AppComboBox}"/>
                        <TextBlock Text="Control" Style="{StaticResource AppLabel}"/>
                        <ComboBox x:Name="ModifierControl" DisplayMemberPath="Label" Margin="0,4,0,10" Style="{StaticResource AppComboBox}"/>
                        <TextBlock x:Name="StatusMessage" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource AppLabel}"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>