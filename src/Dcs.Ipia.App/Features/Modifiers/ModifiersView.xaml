<UserControl x:Class="DcsIpia.Features.Modifiers.ModifiersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText"/>
            <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ModifiersScope" Width="160" SelectionChanged="ScopeChanged">
                    <ComboBoxItem Content="Module"/>
                    <ComboBoxItem Content="Module UI Layer"/>
                </ComboBox>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Update" Click="UpdateModifierClicked" Padding="10,6" Margin="0,0,6,0"/>
                    <Button Content="Remove" Click="RemoveModifierClicked" Padding="10,6"/>
                    <Button Content="New" Click="NewModifierClicked" Padding="10,6" Margin="0,0,6,0"/>
                    <Button Content="Add" Click="AddModifierClicked" Padding="10,6" Margin="0,0,6,0"/>
                </WrapPanel>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="360" MinWidth="280"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="ManagedModifiers" Grid.Column="0" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,4,0"
                SelectionChanged="ManagedModifierSelected">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="120"/>
                    <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>
            <GroupBox Grid.Column="2" Header="Modifier" Padding="12" Margin="4,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Name"/>
                        <TextBox x:Name="ModifierName" Margin="0,4,0,10"/>
                        <TextBlock Text="Semantic layer (optional)"/>
                        <TextBox x:Name="ModifierSemantic" Margin="0,4,0,10"/>
                        <TextBlock Text="Mode"/>
                        <ComboBox x:Name="ModifierModeChoice" Margin="0,4,0,10"/>
                        <TextBlock Text="Device"/>
                        <ComboBox x:Name="ModifierDevice" DisplayMemberPath="Title" Margin="0,4,0,10" SelectionChanged="ModifierDeviceChanged"/>
                        <TextBlock Text="Control"/>
                        <ComboBox x:Name="ModifierControl" DisplayMemberPath="Label" Margin="0,4,0,10"/>
                        <TextBlock x:Name="StatusMessage" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>