<UserControl x:Class="DcsIpia.Features.Devices.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText"/>
            <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="DevicesScope" Width="160" SelectionChanged="ScopeChanged">
                    <ComboBoxItem Content="Module"/>
                    <ComboBoxItem Content="Module UI Layer"/>
                </ComboBox>
                <Button Content="Load built-in hardware" Click="LoadHardwareClicked" Padding="10,5" Margin="12,0,0,0"/>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="380" MinWidth="280"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="ManagedDevices" Grid.Column="0" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,4,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Device" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Instance" Binding="{Binding Instance}" Width="100"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>
            <GroupBox Grid.Column="2" Header="Device" Padding="12" Margin="4,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <TextBlock Text="Detected device"/>
                    <ComboBox x:Name="DetectedDevice" DisplayMemberPath="Title" SelectionChanged="DetectedDeviceChanged" Margin="0,4,0,10"/>
                    <TextBlock Text="Adopted hardware inventory"/>
                    <ComboBox x:Name="InventoryUnits" DisplayMemberPath="Title" Margin="0,4,0,8"/>
                    <Button Content="Add inventory unit with generic controls" Click="AddInventoryClicked" Padding="8,5" Margin="0,0,0,10"/>
                    <TextBlock Text="Saved hardware drawing"/>
                    <ComboBox x:Name="CustomMappingRevisions" DisplayMemberPath="Title" Margin="0,4,0,8"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Refresh mappings" Click="RefreshUserMappingsClicked" Padding="8,5"/>
                        <Button Content="Apply drawing to selected device" Click="AdoptCustomMappingClicked" Padding="8,5" Margin="6,0,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="Shared hardware"/>
                    <ComboBox x:Name="ManagedHardware" DisplayMemberPath="Title" Margin="0,4,0,10"/>
                    <TextBlock Text="Native DCS filename"/>
                    <TextBox x:Name="ManagedFileName" Margin="0,4,0,10"/>
                    <TextBlock Text="Instance (optional)"/>
                    <TextBox x:Name="ManagedInstance" Margin="0,4,0,10"/>
                    <TextBlock Text="Role (optional)"/>
                    <TextBox x:Name="ManagedRole" Margin="0,4,0,10"/>
                    <GroupBox x:Name="KneeboardTitleFields" Header="Module kneeboard" Padding="8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Kneeboard title"/>
                            <TextBox x:Name="ManagedKneeboardTitle" Margin="0,4,0,0"/>
                            <TextBlock Text="Kneeboard subtitle (optional)" Margin="0,8,0,0"/>
                            <TextBox x:Name="ManagedKneeboardSubtitle" Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox x:Name="MfdLabelFields" Header="Module MFD labels" Padding="8" Margin="0,0,0,10" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Left"/>
                            <TextBox x:Name="MfdLeft"/>
                            <TextBlock Text="Right"/>
                            <TextBox x:Name="MfdRight"/>
                            <TextBlock Text="Top"/>
                            <TextBox x:Name="MfdTop"/>
                            <TextBlock Text="Bottom"/>
                            <TextBox x:Name="MfdBottom"/>
                        </StackPanel>
                    </GroupBox>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Update" Click="UpdateDeviceClicked" Padding="10,6" Margin="0,0,6,0"/>
                        <Button Content="Remove" Click="RemoveDeviceClicked" Padding="10,6"/>
                        <Button Content="Clear assignments" Click="ClearDeviceAssignmentsClicked" Padding="10,6" Margin="6,0,0,0"/>
                        <Button Content="New" Click="NewDeviceClicked" Padding="10,6" Margin="5,0,6,0"/>
                        <Button Content="Add" Click="AddDeviceClicked" Padding="10,6" Margin="0,8,6,0"/>
                        <Button Content="Rebind physical unit…" Click="RebindDeviceClicked" Padding="10,6" Margin="6,8,0,0"/>
                        <Button Content="Save to database" Click="SaveClicked" Padding="10,6" Margin="5,8,6,0"/>
                        <Button Content="Discard draft" Click="DiscardClicked" Padding="10,6" Margin="0,8,0,0"/>
                        <Button Content="Import DCS axis defaults…" Click="ImportAxisDefaultsClicked" Padding="10,6" Margin="5,8,0,0"/>
                        </WrapPanel>
                    <TextBlock x:Name="StatusMessage" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>