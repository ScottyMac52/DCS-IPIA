<UserControl x:Class="DcsIpia.Features.InputTest.InputTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pres="clr-namespace:DcsIpia.Presentation">
    <Grid x:Name="InputTestPanes" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="80"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" MaxHeight="160" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Style="{StaticResource AppLabel}"/>
            <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="Feedback device:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource AppLabel}"/>
                <ComboBox x:Name="FeedbackDevice" Width="240" DisplayMemberPath="Title" Style="{StaticResource AppComboBox}"/>
            </WrapPanel>
            <WrapPanel Margin="0,8,0,0">
                <pres:ActionBar IsFeatureActions="True" Visibility="Collapsed">
                    <Button x:Name="StartInputTestButton" Content="Start test" Click="StartInputTestClicked" Style="{StaticResource ActionButton}"/>
                    <Button x:Name="StopInputTestButton" Content="Stop test" Click="StopInputTestClicked" Style="{StaticResource ActionButton}" IsEnabled="False"/>
                </pres:ActionBar>
            </WrapPanel>
            <ComboBox x:Name="InputTestSnapshotChoice" SelectedIndex="0"><ComboBoxItem Content="Current edits"/><ComboBoxItem Content="Saved profile"/></ComboBox>
            <TextBlock x:Name="InputTestLogMessage"/>
            <TextBlock x:Name="InputTestStatus" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource AppLabel}"/>
            <TextBlock x:Name="InputTestModifiers" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource AppLabel}"/>
        </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="Events" VerticalAlignment="Center" Style="{StaticResource AppLabel}"/>
                <Button x:Name="ClearInputTestLogButton" IsEnabled="False" Content="Clear log" Click="ClearInputTestLogClicked" Padding="6,2" Margin="8,0,0,0" Style="{StaticResource ActionButton}"/>
                <Button x:Name="CopyInputTestLogButton" Content="Copy events" Click="CopyInputTestLogClicked" IsEnabled="False"/>
                <ComboBox x:Name="EventFilter" Width="100" Margin="12,0,0,0" SelectedIndex="0" SelectionChanged="EventFilterChanged" Style="{StaticResource AppComboBox}">
                    <ComboBoxItem Content="Both"/>
                    <ComboBoxItem Content="Press"/>
                    <ComboBoxItem Content="Release"/>
                </ComboBox>
                <CheckBox x:Name="ShowAxis" Content="Show axis values" Style="{StaticResource AppCheckBox}" Margin="12,0,0,0" Checked="EventFilterChanged" Unchecked="EventFilterChanged"/>
            </WrapPanel>
            <ListBox x:Name="InputTestLog" SelectionMode="Extended" DisplayMemberPath="Display"/>
        </DockPanel>

        <GridSplitter x:Name="InputTestSplitter" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"/>

        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock x:Name="DeviceTitle" DockPanel.Dock="Top" Margin="0,0,0,4" Style="{StaticResource AppLabel}"/>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource AppLabel}"/>
                <Slider x:Name="Zoom" Width="160" Minimum="0.4" Maximum="2.5" Value="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                ValueChanged="ZoomChanged" VerticalAlignment="Center" MouseDoubleClick="Zoom_MouseDoubleClick"/>
                <TextBox x:Name="ZoomPercent" Width="50" Margin="8,0,0,0" Text="100" LostFocus="ZoomPercentChanged" VerticalAlignment="Center" Style="{StaticResource AppTextBox}"/>
                <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,0,0" Style="{StaticResource AppLabel}"/>
            </WrapPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="Diagram"/>
            </ScrollViewer>
            </DockPanel>
            <!-- Legend is outside the zoomed hardware image and cannot shrink the event/diagram splitter. -->
            <GroupBox Grid.Column="1" Header="SHIFT / MODIFIER" Padding="6"
                      AutomationProperties.Name="Live shift and modifier legend">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ModifierLegend">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}"
                                        Margin="0,0,0,5" Padding="2,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="13" Height="13" VerticalAlignment="Top" Margin="0,3,0,0"
                                                Background="{Binding Color}" BorderBrush="{DynamicResource PrimaryTextBrush}"
                                                BorderThickness="1" CornerRadius="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11"/>
                                        <TextBlock Grid.Column="2" Text="●" Margin="5,0,0,0"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"
                                                   AutomationProperties.Name="Modifier active">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
