<Window x:Class="DcsIpia.Features.Commands.CommandUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command usage" Width="520" Height="420"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock x:Name="Header" DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="SemiBold" Style="{StaticResource AppLabel}"/>
        <Button DockPanel.Dock="Bottom" Content="Close" Click="CloseClicked" HorizontalAlignment="Right" Padding="12,4" Margin="0,8,0,0" Style="{StaticResource ActionButton}"/>
        <TreeView x:Name="Usage"/>
    </DockPanel>
</Window>