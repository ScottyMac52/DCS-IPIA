<UserControl x:Class="DcsIpia.Features.Commands.CommandsManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pres="clr-namespace:DcsIpia.Presentation">
    <DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="DCS command code" Style="{StaticResource AppLabel}" Margin="0,0,8,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Name" Style="{StaticResource AppLabel}" Margin="0,0,8,2"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Category" Style="{StaticResource AppLabel}" Margin="0,0,8,2"/>
                <TextBox x:Name="CommandId" Grid.Row="1" Grid.Column="0" Width="140" Style="{StaticResource AppTextBox}" Margin="0,0,8,0"/>
                <TextBox x:Name="CommandName" Grid.Row="1" Grid.Column="1" Width="200" Style="{StaticResource AppTextBox}" Margin="0,0,8,0"/>
                <TextBox x:Name="CommandCategory" Grid.Row="1" Grid.Column="2" Width="120" Style="{StaticResource AppTextBox}" Margin="0,0,8,0"/>
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="CommandIsAxis" VerticalAlignment="Center"/>
                    <TextBlock Text="Axis" Style="{StaticResource AppLabel}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
            <pres:ActionBar>
                <Button Content="Add" Click="AddClicked" Style="{StaticResource ActionButton}"/>
                <Button Content="Update" Click="UpdateClicked" Style="{StaticResource ActionButton}"/>
                <Button Content="Remove" Click="RemoveClicked" Style="{StaticResource ActionButton}"/>
                <Button Content="Import JSON…" Click="ImportJsonClicked" Style="{StaticResource ActionButton}"/>
                <Button Content="Import HTML…" Click="ImportHtmlClicked" Style="{StaticResource ActionButton}"/>
                <Button Content="Clear all" Click="ClearAllClicked" Style="{StaticResource ActionButton}"/>
                <Button Content="Save to database" Click="SaveClicked" Style="{StaticResource ActionButton}"/>
                <Button Content="Discard draft" Click="DiscardClicked" Style="{StaticResource ActionButton}"/>
            </pres:ActionBar>
        </StackPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Search" Style="{StaticResource AppLabel}"/>
                <TextBox x:Name="CommandSearch" Width="160" Style="{StaticResource AppTextBox}" TextChanged="FiltersChanged"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Category" Style="{StaticResource AppLabel}"/>
                <ComboBox x:Name="CommandCategoryFilter" Width="160" Style="{StaticResource AppComboBox}" SelectionChanged="FiltersChanged"/>
            </StackPanel>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Type" Style="{StaticResource AppLabel}"/>
                <ComboBox x:Name="CommandTypeFilter" Width="100" SelectedIndex="0" Style="{StaticResource AppComboBox}" SelectionChanged="FiltersChanged">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="Buttons"/>
                    <ComboBoxItem Content="Axes"/>
                </ComboBox>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="State" Style="{StaticResource AppLabel}"/>
                <ComboBox x:Name="CommandStateFilter" Width="180" SelectedIndex="0" Style="{StaticResource AppComboBox}" SelectionChanged="FiltersChanged">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="Assigned on this device/layer"/>
                    <ComboBoxItem Content="Unassigned on this device/layer"/>
                    <ComboBoxItem Content="Assigned on every device"/>
                    <ComboBoxItem Content="Unassigned on every device"/>
                </ComboBox>
            </StackPanel>
        </WrapPanel>
        <DataGrid x:Name="Commands" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
              SelectionChanged="CommandSelected" MouseDoubleClick="CommandDoubleClicked"
              PreviewMouseLeftButtonDown="CommandDragStart" PreviewMouseMove="CommandDrag" GiveFeedback="CommandGiveFeedback">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Command" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="160"/>
                <DataGridCheckBoxColumn Header="Axis" Binding="{Binding IsAxis, Mode=OneWay}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="Bound" Binding="{Binding Bound}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>