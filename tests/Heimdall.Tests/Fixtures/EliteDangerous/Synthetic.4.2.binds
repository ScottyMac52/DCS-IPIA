<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic adapter fixture; no user configuration or connected hardware inventory. -->
<Root PresetName="Synthetic" MajorVersion="4" MinorVersion="2">
  <PrimaryFire>
    <Primary Device="ExampleStick" Key="Joy_1"><Hold Value="1" /></Primary>
    <Secondary Device="Keyboard" Key="Key_Space" />
    <ToggleOn Value="0" />
  </PrimaryFire>
  <SecondaryFire>
    <Primary Device="ExampleStick" Key="Joy_2"><Modifier Device="Keyboard" Key="Key_LeftShift" /></Primary>
    <Secondary Device="{NoDevice}" Key="" />
  </SecondaryFire>
  <PitchAxisRaw>
    <Binding Device="ExampleStick" Key="Joy_YAxis" />
    <Inverted Value="1" />
    <Deadzone Value="0.01234567890123" />
  </PitchAxisRaw>
  <ThrottleAxis>
    <Binding Device="ExampleThrottle" DeviceIndex="0" Key="Joy_ZAxis" />
    <Inverted Value="0" />
    <Deadzone Value="0.00000000" />
  </ThrottleAxis>
  <LandingGearToggle>
    <Primary Device="{NoDevice}" Key="" />
    <Secondary Device="{NoDevice}" Key="" />
  </LandingGearToggle>
  <MouseGUI Value="0" />
  <MouseGUI Value="0" />
  <FutureSetting Value="preserve"><Nested /></FutureSetting>
</Root>
