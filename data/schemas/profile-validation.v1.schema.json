{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heimdall.invalid/schemas/profile-validation.v1.schema.json",
  "title": "HEIMDALL profile validation definition v1",
  "description": "Declarative inspection rules, not a native game-file schema. The loader additionally enforces cross-field, JSON Pointer and finite numeric constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "backendId",
    "backendVersion",
    "profileSchemaVersion",
    "rules",
    "ranges"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "backendId": {
      "type": "string",
      "minLength": 1
    },
    "backendVersion": {
      "type": "integer",
      "minimum": 1
    },
    "profileSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "includePortable": {
      "type": "boolean"
    },
    "rules": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "type"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^/"
          },
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "object",
              "array",
              "null"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "minimum": {
            "type": [
              "number",
              "null"
            ]
          },
          "maximum": {
            "type": [
              "number",
              "null"
            ]
          },
          "minimumLength": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "maximumLength": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "allowedValues": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 64,
            "items": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "uniqueBy": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "references": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^/"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "ranges": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "offset",
          "count",
          "references"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^/"
          },
          "offset": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^/"
          },
          "index": {
            "type": "string",
            "minLength": 1
          },
          "unboundIndex": {
            "type": [
              "integer",
              "null"
            ]
          },
          "maximumEnd": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          }
        }
      }
    },
    "expectedFiles": {
      "type": [
        "object",
        "null"
      ],
      "maxProperties": 256,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9A-Fa-f]{64}$"
      }
    }
  }
}
